# ==============================================================================
# PKP SecureGate - Environment Configuration Template
# ==============================================================================
# Copy this file to .env and configure environment-specific values.
# NEVER commit the actual .env file or real credentials to version control.

# Application Core Configuration
APP_NAME="PKP Secure"
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_URL=http://localhost:8080
APP_PORT=8080
APP_TIMEZONE=Asia/Jakarta

# Realtime & Listener Configuration
# HIKVISION_LISTENER_IP: IP reachable by Hikvision hardware to deliver webhooks
# HIKVISION_LISTENER_PORT: Port where SecureGate container/proxy listens
HIKVISION_LISTENER_IP=192.168.90.64
HIKVISION_LISTENER_PORT=8080

# Logging Configuration
LOG_CHANNEL=stack
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=info

# Database Configuration (SQLite default; PostgreSQL supported for production)
DB_CONNECTION=sqlite
# DB_HOST=127.0.0.1
# DB_PORT=5432
# DB_DATABASE=pkp_securegate
# DB_USERNAME=postgres
# DB_PASSWORD=

# Session & Cache Drivers
BROADCAST_DRIVER=log
CACHE_DRIVER=file
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database
SESSION_DRIVER=file
SESSION_LIFETIME=120

# Hikvision ISAPI Device Integration Settings
# Set HIKVISION_ISAPI_USE_MOCK=false in physical production environments
HIKVISION_MOCK_MODE=false
HIKVISION_ISAPI_USE_MOCK=false
HIKVISION_ISAPI_HOST=192.168.90.11
HIKVISION_ISAPI_PORT=80
HIKVISION_ISAPI_USERNAME=admin
HIKVISION_ISAPI_PASSWORD=
HIKVISION_ISAPI_MOCK_BASE_URL=
ISAPI_DEVICE_SECRET=
ISAPI_CONNECT_TIMEOUT=5
ISAPI_REQUEST_TIMEOUT=10
ALLOWED_DEVICE_IPS=192.168.90.15,172.25.0.1

# Physical Door Hardware Credentials (Required for physical terminals)
# DOOR-A (Gedung A - Kantor Utama)
DOOR_A_IP=192.168.90.11
DOOR_A_GATEWAY=192.168.90.1
DOOR_A_USER=
DOOR_A_PASS=
DOOR_A_WEBHOOK_SECRET=

# DOOR-B (Gedung B - Server Room)
DOOR_B_IP=192.168.90.15
DOOR_B_GATEWAY=192.168.90.1
DOOR_B_USER=
DOOR_B_PASS=
DOOR_B_WEBHOOK_SECRET=

# DOOR-C (Gedung C - Operasional)
DOOR_C_IP=192.168.90.13
DOOR_C_GATEWAY=192.168.90.1
DOOR_C_USER=
DOOR_C_PASS=
DOOR_C_WEBHOOK_SECRET=

# DOOR-D (Gedung D - Produksi)
DOOR_D_IP=192.168.90.14
DOOR_D_GATEWAY=192.168.90.1
DOOR_D_USER=
DOOR_D_PASS=
DOOR_D_WEBHOOK_SECRET=
