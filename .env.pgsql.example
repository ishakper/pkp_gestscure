# PostgreSQL connection settings for SecureGate (test / staging preparation).
# Copy the lines you need into .env. DB_PASSWORD must come from the environment
# or a secret store; never commit a real value.
#
# Production stays on SQLite until the PostgreSQL cut-over is approved.
DB_CONNECTION=pgsql
DB_HOST=postgres
DB_PORT=5432
DB_DATABASE=securegate
DB_USERNAME=securegate
DB_PASSWORD=
