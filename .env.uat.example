# ==============================================================================
# PKP GateScure - UAT Environment Configuration Template (.env.uat.example)
# ==============================================================================
# Isolated User Acceptance Testing environment for branch candidate/uat-full-app.
# Target Database: securegate_uat (PostgreSQL 16)
# Hardware Mock: In-Process Simulation (Zero physical egress to 192.168.90.0/24)
# ==============================================================================

# Application Core Configuration
APP_NAME="PKP GateScure (UAT)"
APP_ENV=uat
APP_KEY=
APP_DEBUG=false
APP_URL=http://localhost:8088
APP_PORT=8088
APP_TIMEZONE=Asia/Jakarta

# Logging Configuration
LOG_CHANNEL=stack
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=info

# Database Configuration (PostgreSQL 16 - Strictly securegate_uat)
DB_CONNECTION=pgsql
DB_HOST=db_uat
DB_PORT=5432
DB_DATABASE=securegate_uat
DB_USERNAME=securegate
# Inject at runtime; never commit actual password.
DB_PASSWORD=

# Queue & Cache (Redis 7 - Dedicated UAT instance)
BROADCAST_DRIVER=log
CACHE_DRIVER=redis
FILESYSTEM_DISK=local
QUEUE_CONNECTION=redis
SESSION_DRIVER=redis
SESSION_LIFETIME=120

REDIS_HOST=redis_uat
# Inject at runtime when Redis AUTH is enabled.
REDIS_PASSWORD=
REDIS_PORT=6379

# Hikvision ISAPI Device Simulation (Strict Mock Mode - No Physical Egress)
HIKVISION_MOCK_MODE=true
HIKVISION_ISAPI_USE_MOCK=true
HIKVISION_ISAPI_HOST=127.0.0.1
HIKVISION_ISAPI_PORT=80
HIKVISION_ISAPI_USERNAME=admin_uat
# Mock credential only; inject non-production value at runtime.
HIKVISION_ISAPI_PASSWORD=
HIKVISION_ISAPI_MOCK_BASE_URL=http://127.0.0.1/api/mock/isapi
# Inject at runtime; never commit actual secret.
ISAPI_DEVICE_SECRET=
ISAPI_CONNECT_TIMEOUT=5
ISAPI_REQUEST_TIMEOUT=10
ALLOWED_DEVICE_IPS=127.0.0.1,172.29.90.1,172.29.90.10
HIKVISION_ALLOWED_CIDRS=127.0.0.0/8,172.29.90.0/24

# Webhook Listener (UAT Container Loopback)
HIKVISION_LISTENER_IP=127.0.0.1
HIKVISION_LISTENER_PORT=80

# Container Startup Controls (Prevent accidental auto-migration)
RUN_MIGRATIONS=false
