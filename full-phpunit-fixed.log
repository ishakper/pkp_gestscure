// = = = = =\n
// SPRINT 8: WORK CALENDAR & ATTENDANCE CORE\n
// = = = = =\n
\n
const ATTENDANCE_TIMEZONE = 'Asia/Jakarta';\n
\n
// The API serialises Attendance dates/times as ISO-8601 in UTC (e.g. 2026-09-20T17:00:00.000000Z, which is\n
// 21 Sep 00:00 WIB). Reading the string directly shows UTC (7 hours behind WIB), so convert explicitly.\n
// Values without a timezone marker ("2026-09-21 09:55:00" / "2026-09-21") are already local and are used as-is.\n
function hasTimezoneMarker(value) {\n
    return /(?:Z|[+-]\d{2}:?\d{2})$/.test(String(value));\n
}\n
\n
function formatAttendanceTime(value) {\n
    if (!value) return '-';\n
    const text = String(value);\n
    if (!hasTimezoneMarker(text)) return /\d{2}:\d{2}/.test(text) ? text.substring(11, 16) : '-';\n
    const date = new Date(text);\n
    if (Number.isNaN(date.getTime())) return '-';\n
    return new Intl.DateTimeFormat('en-GB', { timeZone: ATTENDANCE_TIMEZONE, hour: '2-digit', minute: '2-digit', hour12: false }).format(date);\n
}\n
\n
function formatAttendanceDate(value) {\n
    if (!value) return '-';\n
    const text = String(value);\n
    const options = { day: '2-digit', month: 'short', year: 'numeric' };\n
    if (!hasTimezoneMarker(text)) {\n
        const [year, month, day] = text.substring(0, 10).split('-').map(Number);\n
        if (!year || !month || !day) return text;\n
        return new Intl.DateTimeFormat('id-ID', { ...options, timeZone: 'UTC' }).format(new Date(Date.UTC(year, month - 1, day)));\n
    }\n
    const date = new Date(text);\n
    if (Number.isNaN(date.getTime())) return text;\n
    return new Intl.DateTimeFormat('id-ID', { ...options, timeZone: ATTENDANCE_TIMEZONE }).format(date);\n
}\n
\n
async function loadAttendanceData() {\n
    loadAttendanceMetrics();\n
    loadAttendanceReport();\n
    const tbody = document.getElementById('attendanceTableBody');\n
    if (!tbody) return;\n
\n
    tbody.innerHTML = '<tr><td colspan="10" class="loading-td"><div class="spinner"></div> Memuat data kehadiran...</td></tr>';\n
    try {\n
        const res = await apiFetch('/attendance/records');\n
        if (!res.success) throw new Error(res.message || 'Gagal memuat kehadiran');\n
        \n
        const records = res.data.data || res.data;\n
        if (!records.length) {\n
            tbody.innerHTML = '<tr><td colspan="10" class="empty-td" style="text-align:center; padding: 2rem; color: var(--text-muted);">Belum ada kehadiran yang diproses untuk scope Anda.</td></tr>';\n
            return;\n
        }\n
\n
        tbody.innerHTML = records.map(r => {\n
            const empName = r.employee ? r.employee.name : '-';\n
            const calName = r.work_calendar ? r.work_calendar.name : '-';\n
            const sourceLog = r.access_log_out || r.access_log_in;\n
            const doorName = sourceLog?.door?.door_name || '-';\n
            const credential = sourceLog?.verify_method || '-';\n
            const processingState = sourceLog ? 'Diproses perangkat' : 'Input terverifikasi';\n
            \n
            let statusBadge = '';\n
            switch (r.status) {\n
                case 'PRESENT': statusBadge = '<span class="status-badge status-active">Hadir</span>'; break;\n
                case 'LATE': statusBadge = '<span class="status-badge status-warning">Terlambat</span>'; break;\n
                case 'ABSENT': statusBadge = '<span class="status-badge status-inactive">Mangkir</span>'; break;\n
                case 'OFF': statusBadge = '<span class="status-badge" style="background:#475569;color:#fff;">Libur / OFF</span>'; break;\n
                case 'LEAVE': statusBadge = '<span class="status-badge status-info">Cuti</span>'; break;\n
                default: statusBadge = `<span class="status-badge">${escapeHtml(r.status)}</span>`;\n
            }\n
\n
            const lateSpan = r.late_minutes > 0 \n
                ? `<span style="color: #ef4444; font-weight: 700;">+${r.late_minutes} min</span>` \n
                : '<span style="color: var(--text-muted);">-</span>';\n
\n
            return `\n
                <tr>\n
                    <td>${escapeHtml(formatAttendanceDate(r.attendance_date))}</td>\n
                    <td><strong>${escapeHtml(empName)}</strong></td>\n
                    <td>${escapeHtml(calName)}</td>\n
                    <td>${escapeHtml(formatAttendanceTime(r.clock_in_at))}</td>\n
                    <td>${escapeHtml(formatAttendanceTime(r.clock_out_at))}</td>\n
                    <td>${escapeHtml(doorName)}</td>\n
                    <td>${escapeHtml(credential)}</td>\n
                    <td><span class="status-badge ${sourceLog ? 'status-active' : 'status-info'}">${escapeHtml(processingState)}</span></td>\n
                    <td>${statusBadge}</td>\n
                    <td>${lateSpan}</td>\n
                </tr>\n
            `;\n
        }).join('');\n
    } catch (e) {\n
        tbody.innerHTML = `<tr><td colspan="10" class="error-td">Gagal memuat kehadiran. ${escapeHtml(e.message)}</td></tr>`;\n
    }\n
}\n
\n
