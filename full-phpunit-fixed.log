async function submitFieldOverride(e) {\n
    e.preventDefault();\n
    const evidenceId = document.getElementById('overrideEvidenceId')?.value;\n
    const reason = document.getElementById('overrideReasonInput')?.value?.trim();\n
    const btn = document.getElementById('btnSubmitOverride');\n
\n
    if (!evidenceId || !reason) {\n
        showToast('Alasan override wajib diisi.', 'warning');\n
        return;\n
    }\n
\n
    const origText = btn ? btn.innerText : '';\n
    if (btn) { btn.disabled = true; btn.innerText = 'Menyimpan...'; }\n
\n
    try {\n
        const res = await apiFetch(`/field-attendance/records/${evidenceId}/override`, {\n
            method: 'POST',\n
            body: JSON.stringify({ reason })\n
        });\n
\n
        if (res.success || res.message) {\n
            showToast(res.message || 'Override berhasil diterapkan.', 'success');\n
            closeModal('fieldOverrideModal');\n
            await loadFieldAttendanceData();\n
        }\n
    } catch (err) {\n
        showToast('Gagal override: ' + err.message, 'error');\n
    } finally {\n
        if (btn) { btn.disabled = false; btn.innerText = origText; }\n
    }\n
}\n
