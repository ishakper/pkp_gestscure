\n
    const saveBtn = document.getElementById('btnSaveDoorAssignment');\n
    const originalText = saveBtn.innerHTML;\n
    saveBtn.disabled = true;\n
    saveBtn.innerHTML = `<div class="spinner-sm"></div> Memproses Sinkronisasi ISAPI...`;\n
\n
    const checkboxes = document.querySelectorAll('input[name="assign_door_ids"]:checked');\n
    const selectedDoors = Array.from(checkboxes).map(cb => cb.value);\n
\n
    try {\n
        // Send payload to assign doors\n
        const res = await apiFetch('/user-management/assign-doors', {\n
            method: 'POST',\n
            body: JSON.stringify({\n
                employee_id: state.selectedEmployeeForAssign.id,\n
                door_ids: selectedDoors,\n
            })\n
        });\n
\n
        if (res.status === 'success') {\n
            showToast(`Akses pintu berhasil diperbarui untuk ${state.selectedEmployeeForAssign.name}.`, 'success');\n
            closeModal('doorAssignModal');\n
            await loadEmployees();\n
