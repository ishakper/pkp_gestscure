// Sub-Tab 2: Lowongan Pekerjaan\n
async function loadAtsVacancies() {\n
    const tbody = document.getElementById('atsVacanciesTableBody');\n
    if (!tbody) return;\n
\n
    const search = document.getElementById('searchAtsVacancies')?.value.trim() || '';\n
    const status = document.getElementById('filterAtsVacancyStatus')?.value || '';\n
\n
    tbody.innerHTML = `<tr><td colspan="8" class="loading-td"><div class="spinner"></div> Memuat daftar lowongan...</td></tr>`;\n
\n
    try {\n
        let url = '/recruitment/vacancies';\n
        const params = [];\n
        if (search) params.push(`search=${encodeURIComponent(search)}`);\n
        if (status) params.push(`status=${encodeURIComponent(status)}`);\n
        if (params.length > 0) url += `?${params.join('&')}`;\n
\n
        const res = await apiFetch(url);\n
        if (res.status !== 'success' || !Array.isArray(res.data) || res.data.length === 0) {\n
            tbody.innerHTML = `<tr><td colspan="8" class="empty-td">Belum ada lowongan pekerjaan ditemukan. Klik "+ Lowongan Baru" untuk membuat lowongan.</td></tr>`;\n
            return;\n
        }\n
\n
        tbody.innerHTML = res.data.map(v => {\n
            const divName = v.division?.name || 'Seluruh Divisi';\n
            const bldName = v.building?.name || 'Head Office';\n
            const statusClass = v.status === 'OPEN' ? 'badge-active' : (v.status === 'CLOSED' ? 'badge-danger' : 'badge-info');\n
\n
            return `\n
                <tr>\n
                    <td>\n
                        <div style="font-weight: 700; color: #ffffff;">${escapeHtml(v.title)}</div>\n
                        <div style="font-size: 0.775rem; color: var(--primary); font-family: monospace;">${escapeHtml(v.vacancy_code)}</div>\n
                    </td>\n
                    <td>\n
                        <div style="color: #cbd5e1;">${escapeHtml(divName)}</div>\n
                        <div style="font-size: 0.775rem; color: var(--text-muted);">${escapeHtml(bldName)}</div>\n
                    </td>\n
                    <td>\n
                        <span class="badge" style="background: rgba(99, 102, 241, 0.2); color: #a5b4fc;">${escapeHtml(v.employment_type)}</span>\n
                        <span style="font-size: 0.775rem; color: var(--text-muted); margin-left: 4px;">${escapeHtml(v.experience_level)}</span>\n
                    </td>\n
                    <td style="font-weight: 600; text-align: center;">${v.quota}</td>\n
                    <td style="text-align: center;">\n
                        <span class="badge badge-info" style="font-weight: 700;">${v.applications_count ?? 0} Pelamar</span>\n
                    </td>\n
                    <td>\n
                        <span class="badge ${statusClass}">${escapeHtml(v.status)}</span>\n
                    </td>\n
                    <td style="font-size: 0.8rem; color: var(--text-muted);">\n
                        ${v.deadline_at ? formatDateTime(v.deadline_at) : 'Tidak Terbatas'}\n
                    </td>\n
                    <td style="text-align: right;">\n
                        <button class="btn-action" onclick="viewVacancyApplicants(${v.id})" title="Lihat pelamar pada lowongan ini">\n
                            ≡ƒæÑ Pelamar\n
                        </button>\n
                    </td>\n
                </tr>\n
            `;\n
        }).join('');\n
    } catch (err) {\n
        tbody.innerHTML = `<tr><td colspan="8" class="error-td">Gagal memuat lowongan: ${escapeHtml(err.message)}</td></tr>`;\n
    }\n
}\n
\n
function viewVacancyApplicants(vacancyId) {\n
    switchAtsPill('pipeline', document.getElementById('pillPipeline'));\n
    const vac = state.ats.vacancies.find(x => x.id === vacancyId);\n
    if (vac && document.getElementById('searchAtsApplications')) {\n
        document.getElementById('searchAtsApplications').value = vac.title;\n
        loadAtsApplications();\n
    }\n
}\n
