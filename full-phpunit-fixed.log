window.loadAttendanceRequestsData = loadAttendanceRequestsData;\n
window.openNewAttendanceRequestModal = openNewAttendanceRequestModal;\n
window.onReqTypeChanged = onReqTypeChanged;\n
window.submitNewAttendanceRequest = submitNewAttendanceRequest;\n
window.approveAttendanceRequest = approveAttendanceRequest;\n
window.openRejectAttendanceRequestModal = openRejectAttendanceRequestModal;\n
window.submitRejectAttendanceRequest = submitRejectAttendanceRequest;\n
window.cancelAttendanceRequest = cancelAttendanceRequest;\n
