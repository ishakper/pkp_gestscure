async function loadAtsMetrics() {\n
    try {\n
        const res = await apiFetch('/recruitment/metrics');\n
        if (res.status === 'success' && res.data) {\n
            const m = res.data;\n
            const elVac = document.getElementById('atsMetricVacancies');\n
            const elCand = document.getElementById('atsMetricCandidates');\n
            const elApps = document.getElementById('atsMetricApplications');\n
            const elHired = document.getElementById('atsMetricHired');\n
\n
            if (elVac) elVac.textContent = m.open_vacancies ?? 0;\n
            if (elCand) elCand.textContent = m.total_candidates ?? 0;\n
            if (elApps) elApps.textContent = m.active_applications ?? 0;\n
            if (elHired) elHired.textContent = m.hired_count ?? 0;\n
        }\n
    } catch (err) {\n
        console.warn('Gagal memuat metrik ATS:', err);\n
    }\n
}\n
\n
// Sub-Tab 1: Pipeline Lamaran\n
async function loadAtsApplications() {\n
    const tbody = document.getElementById('atsApplicationsTableBody');\n
    if (!tbody) return;\n
\n
    const search = document.getElementById('searchAtsApplications')?.value.trim() || '';\n
    const stage = document.getElementById('filterAtsStage')?.value || '';\n
\n
    tbody.innerHTML = `<tr><td colspan="7" class="loading-td"><div class="spinner"></div> Memuat pipeline pelamar...</td></tr>`;\n
\n
    try {\n
        let url = '/recruitment/applications';\n
        const params = [];\n
        if (search) params.push(`search=${encodeURIComponent(search)}`);\n
        if (stage) params.push(`stage=${encodeURIComponent(stage)}`);\n
        if (params.length > 0) url += `?${params.join('&')}`;\n
\n
        const res = await apiFetch(url);\n
        if (res.status !== 'success' || !Array.isArray(res.data) || res.data.length === 0) {\n
            tbody.innerHTML = `<tr><td colspan="7" class="empty-td">Tidak ada data lamaran ditemukan. Silakan klik "+ Lamar ke Lowongan".</td></tr>`;\n
            return;\n
        }\n
\n
        tbody.innerHTML = res.data.map(app => {\n
            const cand = app.candidate || {};\n
            const vac = app.vacancy || {};\n
            const stageInfo = app.stage || {};\n
            const candName = `${cand.first_name || ''} ${cand.last_name || ''}`.trim() || 'Kandidat';\n
\n
            let stageBadgeColor = 'rgba(56, 189, 248, 0.2)';\n
            let stageTextColor = '#38bdf8';\n
            if (app.current_stage_code === 'APPLIED') { stageBadgeColor = 'rgba(148, 163, 184, 0.2)'; stageTextColor = '#94a3b8'; }\n
            if (app.current_stage_code === 'TECHNICAL_TEST') { stageBadgeColor = 'rgba(168, 85, 247, 0.2)'; stageTextColor = '#c084fc'; }\n
            if (app.current_stage_code.includes('INTERVIEW')) { stageBadgeColor = 'rgba(245, 158, 11, 0.2)'; stageTextColor = '#fbbf24'; }\n
            if (app.current_stage_code === 'OFFER') { stageBadgeColor = 'rgba(16, 185, 129, 0.2)'; stageTextColor = '#34d399'; }\n
            if (app.current_stage_code === 'ACCEPTED') { stageBadgeColor = 'rgba(16, 185, 129, 0.3)'; stageTextColor = '#10b981'; }\n
            if (app.current_stage_code === 'REJECTED') { stageBadgeColor = 'rgba(239, 68, 68, 0.2)'; stageTextColor = '#f87171'; }\n
\n
            const canHire = ['OFFER', 'ACCEPTED'].includes(app.current_stage_code) || app.status === 'HIRED';\n
\n
            return `\n
                <tr>\n
                    <td>\n
                        <span style="font-family: monospace; font-weight: 700; color: var(--primary);">${escapeHtml(app.application_number)}</span>\n
                    </td>\n
                    <td>\n
                        <div style="font-weight: 600; color: #ffffff;">${escapeHtml(candName)}</div>\n
                        <div style="font-size: 0.775rem; color: var(--text-muted);">${escapeHtml(cand.email || '')} ${cand.phone ? 'ΓÇó ' + escapeHtml(cand.phone) : ''}</div>\n
                    </td>\n
                    <td>\n
                        <div style="font-weight: 600; color: #e2e8f0;">${escapeHtml(vac.title || '-')}</div>\n
                        <div style="font-size: 0.775rem; color: var(--text-muted); font-family: monospace;">${escapeHtml(vac.vacancy_code || '')}</div>\n
                    </td>\n
                    <td>\n
                        <span class="badge" style="background: ${stageBadgeColor}; color: ${stageTextColor}; font-weight: 600;">\n
                            ${escapeHtml(stageInfo.name || app.current_stage_code)}\n
                        </span>\n
                    </td>\n
                    <td>\n
                        <span class="badge ${app.status === 'HIRED' ? 'badge-active' : (app.status === 'REJECTED' ? 'badge-danger' : 'badge-info')}">\n
                            ${escapeHtml(app.status)}\n
                        </span>\n
                    </td>\n
                    <td style="font-size: 0.8rem; color: var(--text-muted);">\n
                        ${formatDateTime(app.applied_at || app.created_at)}\n
                    </td>\n
                    <td style="text-align: right;">\n
                        <div style="display: flex; gap: 0.4rem; justify-content: flex-end; flex-wrap: wrap;">\n
                            <button class="btn-action" title="Ubah Tahapan Lamaran" onclick="openTransitionStageModal(${app.id}, '${escapeHtml(candName)}', '${escapeHtml(app.current_stage_code)}')">\n
                                ≡ƒöä Tahap\n
                            </button>\n
                            <button class="btn-action" title="Jadwalkan Wawancara" onclick="openScheduleInterviewModal(${app.id}, '${escapeHtml(candName)}')">\n
                                ≡ƒôà Interview\n
                            </button>\n
                            <button class="btn-action" title="Buat Penawaran Offering" onclick="openCreateOfferModal(${app.id}, '${escapeHtml(candName)}')">\n
                                ≡ƒôä Offer\n
                            </button>\n
                            ${canHire ? `\n
                            <button class="btn-action" style="background: rgba(16, 185, 129, 0.2); color: #34d399; border-color: rgba(16, 185, 129, 0.4);" title="Angkat Sebagai Karyawan Resmi" onclick="openConvertToEmployeeModal(${app.id}, '${escapeHtml(candName)}')">\n
                                Γ£ô Hire\n
                            </button>\n
                            ` : ''}\n
                        </div>\n
                    </td>\n
                </tr>\n
            `;\n
        }).join('');\n
    } catch (err) {\n
        tbody.innerHTML = `<tr><td colspan="7" class="error-td">Gagal memuat data pelamar: ${escapeHtml(err.message)}</td></tr>`;\n
    }\n
}\n
