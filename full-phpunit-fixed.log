// Section 8: Internship Management Controller\n
// = = = = =\n
state.internship = {\n
    activePill: 'interns',\n
    internships: [],\n
    activities: [],\n
    reports: [],\n
    evaluations: [],\n
    mentors: [],\n
    candidates: [],\n
    searchDebounce: null,\n
};\n
\n
function switchInternPill(pillName, btn) {\n
    document.querySelectorAll('#internshipTab .ats-nav-pill').forEach(el => el.classList.remove('active'));\n
    document.querySelectorAll('#internshipTab .ats-sub-content').forEach(el => el.classList.remove('active'));\n
\n
    if (btn) {\n
        btn.classList.add('active');\n
    } else {\n
        const defaultBtn = document.getElementById(`pillIntern${pillName.charAt(0).toUpperCase() + pillName.slice(1)}`);\n
        if (defaultBtn) defaultBtn.classList.add('active');\n
    }\n
\n
    const subTarget = document.getElementById(`internSub${pillName.charAt(0).toUpperCase() + pillName.slice(1)}`);\n
    if (subTarget) subTarget.classList.add('active');\n
\n
    state.internship.activePill = pillName;\n
\n
    if (pillName === 'interns') loadInternships();\n
    if (pillName === 'activities') loadInternActivities();\n
    if (pillName === 'reports') loadInternReports();\n
    if (pillName === 'evaluations') loadInternEvaluations();\n
}\n
\n
async function loadInternshipData() {\n
    await Promise.allSettled([\n
        loadInternMetrics(),\n
        loadInternLookups(),\n
    ]);\n
\n
    if (state.internship.activePill === 'interns') loadInternships();\n
    else if (state.internship.activePill === 'activities') loadInternActivities();\n
    else if (state.internship.activePill === 'reports') loadInternReports();\n
    else if (state.internship.activePill === 'evaluations') loadInternEvaluations();\n
}\n
\n
async function loadInternLookups() {\n
    try {\n
        const [empRes, candRes] = await Promise.allSettled([\n
            apiFetch('/user-management/users?per_page=100'),\n
            apiFetch('/recruitment/candidates')\n
        ]);\n
\n
        if (empRes.status === 'fulfilled' && empRes.value?.status === 'success') {\n
            state.internship.mentors = (empRes.value.data || []).map(u => ({\n
                id: u.id,\n
                name: u.name,\n
                role: u.role || u.role_jabatan || 'Employee'\n
            }));\n
        }\n
\n
        if (candRes.status === 'fulfilled' && candRes.value?.status === 'success') {\n
            state.internship.candidates = candRes.value.data || [];\n
        }\n
    } catch (err) {\n
        console.warn('Internship lookups error:', err);\n
    }\n
}\n
\n
async function loadInternMetrics() {\n
    try {\n
        const res = await apiFetch('/internships/metrics');\n
        if (res.status === 'success' && res.data) {\n
            const m = res.data;\n
            const elActive = document.getElementById('internMetricActive');\n
            const elPending = document.getElementById('internMetricPendingReports');\n
            const elCompleted = document.getElementById('internMetricCompleted');\n
            const elActivities = document.getElementById('internMetricTotalActivities');\n
\n
            if (elActive) elActive.textContent = m.active_interns ?? 0;\n
            if (elPending) elPending.textContent = m.pending_reports ?? 0;\n
            if (elCompleted) elCompleted.textContent = m.completed_interns ?? 0;\n
            if (elActivities) elActivities.textContent = m.total_activities ?? 0;\n
        }\n
    } catch (err) {\n
        console.warn('Gagal memuat metrik magang:', err);\n
    }\n
}\n
