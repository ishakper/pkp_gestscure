// = = = = =\n
// Section 3: Security Access Logs & Filters\n
// = = = = =\n
function syncLogFilters(sourceEl) {\n
    if (!sourceEl) return;\n
    const val = sourceEl.value;\n
    const idMap = {\n
        'logDoorFilter': 'logDoorFilterTab',\n
        'logDoorFilterTab': 'logDoorFilter',\n
        'logStatusFilter': 'logStatusFilterTab',\n
        'logStatusFilterTab': 'logStatusFilter',\n
        'logAttendanceStateFilter': 'logAttendanceStateFilterTab',\n
        'logAttendanceStateFilterTab': 'logAttendanceStateFilter',\n
        'logUserSearch': 'logUserSearchTab',\n
        'logUserSearchTab': 'logUserSearch',\n
        'logStartDate': 'logStartDateTab',\n
        'logStartDateTab': 'logStartDate',\n
        'logEndDate': 'logEndDateTab',\n
        'logEndDateTab': 'logEndDate'\n
    };\n
    const targetId = idMap[sourceEl.id];\n
    if (targetId) {\n
        const targetEl = document.getElementById(targetId);\n
        if (targetEl) targetEl.value = val;\n
    }\n
}\n
\n
let logSearchTimer = null;\n
let accessLogsRequestSeq = 0;\n
\n
// Live search: fire shortly after the user stops typing instead of waiting for blur/Enter.\n
function onLogSearchInput(sourceEl) {\n
    syncLogFilters(sourceEl);\n
    clearTimeout(logSearchTimer);\n
    logSearchTimer = setTimeout(loadAccessLogs, 400);\n
}\n
\n
async function loadAccessLogs() {\n
    const tbody = document.getElementById('logsTableBody');\n
    const recentTbody = document.getElementById('overviewLogsTableBody');\n
    const doorFilter = document.getElementById('logDoorFilter')?.value || document.getElementById('logDoorFilterTab')?.value || '';\n
    const statusFilter = document.getElementById('logStatusFilter')?.value || document.getElementById('logStatusFilterTab')?.value || '';\n
    const attendanceStateFilter = document.getElementById('logAttendanceStateFilter')?.value || document.getElementById('logAttendanceStateFilterTab')?.value || '';\n
    const userSearch = (document.getElementById('logUserSearch')?.value || document.getElementById('logUserSearchTab')?.value || '').trim();\n
    const startDate = document.getElementById('logStartDate')?.value || document.getElementById('logStartDateTab')?.value || '';\n
    const endDate = document.getElementById('logEndDate')?.value || document.getElementById('logEndDateTab')?.value || '';\n
\n
    if (startDate && endDate && startDate > endDate) {\n
        showToast('Tanggal awal tidak boleh setelah tanggal akhir.', 'warning');\n
        return;\n
    }\n
\n
    const requestSeq = ++accessLogsRequestSeq;\n
\n
    if (tbody) {\n
            tbody.innerHTML = `<tr><td colspan="8" class="loading-td"><div class="spinner"></div> Memuat event logs akses pintu...</td></tr>`;\n
    }\n
\n
    try {\n
        let url = `/admin/access-logs?limit=40`;\n
        if (doorFilter) url += `&door_id=${encodeURIComponent(doorFilter)}`;\n
        if (statusFilter) url += `&status=${encodeURIComponent(statusFilter)}`;\n
        if (attendanceStateFilter) url += `&attendance_state=${encodeURIComponent(attendanceStateFilter)}`;\n
        if (userSearch) url += `&user=${encodeURIComponent(userSearch)}`;\n
        if (startDate) url += `&start_date=${encodeURIComponent(startDate)}`;\n
        if (endDate) url += `&end_date=${encodeURIComponent(endDate)}`;\n
\n
        const res = await apiFetch(url);\n
        if (requestSeq !== accessLogsRequestSeq) return; // a newer filter request superseded this one\n
        if (res.status === 'success') {\n
            state.accessLogs = res.data;\n
            renderAccessLogsTable(state.accessLogs);\n
            scheduleMetricCardsUpdate();\n
        }\n
    } catch (err) {\n
        if (requestSeq !== accessLogsRequestSeq) return;\n
        const errorHtml = `<tr><td colspan="8" class="error-td">Gagal memuat log akses: ${escapeHtml(err.message)}</td></tr>`;\n
        if (tbody) tbody.innerHTML = errorHtml;\n
        if (recentTbody) recentTbody.innerHTML = errorHtml;\n
    }\n
}\n
\n
window.loadAccessLogs = loadAccessLogs;\n
\n
async function loadActivityLogs() {\n
    const tbody = document.getElementById('activityLogsTableBody');\n
    const isSuperAdmin = window.APP_CONFIG?.admin?.role === 'super_admin';\n
    if (!tbody || !isSuperAdmin || !(window.APP_CONFIG?.permissions || []).includes('audit.view')) return;\n
    tbody.innerHTML = '<tr><td colspan="5" class="loading-td"><div class="spinner"></div> Memuat audit timeline...</td></tr>';\n
    try {\n
        const res = await apiFetch('/admin/activity-logs?per_page=30');\n
        state.activityLogs = Array.isArray(res.data) ? res.data : [];\n
        if (state.activityLogs.length === 0) {\n
            tbody.innerHTML = '<tr><td colspan="5" class="empty-td">Belum ada aktivitas administratif.</td></tr>';\n
            return;\n
        }\n
        tbody.innerHTML = state.activityLogs.map(log => `\n
            <tr>\n
                <td>${escapeHtml(formatDateTime(log.timestamp))}</td>\n
                <td>${escapeHtml(log.admin?.name || 'System')}</td>\n
                <td><span class="badge badge-info">${escapeHtml(log.action || '-')}</span></td>\n
                <td>${escapeHtml(log.subject_type || '-')}${log.subject_id ? ` #${Number(log.subject_id)}` : ''}</td>\n
                <td class="audit-description">${escapeHtml(log.description || '-')}</td>\n
            </tr>`).join('');\n
    } catch (err) {\n
        tbody.innerHTML = '<tr><td colspan="5" class="error-td">Audit timeline tidak dapat dimuat.</td></tr>';\n
    }\n
}\n
\n
async function refreshOperationalData(button) {\n
    const original = button?.innerHTML || '';\n
    if (button) { button.disabled = true; button.innerHTML = 'ΓÅ│ Memuat data...'; }\n
    try {\n
        await Promise.all([loadDoors(), loadAccessLogs()]);\n
        scheduleMetricCardsUpdate(true);\n
        if (hasCapability('audit.view')) await loadActivityLogs();\n
        showToast('Data operasional terbaru berhasil dimuat.', 'success');\n
    } finally {\n
        if (button) { button.disabled = false; button.innerHTML = original; }\n
    }\n
}\n
\n
async function loadTasks(page = 1) {\n
    const body = document.getElementById('tasksTableBody');\n
    if (!body) return;\n
    const params = new URLSearchParams({ page: String(page), per_page: '15' });\n
    const search = document.getElementById('taskSearch')?.value?.trim();\n
    const status = document.getElementById('taskStatusFilter')?.value;\n
    const priority = document.getElementById('taskPriorityFilter')?.value;\n
    if (search) params.set('search', search);\n
    if (status) params.set('status', status);\n
    if (priority) params.set('priority', priority);\n
    body.innerHTML = '<tr><td colspan="8" class="loading-td"><div class="spinner"></div> Memuat tasks...</td></tr>';\n
    try {\n
        const [list, metrics] = await Promise.all([apiFetch(`/tasks?${params}`), apiFetch('/tasks/metrics')]);\n
        state.tasks = Array.isArray(list.data?.data) ? list.data.data : [];\n
        renderTasks(state.tasks);\n
        renderTaskMetrics(metrics.data || {});\n
        renderTaskPagination(list.pagination || {});\n
    } catch (err) {\n
        body.innerHTML = `<tr><td colspan="8" class="error-td">Gagal memuat tasks: ${escapeHtml(err.message)}</td></tr>`;\n
    }\n
}\n
\n
function renderTasks(tasks) {\n
    const body = document.getElementById('tasksTableBody');\n
    if (!body) return;\n
    if (!tasks.length) {\n
        body.innerHTML = '<tr><td colspan="8" class="empty-td">Belum ada task untuk ditampilkan.</td></tr>';\n
        return;\n
    }\n
    body.innerHTML = tasks.map(task => `<tr>\n
        <td><strong>${escapeHtml(task.title)}</strong><br><small class="text-muted">${escapeHtml(task.task_code)}</small></td>\n
        <td>${escapeHtml(task.employee?.name || '-')}</td>\n
        <td>${escapeHtml(task.project_name || '-')}</td>\n
        <td><span class="badge badge-info">${escapeHtml(task.priority)}</span></td>\n
        <td>${escapeHtml(task.status)}</td>\n
        <td>${Number(task.progress) || 0}%</td>\n
        <td>${escapeHtml(task.due_date || '-')}</td>\n
        <td><button class="btn-secondary" onclick="openTaskDetail(${Number(task.id)})">Detail</button></td>\n
    </tr>`).join('');\n
}\n
\n
function renderTaskMetrics(metrics) {\n
    const values = { taskMetricTotal: metrics.total, taskMetricProgress: metrics.in_progress, taskMetricBlocked: metrics.blocked, taskMetricDone: metrics.done };\n
    Object.entries(values).forEach(([id, value]) => { const element = document.getElementById(id); if (element) element.textContent = value ?? '-'; });\n
}\n
\n
function renderTaskPagination(pagination) {\n
    const target = document.getElementById('taskPagination');\n
    if (!target || !pagination.total_pages) return;\n
    const current = Number(pagination.current_page || 1);\n
    const total = Number(pagination.total_pages || 1);\n
    const prevDisabled = current <= 1;\n
    const nextDisabled = current >= total;\n
    target.innerHTML = `\n
        <nav aria-label="Task pagination" class="pagination-container">\n
            <div class="pagination-wrapper">\n
                <button class="btn-secondary pagination-btn" aria-label="Halaman sebelumnya" ${prevDisabled ? 'disabled' : ''} onclick="loadTasks(${current - 1})">ΓåÉ Sebelumnya</button>\n
                <span class="pagination-status" aria-live="polite" aria-atomic="true">Halaman ${current} dari ${total}</span>\n
                <button class="btn-secondary pagination-btn" aria-label="Halaman berikutnya" ${nextDisabled ? 'disabled' : ''} onclick="loadTasks(${current + 1})">Berikutnya ΓåÆ</button>\n
            </div>\n
        </nav>`;\n
}\n
\n
async function openTaskDetail(taskId) {\n
    const content = document.getElementById('taskDetailContent');\n
    if (!content) return;\n
    content.innerHTML = '<div class="loading-td"><div class="spinner"></div> Memuat detail...</div>';\n
    document.getElementById('taskDetailModal')?.classList.add('active');\n
    try {\n
        const res = await apiFetch(`/tasks/${Number(taskId)}`);\n
        const task = res.data;\n
        const logs = task.worklogs || [];\n
        content.innerHTML = `<div class="task-detail-summary"><h4>${escapeHtml(task.title)}</h4><p>${escapeHtml(task.description || 'Tidak ada deskripsi.')}</p><p><strong>${escapeHtml(task.status)}</strong> ┬╖ ${Number(task.progress) || 0}% ┬╖ ${escapeHtml(task.priority)}</p></div><h4>Worklog Timeline</h4>${logs.length ? `<div>${logs.map(log => `<div class="audit-description" style="padding:.65rem 0;border-bottom:1px solid var(--border-color);"><strong>${escapeHtml(log.work_date)}</strong> ┬╖ ${Number(log.duration_minutes)} menit<br><span>${escapeHtml(log.notes || 'Tanpa catatan')}</span></div>`).join('')}</div>` : '<p class="empty-td">Belum ada worklog.</p>'}`;\n
    } catch (err) {\n
        content.innerHTML = `<div class="error-td">Gagal memuat detail: ${escapeHtml(err.message)}</div>`;\n
    }\n
}\n
\n
async function syncHardwareLogs(btn) {\n
    const originalText = btn ? btn.innerHTML : '';\n
    if (btn) {\n
        btn.disabled = true;\n
        btn.innerHTML = `<div class="spinner-sm"></div> Menarik Log ISAPI...`;\n
    }\n
\n
    try {\n
        const res = await apiFetch('/admin/access-logs/sync-hardware', {\n
            method: 'POST',\n
            body: JSON.stringify({ limit: 50 }),\n
        });\n
\n
        if (res.status === 'success') {\n
            showToast(res.message || `Sinkronisasi log berhasil (${res.inserted_count} log baru).`, 'success');\n
            await loadAccessLogs();\n
            await loadDoors();\n
        } else {\n
            showToast(`Gagal sinkronisasi log: ${res.message}`, 'warning');\n
        }\n
    } catch (err) {\n
        showToast(`Gagal menarik log dari ISAPI: ${err.message}`, 'error');\n
    } finally {\n
        if (btn) {\n
            btn.disabled = false;\n
            btn.innerHTML = originalText;\n
        }\n
    }\n
}\n
\n
function renderAccessLogsTable(logs) {\n
    const renderTargets = [\n
        document.getElementById('logsTableBody'),\n
        document.getElementById('overviewLogsTableBody')\n
    ].filter(Boolean);\n
\n
    if (renderTargets.length === 0) return;\n
\n
    if (logs.length === 0) {\n
        renderTargets.forEach(target => {\n
            target.innerHTML = `<tr><td colspan="8" class="empty-td">Tidak ada data log yang sesuai dengan filter.</td></tr>`;\n
        });\n
        return;\n
    }\n
\n
    const html = logs.map(log => {\n
        const rawStatus = log.access_status || log.status || 'Granted';\n
        const eventType = log.event_type || 'STANDARD_TAP';\n
\n
        let statusBadge = '';\n
        if (rawStatus === 'Alarm' || eventType === 'DOOR_FORCED_OPEN' || eventType === 'TAMPER_ALARM') {\n
            statusBadge = `<span class="badge badge-alarm">≡ƒÜ¿ ALARM / INTRUSION</span>`;\n
        } else if (rawStatus === 'Duress' || eventType === 'DURESS_FINGERPRINT') {\n
            statusBadge = `<span class="badge badge-duress">ΓÜá∩╕Å DURESS ALERT</span>`;\n
        } else if (rawStatus === 'Granted') {\n
            statusBadge = `<span class="badge badge-granted">Γ£ô GRANTED</span>`;\n
        } else {\n
            statusBadge = `<span class="badge badge-denied">Γ£ò DENIED</span>`;\n
        }\n
\n
        let userHtml = '';\n
\n
        if (eventType === 'DOOR_FORCED_OPEN') {\n
            userHtml = `<strong style="color: #f87171;">≡ƒÜ¿ Pintu Dibobol Paksa</strong><br><small class="text-muted">${escapeHtml(log.reason || 'Sensor intrusi terbuka tanpa autentikasi')}</small>`;\n
        } else if (eventType === 'TAMPER_ALARM') {\n
            userHtml = `<strong style="color: #f87171;">≡ƒöº Sabotase Terminal</strong><br><small class="text-muted">${escapeHtml(log.reason || 'Sensor anti-tamper casing terpicu')}</small>`;\n
        } else if (eventType === 'DURESS_FINGERPRINT') {\n
            const empName = log.user?.name || log.nik || 'Karyawan';\n
            userHtml = `<strong>${escapeHtml(empName)}</strong> <span class="badge badge-duress" style="font-size: 0.65rem; padding: 1px 5px;">DURESS</span><br><small class="text-muted">${escapeHtml(log.user?.nik || log.nik || '')} ΓÇó <em>${escapeHtml(log.reason || 'Akses dibuka di bawah ancaman')}</em></small>`;\n
        } else if (log.user && (log.user.name || log.user.nik)) {\n
            userHtml = `<strong>${escapeHtml(log.user.name || 'User')}</strong><br><small class="text-muted">${escapeHtml(log.user.nik || '')} ${log.user.department ? `ΓÇó ${escapeHtml(log.user.department)}` : ''}</small>`;\n
        } else {\n
            userHtml = `<span class="unknown-user">Γ¥ô ${escapeHtml(log.reason || 'Unknown Card / Unregistered User')}</span>`;\n
        }\n
\n
        let methodBadge = '';\n
        if (eventType === 'DOOR_FORCED_OPEN') {\n
            methodBadge = `<span class="method-chip" style="background: rgba(239,68,68,0.18); color: #f87171; border: 1px solid rgba(239,68,68,0.35);">ΓÜí Forced Entry</span>`;\n
        } else if (eventType === 'TAMPER_ALARM') {\n
            methodBadge = `<span class="method-chip" style="background: rgba(239,68,68,0.18); color: #f87171; border: 1px solid rgba(239,68,68,0.35);">≡ƒöº Tamper Sensor</span>`;\n
        } else if (eventType === 'DURESS_FINGERPRINT' || log.verify_method === 'Duress_Fingerprint') {\n
            methodBadge = `<span class="method-chip" style="background: rgba(245,158,11,0.18); color: #fbbf24; border: 1px solid rgba(245,158,11,0.35);">ΓÜá∩╕Å Duress FP</span>`;\n
        } else if (log.verify_method === 'Card' || log.auth_method === 'Card') {\n
            methodBadge = `<span class="method-chip method-card">≡ƒÆ│ Card</span>`;\n
        } else {\n
            methodBadge = `<span class="method-chip method-fp">≡ƒæå Fingerprint</span>`;\n
        }\n
\n
        const timestampStr = log.timestamp\n
            ? new Date(log.timestamp).toLocaleString('id-ID', { dateStyle: 'medium', timeStyle: 'medium' })\n
            : '-';\n
\n
        const safeTime = escapeHtml(timestampStr);\n
        const attendanceStatus = log.attendance?.result || 'NOT_DERIVED';\n
        const attendanceClasses = {\n
            PRESENT: 'badge-success',\n
            LATE: 'badge-pending',\n
            ABSENT: 'badge-danger',\n
            OFF: 'badge-dim',\n
            LEAVE: 'badge-info',\n
            NOT_DERIVED: 'badge-neutral',\n
        };\n
        const attendanceLabel = attendanceStatus === 'NOT_DERIVED'\n
            ? (rawStatus === 'Denied' ? 'Ditolak' : 'Belum diproses')\n
            : attendanceStatus;\n
        const attendanceResult =\n
            `<span class="badge ${attendanceClasses[attendanceStatus] || 'badge-info'}">${escapeHtml(attendanceLabel)}</span>` +\n
            `${log.attendance?.direction ? ` <small class="text-muted">${escapeHtml(log.attendance.direction)}</small>` : ''}`;\n
        const safeNik = escapeHtml(log.user?.nik || log.nik || 'Employee belum terpetakan');\n
        const safeName = escapeHtml(log.user?.name || 'Employee belum terpetakan');\n
        const safeDoor = escapeHtml(log.door_id || '-');\n
\n
        return `\n
            <tr>\n
                <td>${safeTime}</td>\n
                <td>${safeNik}</td>\n
                <td>${safeName}</td>\n
                <td>${methodBadge}</td>\n
                <td>${safeDoor}</td>\n
                <td>${escapeHtml(eventType)}</td>\n
                <td>${statusBadge}</td>\n
                <td>${attendanceResult}</td>\n
            </tr>\n
        `;\n
    }).join('');\n
\n
    renderTargets.forEach(target => target.innerHTML = html);\n
}\n
\n
function resetLogFilters() {\n
    ['logDoorFilter', 'logDoorFilterTab'].forEach(id => { const el = document.getElementById(id); if (el) el.value = ''; });\n
    ['logStatusFilter', 'logStatusFilterTab'].forEach(id => { const el = document.getElementById(id); if (el) el.value = ''; });\n
    ['logAttendanceStateFilter', 'logAttendanceStateFilterTab'].forEach(id => { const el = document.getElementById(id); if (el) el.value = ''; });\n
    ['logUserSearch', 'logUserSearchTab'].forEach(id => { const el = document.getElementById(id); if (el) el.value = ''; });\n
    ['logStartDate', 'logStartDateTab'].forEach(id => { const el = document.getElementById(id); if (el) el.value = ''; });\n
    ['logEndDate', 'logEndDateTab'].forEach(id => { const el = document.getElementById(id); if (el) el.value = ''; });\n
    loadAccessLogs();\n
}\n
