function onRemoteUnlockDoorChange(doorId) {\n
    const door = (state.doors || []).find(item => String(item.door_id) === String(doorId)) || state.doors?.[0];\n
    state.pendingRemoteUnlockDoor = door || null;\n
\n
    const titleEl = document.getElementById('remoteUnlockDoorIdentity');\n
    const codeEl = document.getElementById('remoteUnlockDoorCode');\n
    const locEl = document.getElementById('remoteUnlockDoorLocation');\n
    const statusEl = document.getElementById('remoteUnlockDoorStatus');\n
    const btnEl = document.getElementById('confirmRemoteUnlockButton');\n
\n
    if (!door) {\n
        if (titleEl) titleEl.textContent = 'Pilih terminal pintu.';\n
        if (codeEl) codeEl.textContent = '-';\n
        if (locEl) locEl.textContent = '-';\n
        if (statusEl) statusEl.textContent = '-';\n
        if (btnEl) btnEl.disabled = true;\n
        return;\n
    }\n
\n
    const isOnline = remoteUnlockAllowed(door);\n
\n
    if (titleEl) titleEl.textContent = door.door_name || door.name || door.door_id;\n
    if (codeEl) codeEl.textContent = door.door_id;\n
    if (locEl) locEl.textContent = door.building_name || door.location || '-';\n
    if (statusEl) {\n
        statusEl.textContent = isOnline ? 'ONLINE ΓÇö siap menerima perintah' : 'OFFLINE / NOT ACTIVE ΓÇö terminal belum terhubung';\n
        statusEl.style.color = isOnline ? '#6ee7b7' : '#fca5a5';\n
    }\n
    if (btnEl) {\n
        btnEl.disabled = !isOnline;\n
        btnEl.title = isOnline ? 'Konfirmasi dan kirim sinyal buka relay pintu' : 'Terminal belum terhubung / offline';\n
    }\n
}\n
\n
function openRemoteUnlockModal(doorId) {\n
    const doors = state.doors || [];\n
    const select = document.getElementById('remoteUnlockDoorSelect');\n
    if (select) {\n
        select.innerHTML = doors.map(d => {\n
            const online = remoteUnlockAllowed(d);\n
            return `<option value="${escapeHtml(d.door_id)}" ${d.door_id === doorId ? 'selected' : ''}>${escapeHtml(d.door_id)} - ${escapeHtml(d.door_name || d.name || 'Terminal')} (${online ? 'ONLINE' : 'OFFLINE'})</option>`;\n
        }).join('');\n
        if (doorId) select.value = doorId;\n
    }\n
\n
    const currentDoorId = select ? select.value : doorId;\n
    onRemoteUnlockDoorChange(currentDoorId);\n
\n
    const reasonEl = document.getElementById('remoteUnlockReason');\n
    if (reasonEl) reasonEl.value = '';\n
\n
    openModal('remoteUnlockModal');\n
}\n
\n
function cancelRemoteUnlock() {\n
    state.pendingRemoteUnlockDoor = null;\n
    const reasonEl = document.getElementById('remoteUnlockReason');\n
    if (reasonEl) reasonEl.value = '';\n
    closeModal('remoteUnlockModal');\n
}\n
\n
async function confirmRemoteUnlock() {\n
    const door = state.pendingRemoteUnlockDoor;\n
    const button = document.getElementById('confirmRemoteUnlockButton');\n
    const reasonEl = document.getElementById('remoteUnlockReason');\n
    const reason = reasonEl ? reasonEl.value.trim() : '';\n
\n
    if (!door || !button) return;\n
\n
    if (!reason) {\n
        showToast('Harap masukkan alasan pembukaan pintu sebelum melanjutkan.', 'warning');\n
        if (reasonEl) reasonEl.focus();\n
        return;\n
    }\n
\n
    if (!remoteUnlockAllowed(door)) {\n
        showToast(`Remote unlock diblokir: Terminal ${door.door_id} belum online.`, 'warning');\n
        return;\n
    }\n
\n
    button.disabled = true;\n
    button.textContent = 'ΓÅ│ Mengirim perintah...';\n
    try {\n
        const res = await apiFetch(`/admin/doors/${encodeURIComponent(door.door_id)}/open`, {\n
            method: 'POST',\n
            isBackground: false,\n
            body: JSON.stringify({ reason })\n
        });\n
        if (res.status === 'success') {\n
            showToast(res.message || `Perintah remote unlock ${door.door_id} berhasil dikirim.`, 'success');\n
            cancelRemoteUnlock();\n
            await Promise.all([loadDoors(), loadAccessLogs()]);\n
            scheduleMetricCardsUpdate(true);\n
            if (hasCapability('audit.view')) await loadActivityLogs();\n
        } else {\n
            showToast(res.message || 'Remote unlock gagal.', 'error');\n
        }\n
    } catch (err) {\n
        showToast(err.message || 'Remote unlock gagal. Periksa izin dan koneksi terminal, lalu coba kembali.', 'error');\n
    } finally {\n
        button.disabled = false;\n
        button.textContent = 'Konfirmasi & Buka Pintu';\n
    }\n
}\n
\n
async function executeRemoteUnlock(button) {\n
    const doorId = button?.dataset.doorId;\n
    const door = (state.doors || []).find(item => String(item.door_id) === String(doorId));\n
    if (!door || !remoteUnlockAllowed(door) || remoteUnlockPending.has(doorId)) return;\n
\n
    remoteUnlockPending.add(doorId);\n
    const originalText = button.innerHTML;\n
    const requestKey = `remote-unlock-${doorId}-${crypto.randomUUID?.() || Date.now()}`;\n
    button.disabled = true;\n
    button.setAttribute('aria-busy', 'true');\n
    button.innerHTML = 'Membuka...';\n
    try {\n
        const res = await apiFetch(`/admin/doors/${encodeURIComponent(doorId)}/open`, {\n
            method: 'POST',\n
            isBackground: false,\n
            headers: { 'X-Idempotency-Key': requestKey },\n
            body: JSON.stringify({ reason: 'Remote unlock dari dashboard' })\n
        });\n
        if (res.status !== 'success') throw new Error(res.message || 'Remote unlock gagal.');\n
        showToast(`${door.door_name || door.name || doorId} berhasil dibuka`, 'success');\n
        await loadDoors();\n
    } catch (err) {\n
        console.error('[SecureGate] Remote unlock failed:', err);\n
        showToast(err.message || 'Remote unlock gagal. Periksa izin dan koneksi terminal.', 'error');\n
    } finally {\n
        remoteUnlockPending.delete(doorId);\n
        button.disabled = !remoteUnlockAllowed(door);\n
        button.setAttribute('aria-busy', 'false');\n
        button.innerHTML = originalText;\n
    }\n
}\n
\n
function registerRemoteUnlockHandler() {\n
    if (window.__secureGateRemoteUnlockHandler) return;\n
    window.__secureGateRemoteUnlockHandler = true;\n
    document.addEventListener('click', event => {\n
        const button = event.target.closest('[data-action="remote-unlock"]');\n
        if (!button || button.disabled) return;\n
        event.preventDefault();\n
        executeRemoteUnlock(button);\n
    });\n
}\n
\n
registerRemoteUnlockHandler();\n
\n
