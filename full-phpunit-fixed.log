async function loadSystemAccounts() {\n
    const tbody = document.getElementById('systemAccountsTableBody');\n
    const lifecycle = document.getElementById('systemAccountsLifecycle');\n
    if (!tbody) return;\n
\n
    tbody.innerHTML = '<tr><td colspan="9" class="loading-td"><div class="spinner"></div> Memuat akun sistem...</td></tr>';\n
    try {\n
        const response = await apiFetch('/admin/system-accounts');\n
        const accounts = Array.isArray(response.data) ? response.data : [];\n
        if (lifecycle) lifecycle.textContent = `Lifecycle: ${response.lifecycle || 'PLANNED'} ┬╖ Tambah, ubah, role assignment, dan reset kredensial belum tersedia`;\n
        if (accounts.length === 0) {\n
            tbody.innerHTML = '<tr><td colspan="9" class="empty-td">Belum ada akun sistem.</td></tr>';\n
            return;\n
        }\n
        tbody.innerHTML = accounts.map(account => `\n
            <tr>\n
                <td>${escapeHtml(account.name || '-')}</td>\n
                <td>${escapeHtml(account.email || '-')}</td>\n
                <td>${escapeHtml(account.role || '-')}</td>\n
                <td>${escapeHtml(account.assigned_building || '-')}</td>\n
                <td>${escapeHtml(account.employee_id || '-')}</td>\n
                <td>${escapeHtml(account.status || 'Belum tersedia')}</td>\n
                <td>${escapeHtml(account.last_login ? formatDateTime(account.last_login) : 'Belum tersedia')}</td>\n
                <td>${escapeHtml(account.created_at ? formatDateTime(account.created_at) : '-')}</td>\n
                <td><span class="badge badge-warning">PLANNED</span></td>\n
            </tr>`).join('');\n
    } catch (err) {\n
        tbody.innerHTML = `<tr><td colspan="9" class="error-td">Gagal memuat akun sistem: ${escapeHtml(err.message)}</td></tr>`;\n
    }\n
}\n
