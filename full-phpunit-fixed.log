// Modal 8: Konversi Pelamar ke Master Karyawan\n
function openConvertToEmployeeModal(applicationId, candidateName) {\n
    document.getElementById('hireAppId').value = applicationId;\n
    const nameEl = document.getElementById('hireCandName');\n
    if (nameEl) nameEl.textContent = candidateName;\n
\n
    const modal = document.getElementById('modalConvertToEmployee');\n
    if (modal) modal.classList.add('active');\n
}\n
\n
async function submitConvertToEmployee(e) {\n
    e.preventDefault();\n
    const appId = document.getElementById('hireAppId')?.value;\n
    const payload = {\n
        employee_no: document.getElementById('hireEmployeeNo')?.value.trim() || null,\n
        employment_status: document.getElementById('hireEmploymentStatus')?.value || 'contract',\n
    };\n
\n
    try {\n
        const res = await apiFetch(`/recruitment/applications/${appId}/convert-to-employee`, {\n
            method: 'POST',\n
            body: JSON.stringify(payload)\n
        });\n
        if (res.status === 'success') {\n
            showToast('Kandidat berhasil diangkat menjadi Karyawan Resmi!', 'success');\n
            closeModal('modalConvertToEmployee');\n
            document.getElementById('formConvertToEmployee')?.reset();\n
            await Promise.all([loadAtsApplications(), loadAtsMetrics(), loadEmployees()]);\n
        }\n
    } catch (err) {\n
        showToast(`Gagal mengangkat karyawan: ${err.message}`, 'error');\n
    }\n
}\n
