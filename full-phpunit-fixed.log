function openUploadDocumentModal() {\n
    const select = document.getElementById('docEmployeeSelect');\n
    if (select && state.employees) {\n
        select.innerHTML = '<option value="">Pilih Karyawan</option>' +\n
            state.employees.map(e => `<option value="${e.id}">${escapeHtml(e.name)} (${escapeHtml(e.employee_id)})</option>`).join('');\n
    }\n
\n
    const modal = document.getElementById('modalUploadDocument');\n
    if (modal) modal.classList.add('active');\n
}\n
\n
async function submitUploadDocument(e) {\n
    e.preventDefault();\n
    const fileInput = document.getElementById('docFileInput');\n
    if (!fileInput || !fileInput.files || fileInput.files.length === 0) {\n
        showToast('Silakan pilih berkas dokumen untuk diunggah.', 'warning');\n
        return;\n
    }\n
\n
    const formData = new FormData();\n
    formData.append('file', fileInput.files[0]);\n
    formData.append('employee_id', document.getElementById('docEmployeeSelect')?.value || '');\n
    formData.append('category', document.getElementById('docCategorySelect')?.value || 'OTHER');\n
    formData.append('visibility', document.getElementById('docVisibilitySelect')?.value || 'CONFIDENTIAL_HR');\n
    formData.append('title', document.getElementById('docTitle')?.value.trim() || fileInput.files[0].name);\n
\n
    try {\n
        const csrfToken = document.querySelector('meta[name="csrf-token"]')?.getAttribute('content') || '';\n
        const headers = csrfToken ? { 'X-CSRF-TOKEN': csrfToken } : {};\n
\n
        const data = await apiFetchForm('/onboarding/documents', formData, { headers });\n
        if (data.success) {\n
            showToast('Dokumen berhasil diunggah ke private storage!', 'success');\n
            closeModal('modalUploadDocument');\n
            document.getElementById('formUploadDocument')?.reset();\n
            await Promise.all([loadOnboardingDocuments(), loadOnboardingMetrics()]);\n
        } else {\n
            showToast(`Gagal mengunggah: ${data.message || 'Error validasi'}`, 'error');\n
        }\n
    } catch (err) {\n
        showToast(`Gagal mengunggah berkas: ${err.message}`, 'error');\n
    }\n
}\n
\n
function openVerifyDocumentModal(docId, title) {\n
    document.getElementById('verifyDocId').value = docId;\n
    const titleEl = document.getElementById('verifyDocTitle');\n
    if (titleEl) titleEl.textContent = title;\n
\n
    const modal = document.getElementById('modalVerifyDocument');\n
    if (modal) modal.classList.add('active');\n
}\n
\n
async function submitVerifyDocument(e) {\n
    e.preventDefault();\n
    const docId = document.getElementById('verifyDocId')?.value;\n
    const status = document.getElementById('verifyDocDecision')?.value;\n
    const notes = document.getElementById('verifyDocNotes')?.value.trim();\n
\n
    try {\n
        const res = await apiFetch(`/onboarding/documents/${docId}/verify`, {\n
            method: 'PUT',\n
            body: JSON.stringify({\n
                status: status,\n
                notes: notes || null\n
            })\n
        });\n
\n
        if (res.success) {\n
            showToast(`Status dokumen berhasil diubah menjadi ${status}!`, 'success');\n
            closeModal('modalVerifyDocument');\n
            await Promise.all([loadOnboardingDocuments(), loadOnboardingMetrics()]);\n
        }\n
    } catch (err) {\n
        showToast(`Gagal memverifikasi dokumen: ${err.message}`, 'error');\n
    }\n
}\n
\n
async function downloadSecureDocument(docId, fileName) {\n
    try {\n
        const appToken = window.APP_CONFIG?.apiToken || '';\n
        const headers = {};\n
        if (appToken) headers['Authorization'] = `Bearer ${appToken}`;\n
\n
        const res = await fetch(`/api/v1/onboarding/documents/${docId}/download`, {\n
            method: 'GET',\n
            headers: headers\n
        });\n
\n
        if (!res.ok) {\n
            const errJson = await res.json().catch(() => ({}));\n
            showToast(`Gagal mengunduh: ${errJson.message || 'Akses ditolak'}`, 'error');\n
            return;\n
        }\n
\n
        const blob = await res.blob();\n
        const url = window.URL.createObjectURL(blob);\n
        const a = document.createElement('a');\n
        a.href = url;\n
        a.download = fileName || `document_${docId}.pdf`;\n
        document.body.appendChild(a);\n
        a.click();\n
        a.remove();\n
        window.URL.revokeObjectURL(url);\n
        showToast('Berkas dokumen berhasil diunduh.', 'info');\n
    } catch (err) {\n
        showToast(`Kesalahan jaringan: ${err.message}`, 'error');\n
    }\n
}\n
\n
