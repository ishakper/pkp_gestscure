// Populate Employee dropdown for access requests, credentials, and emoney\n
async function populateAccessEmployees() {\n
    try {\n
        const res = await apiFetch('/user-management/employees?per_page=100');\n
        if (!res || !res.data) return;\n
\n
        const options = res.data.map(e => `<option value="${e.id}">${escapeHtml(e.name)} (${escapeHtml(e.employee_id || e.nik || 'Staff')})</option>`).join('');\n
\n
        const reqSelect = document.getElementById('accessReqEmployeeId');\n
        if (reqSelect) reqSelect.innerHTML = `<option value="">-- Pilih Karyawan Terdaftar --</option>` + options;\n
\n
        const crdSelect = document.getElementById('crdEmployeeId');\n
        if (crdSelect) crdSelect.innerHTML = `<option value="">-- Pilih Karyawan --</option>` + options;\n
\n
        const emnSelect = document.getElementById('emnEmployeeId');\n
        if (emnSelect) emnSelect.innerHTML = `<option value="">-- Tersedia / Belum Ditetapkan --</option>` + options;\n
\n
        // Also populate Profiles dropdown in Access Request modal\n
        const profRes = await apiFetch('/access/profiles');\n
        if (profRes && profRes.success && profRes.data) {\n
            const profOptions = profRes.data.map(p => `<option value="${p.id}" data-building="${escapeHtml(p.building_name || '')}">${escapeHtml(p.code)} - ${escapeHtml(p.name)}</option>`).join('');\n
            const profSelect = document.getElementById('accessReqProfileId');\n
            if (profSelect) profSelect.innerHTML = `<option value="">-- Pilih Profil Akses (Opsional) --</option>` + profOptions;\n
        }\n
    } catch (e) {\n
        console.error('Failed to populate employees for access modules', e);\n
        return false;\n
    }\n
}\n
