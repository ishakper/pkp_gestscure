// ATTENDANCE REPORT: Building Filter & Export Helpers\n
// = = = = =\n
let attendanceReportSeq = 0;\n
let attendanceBuildingLookupWarned = false;\n
const attendanceReportState = { data: null, buildingLabel: '' };\n
\n
// Local (browser) year-month; toISOString() is UTC and returns the previous month in early-morning WIB on the 1st.\n
function currentMonthValue() {\n
    const now = new Date();\n
    return `${now.getFullYear()}-${String(now.getMonth() + 1).padStart(2, '0')}`;\n
}\n
\n
function attendanceReportBuildingLabel() {\n
    const select = document.getElementById('attendanceReportBuilding');\n
    return select && select.value ? (select.options[select.selectedIndex]?.text || '') : '';\n
}\n
\n
// Fills the "Semua Gedung" dropdown once. Returns false when the lookup failed so the caller can keep retrying later.\n
async function ensureAttendanceReportBuildings() {\n
    const building = document.getElementById('attendanceReportBuilding');\n
    if (!building || building.options.length > 1) return true;\n
    try {\n
        const lookup = await apiFetch('/user-management/organization/lookup');\n
        const previous = building.value;\n
        (lookup.data?.buildings || []).forEach(item => building.add(new Option(item.name, String(item.id))));\n
        if (previous) building.value = previous;\n
        return true;\n
    } catch (error) {\n
        if (!error.suppressed && !attendanceBuildingLookupWarned) {\n
            attendanceBuildingLookupWarned = true;\n
            showToast(`Daftar gedung gagal dimuat: ${error.message}. Laporan tetap tampil untuk semua gedung.`, 'warning');\n
        }\n
        return false;\n
    }\n
}\n
\n
function renderAttendanceReportMetrics(totals) {\n
    document.getElementById('attendanceReportMetrics').innerHTML = `<div class="stat-card"><div class="stat-title">Employees</div><div class="stat-value">${totals.employees}</div></div><div class="stat-card"><div class="stat-title">Present</div><div class="stat-value" style="color:#10b981">${totals.present}</div></div><div class="stat-card"><div class="stat-title">Late</div><div class="stat-value" style="color:#f59e0b">${totals.late}</div></div><div class="stat-card"><div class="stat-title">Absent</div><div class="stat-value" style="color:#ef4444">${totals.absent}</div></div><div class="stat-card"><div class="stat-title">Attendance Rate</div><div class="stat-value" style="color:#38bdf8">${totals.attendance_rate}%</div></div>`;\n
}\n
\n
async function loadAttendanceMetrics() {\n
    const container = document.getElementById('attendanceMetricsContainer');\n
    if (!container) return;\n
\n
    try {\n
        const res = await apiFetch('/attendance/metrics');\n
        if (!res.success) return;\n
        \n
        const m = res.data;\n
        const t = m.today;\n
        const live = m.live || {};\n
        const total = t.present + t.late + t.absent + t.off + t.leave;\n
        const presentRate = total > 0 ? Math.round(((t.present + t.late) / total) * 100) : 0;\n
\n
        container.innerHTML = `\n
            <div class="stat-card">\n
                <div class="stat-title">Tingkat Kehadiran Harian</div>\n
                <div class="stat-value" style="color: #10b981;">${presentRate}%</div>\n
                <div class="stat-desc">Hari Ini: ${escapeHtml(t.date)}</div>\n
            </div>\n
            <div class="stat-card">\n
                <div class="stat-title">Hadir & Terlambat</div>\n
                <div class="stat-value" style="color: #f59e0b;">${t.present + t.late} <span style="font-size:1rem;font-weight:400;color:var(--text-muted);">karyawan</span></div>\n
                <div class="stat-desc">(${t.late} terlambat)</div>\n
            </div>\n
            <div class="stat-card">\n
                <div class="stat-title">Mangkir (Tanpa Keterangan)</div>\n
                <div class="stat-value" style="color: #ef4444;">${t.absent} <span style="font-size:1rem;font-weight:400;color:var(--text-muted);">karyawan</span></div>\n
                <div class="stat-desc">Potensi pelanggaran</div>\n
            </div>\n
            <div class="stat-card">\n
                <div class="stat-title">Kalender Kerja Aktif</div>\n
                <div class="stat-value" style="color: #3b82f6;">${m.calendars_count}</div>\n
                <div class="stat-desc">Dikelola oleh sistem</div>\n
            </div>\n
            <div class="stat-card">\n
                <div class="stat-title">Live Office Attendance</div>\n
                <div class="stat-value" style="font-size:1.15rem;color:#10b981;">${live.latest_event_at ? new Date(live.latest_event_at).toLocaleTimeString('id-ID', {hour:'2-digit', minute:'2-digit'}) : '-'}</div>\n
                <div class="stat-desc">${escapeHtml(live.latest_door || 'Belum ada event hari ini')}</div>\n
            </div>\n
            <div class="stat-card">\n
                <div class="stat-title">Event Belum Terpetakan</div>\n
                <div class="stat-value" style="color:#f59e0b;">${Number(live.unmatched_events || 0)}</div>\n
                <div class="stat-desc">Hanya terlihat oleh pengguna berwenang</div>\n
            </div>\n
        `;\n
    } catch (e) {\n
        console.error('Failed to load attendance metrics', e);\n
    }\n
}\n
\n
async function loadAttendanceReport() {\n
    const tbody = document.getElementById('attendanceReportBody');\n
    if (!tbody) return;\n
    const month = document.getElementById('attendanceReportMonth');\n
    if (!month.value) month.value = currentMonthValue();\n
    const building = document.getElementById('attendanceReportBuilding');\n
    const seq = ++attendanceReportSeq;\n
    tbody.innerHTML = '<tr><td colspan="7" class="loading-td"><div class="spinner"></div> Memuat laporan bulanan...</td></tr>';\n
\n
    await ensureAttendanceReportBuildings();\n
    if (seq !== attendanceReportSeq) return; // a newer month/building selection superseded this request\n
\n
    const query = new URLSearchParams({ month: month.value });\n
    if (building.value) query.set('building_id', building.value);\n
    const buildingLabel = attendanceReportBuildingLabel();\n
    if (seq !== attendanceReportSeq) return;\n
    try {\n
        const res = await apiFetch(`/attendance/reports/monthly?${query}`);\n
        if (seq !== attendanceReportSeq) return;\n
        if (seq !== attendanceReportSeq) return;\n
        attendanceReportState.data = { month: month.value, totals: res.data.totals, rows: res.data.rows, buildingLabel };\n
        attendanceReportState.buildingLabel = buildingLabel;\n
        renderAttendanceReportMetrics(res.data.totals);\n
        const emptyMsg = buildingLabel ? `Tidak ada data kehadiran untuk ${escapeHtml(buildingLabel)} di bulan ini.` : 'Tidak ada data kehadiran untuk bulan ini.';\n
        tbody.innerHTML = res.data.rows.length ? res.data.rows.map(row => `<tr><td><strong>${escapeHtml(row.employee_name)}</strong><br><small>${escapeHtml(row.employee_code)}</small></td><td>${escapeHtml(row.building)}</td><td>${row.present}</td><td>${row.late}</td><td>${row.absent}</td><td>${row.attendance_rate}%</td><td>${row.late_minutes}</td></tr>`).join('') : `<tr><td colspan="7" class="empty-td">${emptyMsg}</td></tr>`;\n
    } catch (error) {\n
        if (seq === attendanceReportSeq) tbody.innerHTML = `<tr><td colspan="7" class="error-td">${escapeHtml(error.message)}</td></tr>`;\n
    }\n
}\n
\n
async function exportAttendanceReport(btn) {\n
    const query = new URLSearchParams({ month: document.getElementById('attendanceReportMonth').value });\n
    const building = document.getElementById('attendanceReportBuilding').value;\n
    if (building) query.set('building_id', building);\n
    if (btn) { btn.disabled = true; btn.innerHTML = 'Γ¼ç Mempersiapkan export...'; }\n
    try {\n
        const response = await fetch(`${API_BASE}/attendance/reports/monthly/export?${query}`, { headers: { Accept: 'text/csv', ...(APP_TOKEN ? { Authorization: `Bearer ${APP_TOKEN}` } : {}) } });\n
        if (!response.ok) {\n
            const errBody = await response.text();\n
            return showToast(`Export gagal (${response.status}): ${escapeHtml(errBody || response.statusText)}`, 'error');\n
        }\n
        const contentType = response.headers.get('content-type') || '';\n
        if (!contentType.includes('text/csv') && !contentType.includes('application/csv')) {\n
            return showToast('Server mengembalikan format bukan CSV. Cek respon di console.', 'error');\n
        }\n
        const blob = await response.blob();\n
        if (!blob.type.includes('csv') && !blob.type.includes('plain')) {\n
            return showToast('Blob type bukan CSV, pembatalan download.', 'error');\n
        }\n
        downloadBlobAsFile(blob, `attendance-report-${query.get('month')}.csv`);\n
        showToast('Laporan kehadiran berhasil diunduh.', 'success');\n
    } catch (error) {\n
        showToast(`Export error: ${escapeHtml(error.message)}`, 'error');\n
    } finally {\n
        if (btn) { btn.disabled = false; btn.innerHTML = 'Γ¼ç Download CSV'; }\n
    }\n
}\n
\n
function printAttendanceReport() {\n
    const state = attendanceReportState;\n
    if (!state.data || !state.data.rows || !state.data.rows.length) {\n
        showToast('Tidak ada data untuk dicetak.', 'warning');\n
        return;\n
    }\n
    const { month, totals, rows, buildingLabel: scope } = state.data;\n
    const printWindow = window.open('', '_blank');\n
    const monthLabel = new Date(`${month}-01`).toLocaleDateString('id-ID', { year: 'numeric', month: 'long' });\n
    const buildingName = scope ? ` ΓÇö ${escapeHtml(scope)}` : '';\n
    const rowsHtml = rows.map(row => `<tr><td>${escapeHtml(row.employee_name)}</td><td>${escapeHtml(row.employee_code)}</td><td>${escapeHtml(row.building)}</td><td>${row.present}</td><td>${row.late}</td><td>${row.absent}</td><td>${row.attendance_rate}%</td><td>${row.late_minutes}</td></tr>`).join('');\n
    printWindow.document.write(`\n
        <!DOCTYPE html>\n
        <html>\n
        <head>\n
            <title>Laporan Kehadiran ${monthLabel}${buildingName}</title>\n
            <style>\n
                body { font-family: Arial, sans-serif; margin: 1cm; }\n
                h1 { text-align: center; font-size: 1.5em; margin-bottom: 0.5em; }\n
                .subtitle { text-align: center; color: #666; margin-bottom: 1em; }\n
                table { width: 100%; border-collapse: collapse; margin-top: 1em; }\n
                th, td { border: 1px solid #333; padding: 0.5em; text-align: left; }\n
                th { background: #f0f0f0; font-weight: bold; }\n
                .stats { margin: 1em 0; display: flex; gap: 2em; }\n
                .stat { flex: 1; }\n
                .stat-label { font-weight: bold; }\n
                .stat-value { font-size: 1.2em; color: #0066cc; }\n
                @media print { body { margin: 0; } }\n
            </style>\n
        </head>\n
        <body>\n
            <h1>Laporan Kehadiran Karyawan</h1>\n
            <p class="subtitle">${monthLabel}${buildingName}</p>\n
            <div class="stats">\n
                <div class="stat"><div class="stat-label">Total Karyawan</div><div class="stat-value">${totals.employees}</div></div>\n
                <div class="stat"><div class="stat-label">Hadir</div><div class="stat-value">${totals.present}</div></div>\n
                <div class="stat"><div class="stat-label">Terlambat</div><div class="stat-value">${totals.late}</div></div>\n
                <div class="stat"><div class="stat-label">Absen</div><div class="stat-value">${totals.absent}</div></div>\n
                <div class="stat"><div class="stat-label">Persentase Kehadiran</div><div class="stat-value">${totals.attendance_rate}%</div></div>\n
            </div>\n
            <table>\n
                <thead>\n
                    <tr>\n
                        <th>Nama</th>\n
                        <th>Kode</th>\n
                        <th>Gedung</th>\n
                        <th>Hadir</th>\n
                        <th>Terlambat</th>\n
                        <th>Absen</th>\n
                        <th>%</th>\n
                        <th>Menit Terlambat</th>\n
                    </tr>\n
                </thead>\n
                <tbody>${rowsHtml}</tbody>\n
            </table>\n
            <p style="text-align: right; color: #999; margin-top: 2em; font-size: 0.9em;">Dicetak pada ${new Date().toLocaleString('id-ID')}</p>\n
            <script>window.print();</script>\n
        </body>\n
        </html>\n
    `);\n
    printWindow.document.close();\n
}\n
\n
function downloadBlobAsFile(blob, filename) {\n
    const url = URL.createObjectURL(blob);\n
    const link = document.createElement('a');\n
    link.href = url;\n
    link.download = filename;\n
    document.body.appendChild(link);\n
    link.click();\n
    document.body.removeChild(link);\n
    setTimeout(() => URL.revokeObjectURL(url), 100);\n
}\n
\n
async function openFacilityModal(doorId = null) {\n
    openModal('facilityModal');\n
    try {\n
        const response = await apiFetch('/admin/buildings');\n
        const select = document.getElementById('facilityDoorBuilding');\n
        if (select && response?.data) {\n
            select.innerHTML = '<option value="">Select building</option>' + response.data.map(item => `<option value="${item.id}">${escapeHtml(item.name)}</option>`).join('');\n
        }\n
        const door = doorId ? (state.doors || []).find(item => String(item.door_id).toUpperCase() === String(doorId).toUpperCase()) : null;\n
        const origIdEl = document.getElementById('facilityOriginalDoorId');\n
        const idEl = document.getElementById('facilityDoorId');\n
        const nameEl = document.getElementById('facilityDoorName');\n
        const ipEl = document.getElementById('facilityDoorIp');\n
        const gwEl = document.getElementById('facilityDoorGateway');\n
        const modelEl = document.getElementById('facilityDoorModel');\n
        const submitBtn = document.getElementById('facilityDoorSubmit');\n
\n
        if (origIdEl) origIdEl.value = door?.door_id || '';\n
        if (idEl) idEl.value = door?.door_id || '';\n
        if (nameEl) nameEl.value = door?.door_name || door?.name || '';\n
        if (ipEl) ipEl.value = door?.device_ip || door?.ip_address || '';\n
        if (gwEl) gwEl.value = door?.gateway || '192.168.90.1';\n
        if (modelEl) modelEl.value = door?.device_model || door?.model || 'DS-K1T804AMF';\n
        if (submitBtn) submitBtn.textContent = door ? 'Update Door' : 'Register Door';\n
\n
        if (select && door) {\n
            if (door.building_id) {\n
                select.value = String(door.building_id);\n
            } else if (door.building_name || door.location) {\n
                const loc = door.building_name || door.location;\n
                const matched = (response?.data || []).find(b => b.name === loc || loc.includes(b.name) || b.name.includes(loc));\n
                if (matched) select.value = String(matched.id);\n
            }\n
        }\n
    } catch (err) {\n
        showToast(`Gagal memuat konfigurasi gedung: ${err.message}`, 'error');\n
    }\n
}\n
\n
async function submitBuildingConfig(event) {\n
    event.preventDefault();\n
    try {\n
        await apiFetch('/admin/buildings', { method: 'POST', body: JSON.stringify({ code: document.getElementById('facilityBuildingCode').value, name: document.getElementById('facilityBuildingName').value, description: document.getElementById('facilityBuildingDescription').value || null }) });\n
        event.target.reset();\n
        await openFacilityModal(document.getElementById('facilityOriginalDoorId').value || null);\n
        showToast('Building registered.', 'success');\n
    } catch (error) { showToast(error.message, 'error'); }\n
}\n
\n
async function submitDoorConfig(event) {\n
    event.preventDefault();\n
    const original = document.getElementById('facilityOriginalDoorId').value;\n
    const payload = {\n
        door_id: document.getElementById('facilityDoorId').value,\n
        name: document.getElementById('facilityDoorName').value,\n
        building_id: Number(document.getElementById('facilityDoorBuilding').value),\n
        device_ip: document.getElementById('facilityDoorIp').value,\n
        gateway: document.getElementById('facilityDoorGateway').value || null,\n
        device_model: document.getElementById('facilityDoorModel').value\n
    };\n
    try {\n
        const res = await apiFetch(original ? `/admin/doors/${encodeURIComponent(original)}` : '/admin/doors', {\n
            method: original ? 'PUT' : 'POST',\n
            body: JSON.stringify(payload),\n
            isBackground: false\n
        });\n
        closeModal('facilityModal');\n
        await loadDoors();\n
        showToast(original ? (res.message || 'Konfigurasi pintu berhasil diperbarui.') : 'Door registered offline pending verification.', 'success');\n
    } catch (error) {\n
        showToast(error.message, 'error');\n
    }\n
}\n
