                            ${escapeHtml(inv.stage_code)}\n
                        </span>\n
                    </td>\n
                    <td>\n
                        <div style="color: #cbd5e1;">${escapeHtml(inv.interviewer_name || '-')}</div>\n
                    </td>\n
                    <td>\n
                        <div style="color: #e2e8f0; font-weight: 600;">${formatDateTime(inv.scheduled_at)}</div>\n
                        <div style="font-size: 0.775rem; color: var(--text-muted);">${inv.duration_minutes} Menit</div>\n
                    </td>\n
                    <td>\n
                        ${isLink ? `<a href="${escapeHtml(inv.location)}" target="_blank" style="color: var(--primary); text-decoration: underline;">Tautan Meeting Γåù</a>` : `<span style="color: #cbd5e1;">${escapeHtml(inv.location || '-')}</span>`}\n
                    </td>\n
                    <td>\n
                        <span class="badge ${statusClass}">${escapeHtml(inv.status)}</span>\n
                    </td>\n
                    <td>\n
                        ${inv.result ? `\n
                            <div style="font-weight: 700; color: ${inv.result === 'PROCEED' ? '#10b981' : (inv.result === 'REJECT' ? '#ef4444' : '#f59e0b')}">${escapeHtml(inv.result)}</div>\n
                            <div style="font-size: 0.775rem; color: var(--text-muted);">Skor: ${inv.score ?? '-'}/100</div>\n
                        ` : '<span style="color: var(--text-muted); font-size: 0.8rem;">Menunggu Evaluasi</span>'}\n
                    </td>\n
                    <td style="text-align: right;">\n
                        ${inv.status === 'SCHEDULED' ? `\n
                            <button class="btn-action" style="background: rgba(99, 102, 241, 0.2); color: #a5b4fc; border-color: rgba(99, 102, 241, 0.4);" onclick="openInterviewFeedbackModal(${inv.id})">\n
                                Γ£ì∩╕Å Nilai\n
                            </button>\n
                        ` : ''}\n
                    </td>\n
                </tr>\n
            `;\n
        }).join('');\n
    } catch (err) {\n
        tbody.innerHTML = `<tr><td colspan="8" class="error-td">Gagal memuat interview: ${escapeHtml(err.message)}</td></tr>`;\n
    }\n
}\n
