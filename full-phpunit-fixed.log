    formData.append('request_type', document.getElementById('newCorrType').value);\n
\n
    const checkInVal = document.getElementById('newCorrCheckIn').value;\n
    if (checkInVal) formData.append('requested_check_in', checkInVal);\n
\n
    const checkOutVal = document.getElementById('newCorrCheckOut').value;\n
    if (checkOutVal) formData.append('requested_check_out', checkOutVal);\n
\n
    const statusVal = document.getElementById('newCorrStatus').value;\n
    if (statusVal) formData.append('requested_status', statusVal);\n
\n
    formData.append('reason', document.getElementById('newCorrReason').value);\n
\n
    const noteVal = document.getElementById('newCorrEvidenceNote').value;\n
    if (noteVal) formData.append('evidence_note', noteVal);\n
\n
    const attInput = document.getElementById('newCorrAttachment');\n
