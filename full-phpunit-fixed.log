\n
function formatRupiah(amount) {\n
    if (!amount || isNaN(amount)) return '-';\n
    return 'Rp ' + Number(amount).toLocaleString('id-ID');\n
}\n
\n
function formatDateTime(dtStr) {\n
    if (!dtStr) return '-';\n
    try {\n
        const d = new Date(dtStr);\n
        return d.toLocaleDateString('id-ID', { day: '2-digit', month: 'short', year: 'numeric', hour: '2-digit', minute: '2-digit' });\n
    } catch {\n
        return dtStr;\n
    }\n
}\n
\n
function switchAtsPill(pillName, btn) {\n
    document.querySelectorAll('.ats-nav-pill').forEach(el => el.classList.remove('active'));\n
    document.querySelectorAll('.ats-sub-content').forEach(el => el.classList.remove('active'));\n
\n
    if (btn) {\n
        btn.classList.add('active');\n
    } else {\n
        const defaultBtn = document.getElementById(`pill${pillName.charAt(0).toUpperCase() + pillName.slice(1)}`);\n
        if (defaultBtn) defaultBtn.classList.add('active');\n
    }\n
\n
    const subId = `atsSub${pillName.charAt(0).toUpperCase() + pillName.slice(1)}`;\n
    const subTarget = document.getElementById(subId);\n
    if (subTarget) subTarget.classList.add('active');\n
\n
    state.ats.activePill = pillName;\n
\n
    if (pillName === 'pipeline') loadAtsApplications();\n
    if (pillName === 'vacancies') loadAtsVacancies();\n
    if (pillName === 'candidates') loadAtsCandidates();\n
    if (pillName === 'interviews') loadAtsInterviews();\n
}\n
