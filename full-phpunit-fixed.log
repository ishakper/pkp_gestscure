async function openDoorAssignmentModal(empId) {\n
    const employee = state.employees.find(e => e.id === empId || e.id == empId);\n
    if (!employee) return;\n
\n
    state.selectedEmployeeForAssign = employee;\n
\n
    document.getElementById('assignModalEmpName').innerText = `${employee.name} (${employee.user_id} - ${employee.nik})`;\n
    document.getElementById('assignModalEmpDept').innerText = `Departemen: ${employee.department} | Role: ${employee.role || 'Staff'}`;\n
\n
    const container = document.getElementById('doorCheckboxesContainer');\n
    container.innerHTML = '<div class="spinner"></div> Memuat daftar pintu...';\n
\n
    document.getElementById('doorAssignModal').classList.add('active');\n
\n
    // Fetch Lookup Doors\n
    try {\n
        const res = await apiFetch('/user-management/doors-lookup');\n
        if (res.status === 'success') {\n
            state.doorsLookup = res.data;\n
            renderDoorAssignmentCheckboxes(state.doorsLookup, employee);\n
        }\n
    } catch (err) {\n
        container.innerHTML = `<div class="error-message">Gagal memuat lookup pintu: ${err.message}</div>`;\n
    }\n
}\n
\n
function renderDoorAssignmentCheckboxes(doors, employee) {\n
    const container = document.getElementById('doorCheckboxesContainer');\n
    if (!container) return;\n
\n
    // Get currently assigned door IDs / codes\n
    const assignedDoorIds = (employee.door_assign || []).map(d => d.door_id);\n
\n
    container.innerHTML = doors.map(door => {\n
        const isChecked = assignedDoorIds.includes(door.door_id) || assignedDoorIds.includes(door.id);\n
        const safeDoorId = escapeHtml(door.door_id);\n
        const safeDoorName = escapeHtml(door.name || '');\n
        const safeDoorLoc = escapeHtml(door.location || '');\n
        const operationalDoor = state.doors.find(item => String(item.door_id) === String(door.door_id));\n
        const isOnline = operationalDoor && (operationalDoor.connection_status === 'online' || operationalDoor.status === 'online');\n
        const assignment = (employee.door_assign || []).find(item => String(item.door_id) === String(door.door_id));\n
        const syncLabel = assignment ? escapeHtml(assignment.sync_status || 'pending') : 'not assigned';\n
\n
        return `\n
            <label class="door-checkbox-card ${isChecked ? 'selected' : ''}">\n
                <input type="checkbox" name="assign_door_ids" value="${safeDoorId}" ${isChecked ? 'checked' : ''} onchange="this.parentElement.classList.toggle('selected', this.checked)">\n
                <div class="checkbox-door-info">\n
                    <div class="checkbox-door-code">${safeDoorId}</div>\n
                    <div class="checkbox-door-name">${safeDoorName}</div>\n
                    <div class="checkbox-door-loc">${safeDoorLoc}</div>\n
                    <div class="checkbox-door-loc">${isOnline ? '≡ƒƒó Online' : '≡ƒö┤ Offline'} ┬╖ Sync: ${syncLabel}</div>\n
                </div>\n
            </label>\n
        `;\n
    }).join('');\n
}\n
