// SPRINT 11: ATTENDANCE REQUESTS (WFH, LEAVE, PERMISSION, SICK)\n
// = = = = =\n
\n
let attendanceRequestsCache = [];\n
\n
async function loadAttendanceRequestsData() {\n
    const tbody = document.getElementById('attendanceRequestsTableBody');\n
    if (!tbody) return;\n
\n
    tbody.innerHTML = '<tr><td colspan="9" class="loading-td"><div class="spinner"></div> Memuat daftar pengajuan absensi...</td></tr>';\n
\n
    try {\n
        // 1. Fetch Metrics\n
        const metricsRes = await apiFetch('/attendance-requests/metrics').catch(() => null);\n
        if (metricsRes && metricsRes.data) {\n
            const m = metricsRes.data;\n
            const pEl = document.getElementById('reqMetricPending');\n
            const aEl = document.getElementById('reqMetricApproved');\n
            const rEl = document.getElementById('reqMetricRejected');\n
            const wEl = document.getElementById('reqMetricWfh');\n
            const lsEl = document.getElementById('reqMetricLeaveSick');\n
\n
            if (pEl) pEl.innerText = m.submitted || 0;\n
            if (aEl) aEl.innerText = m.approved || 0;\n
            if (rEl) rEl.innerText = m.rejected || 0;\n
            if (wEl) wEl.innerText = m.wfh_count || 0;\n
            if (lsEl) lsEl.innerText = (m.leave_count || 0) + (m.sick_count || 0);\n
        }\n
\n
        // 2. Fetch Requests\n
        const type = document.getElementById('reqFilterType')?.value || '';\n
        const status = document.getElementById('reqFilterStatus')?.value || '';\n
        const fromDate = document.getElementById('reqFilterFrom')?.value || '';\n
        const toDate = document.getElementById('reqFilterTo')?.value || '';\n
\n
        let url = '/attendance-requests?per_page=50';\n
        if (type) url += `&request_type=${encodeURIComponent(type)}`;\n
        if (status) url += `&status=${encodeURIComponent(status)}`;\n
        if (fromDate) url += `&from_date=${encodeURIComponent(fromDate)}`;\n
        if (toDate) url += `&to_date=${encodeURIComponent(toDate)}`;\n
\n
        const res = await apiFetch(url);\n
        const items = res.data || [];\n
        attendanceRequestsCache = items;\n
\n
        if (items.length === 0) {\n
            tbody.innerHTML = '<tr><td colspan="9" style="text-align: center; color: var(--text-muted); padding: 2rem;">Belum ada data pengajuan absensi untuk filter ini.</td></tr>';\n
            return;\n
        }\n
\n
        const currentAdminId = window.APP_CONFIG?.admin?.id || null;\n
        const currentEmpId = window.APP_CONFIG?.admin?.employeeId || null;\n
        const currentRole = (window.APP_CONFIG?.admin?.role || '').toLowerCase();\n
        const canManage = ['super_admin', 'hrd', 'management', 'supervisor'].includes(currentRole);\n
\n
        tbody.innerHTML = items.map(req => {\n
            const empName = req.employee ? req.employee.name : `Emp #${req.employee_id}`;\n
            const empDept = req.employee?.employee_id ? `(${req.employee.employee_id})` : '';\n
\n
            // Status badge\n
            let badgeClass = 'status-badge';\n
            let badgeLabel = req.status;\n
            if (req.status === 'SUBMITTED') {\n
                badgeClass += ' status-pending';\n
                badgeLabel = 'Menunggu';\n
            } else if (req.status === 'APPROVED') {\n
                badgeClass += ' status-active';\n
                badgeLabel = 'Disetujui';\n
            } else if (req.status === 'REJECTED') {\n
                badgeClass += ' status-expired';\n
                badgeLabel = 'Ditolak';\n
            } else if (req.status === 'CANCELLED') {\n
                badgeClass += ' status-badge';\n
                badgeLabel = 'Dibatalkan';\n
            }\n
\n
            // Type badge\n
            const typeColor = {\n
                'WFH': '#3b82f6',\n
                'LEAVE': '#8b5cf6',\n
                'PERMISSION': '#f59e0b',\n
                'SICK': '#ef4444'\n
            }[req.request_type] || '#10b981';\n
\n
            const period = (req.start_date === req.end_date)\n
                ? req.start_date\n
                : `${req.start_date} s/d ${req.end_date}`;\n
\n
            const timeInfo = (req.start_time || req.end_time)\n
                ? `${req.start_time || ''} - ${req.end_time || ''}`\n
                : (req.category || '-');\n
\n
            // Attachment link\n
            const docLink = req.attachment_path\n
                ? `<a href="/api/v1/attendance-requests/${req.id}/attachment" target="_blank" class="btn-table-action" title="Unduh Dokumen">≡ƒôÄ Berkas</a>`\n
                : '-';\n
\n
            // Actions\n
            let actions = [];\n
            const isSelf = currentEmpId && (parseInt(currentEmpId, 10) === parseInt(req.employee_id, 10));\n
            if (req.status === 'SUBMITTED' && canManage && !isSelf) {\n
                actions.push(`<button class="btn-table-action" style="color: var(--success);" onclick="approveAttendanceRequest(${req.id})">Γ£ô Setujui</button>`);\n
                actions.push(`<button class="btn-table-action" style="color: var(--danger);" onclick="openRejectAttendanceRequestModal(${req.id})">Γ£ò Tolak</button>`);\n
            }\n
\n
            if ((req.status === 'SUBMITTED' && isSelf) || (['super_admin', 'hrd'].includes(currentRole) && ['SUBMITTED', 'APPROVED'].includes(req.status))) {\n
                actions.push(`<button class="btn-table-action" style="color: var(--text-muted);" onclick="cancelAttendanceRequest(${req.id})">Batal</button>`);\n
            }\n
\n
            return `\n
                <tr>\n
                    <td>#${req.id}</td>\n
                    <td><strong>${escapeHtml(empName)}</strong> <small style="color:var(--text-muted);">${escapeHtml(empDept)}</small></td>\n
                    <td><span class="status-badge" style="background: ${typeColor}22; color: ${typeColor}; border: 1px solid ${typeColor}66;">${req.request_type}</span></td>\n
                    <td>${period}</td>\n
                    <td><small>${escapeHtml(timeInfo)}</small></td>\n
                    <td><small title="${escapeHtml(req.reason)}">${escapeHtml(req.reason.length > 30 ? req.reason.substring(0, 30) + '...' : req.reason)}</small></td>\n
                    <td>${docLink}</td>\n
                    <td><span class="${badgeClass}">${badgeLabel}</span></td>\n
                    <td><div style="display: flex; gap: 0.25rem;">${actions.join('') || '-'}</div></td>\n
                </tr>\n
            `;\n
        }).join('');\n
    } catch (err) {\n
        tbody.innerHTML = `<tr><td colspan="9" style="text-align: center; color: var(--danger); padding: 2rem;">Gagal memuat permohonan: ${escapeHtml(err.message)}</td></tr>`;\n
    }\n
}\n
\n
function onReqTypeChanged() {\n
    const type = document.getElementById('newReqType')?.value;\n
    const timeRow = document.getElementById('newReqTimeRow');\n
    const catRow = document.getElementById('newReqCategoryRow');\n
    const attRow = document.getElementById('newReqAttachmentRow');\n
\n
    if (timeRow) {\n
        timeRow.style.display = (type === 'PERMISSION') ? 'flex' : 'none';\n
    }\n
    if (catRow) {\n
        catRow.style.display = (type === 'LEAVE' || type === 'PERMISSION') ? 'block' : 'none';\n
    }\n
    if (attRow) {\n
        attRow.style.display = (type === 'SICK' || type === 'LEAVE') ? 'block' : 'none';\n
    }\n
}\n
\n
function openNewAttendanceRequestModal() {\n
    const form = document.getElementById('newAttendanceRequestForm');\n
    if (form) form.reset();\n
\n
    const today = new Date().toISOString().split('T')[0];\n
    const startEl = document.getElementById('newReqStartDate');\n
    const endEl = document.getElementById('newReqEndDate');\n
    if (startEl) startEl.value = today;\n
    if (endEl) endEl.value = today;\n
\n
    onReqTypeChanged();\n
    const modal = document.getElementById('newAttendanceRequestModal');\n
    if (modal) modal.classList.add('active');\n
}\n
\n
async function submitNewAttendanceRequest(e) {\n
    e.preventDefault();\n
    const btn = document.getElementById('btnSubmitNewReq');\n
    const origText = btn ? btn.innerText : '';\n
    if (btn) { btn.disabled = true; btn.innerText = 'Mengirim...'; }\n
\n
    const form = document.getElementById('newAttendanceRequestForm');\n
    const formData = new FormData();\n
\n
    formData.append('request_type', document.getElementById('newReqType')?.value || '');\n
    formData.append('start_date', document.getElementById('newReqStartDate')?.value || '');\n
    formData.append('end_date', document.getElementById('newReqEndDate')?.value || '');\n
    formData.append('reason', document.getElementById('newReqReason')?.value || '');\n
\n
    const cat = document.getElementById('newReqCategory')?.value;\n
    if (cat) formData.append('category', cat);\n
\n
    const startTime = document.getElementById('newReqStartTime')?.value;\n
    if (startTime) formData.append('start_time', startTime);\n
\n
    const endTime = document.getElementById('newReqEndTime')?.value;\n
    if (endTime) formData.append('end_time', endTime);\n
\n
    const attFile = document.getElementById('newReqAttachment')?.files[0];\n
    if (attFile) formData.append('attachment', attFile);\n
\n
    try {\n
        const csrfToken = document.querySelector('meta[name="csrf-token"]')?.getAttribute('content') || '';\n
        const headers = {\n
            ...(csrfToken ? { 'X-CSRF-TOKEN': csrfToken } : {}),\n
            'X-Requested-With': 'XMLHttpRequest',\n
        };\n
\n
        const data = await apiFetchForm('/attendance-requests', formData, { headers });\n
        if (data.success) {\n
            showToast(data.message || 'Permohonan absensi berhasil dikirim.', 'success');\n
            closeModal('newAttendanceRequestModal');\n
            await loadAttendanceRequestsData();\n
        } else {\n
            showToast(data.message || (data.errors ? Object.values(data.errors).flat().join(', ') : 'Gagal mengirim permohonan.'), 'error');\n
        }\n
    } catch (err) {\n
        showToast('Kesalahan koneksi: ' + err.message, 'error');\n
    } finally {\n
        if (btn) { btn.disabled = false; btn.innerText = origText; }\n
    }\n
}\n
\n
async function approveAttendanceRequest(id) {\n
    if (!confirm('Konfirmasi: Setujui permohonan absensi ini?')) return;\n
\n
    try {\n
        const res = await apiFetch(`/attendance-requests/${id}/approve`, {\n
            method: 'POST'\n
        });\n
        if (res.success) {\n
            showToast(res.message || 'Permohonan berhasil disetujui.', 'success');\n
            await loadAttendanceRequestsData();\n
        }\n
    } catch (err) {\n
        showToast('Gagal menyetujui: ' + err.message, 'error');\n
    }\n
}\n
\n
function openRejectAttendanceRequestModal(id) {\n
    const idInput = document.getElementById('rejectAttendanceReqId');\n
    const reasonInput = document.getElementById('rejectReasonInput');\n
    if (idInput) idInput.value = id;\n
    if (reasonInput) reasonInput.value = '';\n
\n
    const modal = document.getElementById('rejectAttendanceRequestModal');\n
    if (modal) modal.classList.add('active');\n
}\n
\n
async function submitRejectAttendanceRequest(e) {\n
    e.preventDefault();\n
    const id = document.getElementById('rejectAttendanceReqId')?.value;\n
    const reason = document.getElementById('rejectReasonInput')?.value?.trim();\n
    const btn = document.getElementById('btnSubmitRejectReq');\n
\n
    if (!id || !reason) {\n
        showToast('Alasan penolakan wajib diisi.', 'warning');\n
        return;\n
    }\n
\n
    const origText = btn ? btn.innerText : '';\n
    if (btn) { btn.disabled = true; btn.innerText = 'Menyimpan...'; }\n
\n
    try {\n
        const res = await apiFetch(`/attendance-requests/${id}/reject`, {\n
            method: 'POST',\n
            body: JSON.stringify({ reason })\n
        });\n
        if (res.success) {\n
            showToast(res.message || 'Permohonan berhasil ditolak.', 'success');\n
            closeModal('rejectAttendanceRequestModal');\n
            await loadAttendanceRequestsData();\n
        }\n
    } catch (err) {\n
        showToast('Gagal menolak: ' + err.message, 'error');\n
    } finally {\n
        if (btn) { btn.disabled = false; btn.innerText = origText; }\n
    }\n
}\n
\n
async function cancelAttendanceRequest(id) {\n
    const reason = prompt('Alasan pembatalan (opsional):');\n
    if (reason === null) return; // cancelled prompt\n
\n
    try {\n
        const res = await apiFetch(`/attendance-requests/${id}/cancel`, {\n
            method: 'POST',\n
            body: JSON.stringify({ reason })\n
        });\n
        if (res.success) {\n
            showToast(res.message || 'Permohonan berhasil dibatalkan.', 'success');\n
            await loadAttendanceRequestsData();\n
        }\n
    } catch (err) {\n
        showToast('Gagal membatalkan: ' + err.message, 'error');\n
    }\n
}\n
