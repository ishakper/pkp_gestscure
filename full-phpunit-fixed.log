    e.preventDefault();\n
    const payload = {\n
        candidate_id: document.getElementById('applyCandidateId')?.value,\n
        vacancy_id: document.getElementById('applyVacancyId')?.value,\n
        expected_salary: document.getElementById('applyExpectedSalary')?.value || null,\n
