// = = = = =\n
// Section 5: Real-Time SSE Stream (Phase 7-13)\n
// = = = = =\n
const realtime = {\n
    source: null,\n
    reconnectTimer: null,\n
    pollingTimer: null,\n
    refreshTimer: null,\n
    failures: 0,\n
    state: 'OFFLINE',\n
};\n
\n
function stopRealtimeTimers() {\n
    clearTimeout(realtime.reconnectTimer);\n
    clearInterval(realtime.pollingTimer);\n
    realtime.reconnectTimer = null;\n
    realtime.pollingTimer = null;\n
}\n
\n
function closeLiveAccessStream() {\n
    if (realtime.source) {\n
        realtime.source.onopen = null;\n
        realtime.source.onmessage = null;\n
        realtime.source.onerror = null;\n
        realtime.source.close();\n
    }\n
    realtime.source = null;\n
}\n
\n
function reconcileLiveData() {\n
    if (document.hidden || isRedirectingToLogin) return;\n
    loadDoors();\n
    loadAccessLogs();\n
    updateMetricCards();\n
    if (state.activeTab === 'attendanceTab') loadAttendanceData();\n
    if (state.activeTab === 'logsTab' && hasCapability('audit.view')) loadActivityLogs();\n
}\n
\n
function startFallbackPolling() {\n
    closeLiveAccessStream();\n
    clearInterval(realtime.pollingTimer);\n
    realtime.state = 'FALLBACK_POLLING';\n
    reconcileLiveData();\n
    realtime.pollingTimer = setInterval(reconcileLiveData, 60000);\n
}\n
\n
function scheduleSseReconnect(isNormalRotation = false) {\n
    closeLiveAccessStream();\n
    clearTimeout(realtime.reconnectTimer);\n
\n
    if (isNormalRotation) {\n
        // Normal 55s worker recycling: do not increment failure count, do not fall back to polling\n
        realtime.failures = 0;\n
        realtime.state = 'ROTATING';\n
        realtime.reconnectTimer = setTimeout(initLiveAccessStream, 1000);\n
        return;\n
    }\n
\n
    realtime.failures++;\n
    if (realtime.failures >= 4) {\n
        startFallbackPolling();\n
        return;\n
    }\n
    realtime.state = 'BACKOFF';\n
    const delay = Math.min(30000, 2000 * (2 ** (realtime.failures - 1)));\n
    realtime.reconnectTimer = setTimeout(initLiveAccessStream, delay);\n
}\n
\n
function initLiveAccessStream() {\n
    if (document.hidden || isRedirectingToLogin || realtime.source) return;\n
    clearInterval(realtime.pollingTimer);\n
    realtime.pollingTimer = null;\n
    realtime.state = 'CONNECTING';\n
\n
    const source = new EventSource('/live-stream');\n
    realtime.source = source;\n
\n
    source.onopen = () => {\n
        if (realtime.source !== source) return;\n
        realtime.failures = 0;\n
        realtime.state = 'CONNECTED';\n
    };\n
\n
    source.onmessage = event => {\n
        if (realtime.source !== source) return;\n
        try {\n
            const parsed = JSON.parse(event.data);\n
            handleNewLiveEvent(parsed);\n
        } catch (_) {\n
            // Unparseable message (e.g. raw comment or unknown format)\n
        }\n
    };\n
\n
    // Server-Sent Events 'reload' sent at 55s for graceful PHP worker recycling\n
    source.addEventListener('reload', () => {\n
        scheduleSseReconnect(true);\n
    });\n
\n
    source.onerror = () => {\n
        scheduleSseReconnect(false);\n
    };\n
}\n
\n
function handleNewLiveEvent(data) {\n
    if (!data || !data.door_name) return; // Ignore empty or heartbeat payloads\n
    let type = 'success';\n
    if (data.access_status === 'DENIED') type = 'warning';\n
    if (data.access_status === 'ERROR') type = 'error';\n
    if (data.verify_method === 'REMOTE_UNLOCK') type = 'info';\n
    showToast(`≡ƒÜ¬ ${data.door_name} - ${data.employee_name} (${data.access_status})`, type, 5000);\n
\n
    clearTimeout(realtime.refreshTimer);\n
    realtime.refreshTimer = setTimeout(reconcileLiveData, 500);\n
}\n
\n
function stopRealtime() {\n
    stopRealtimeTimers();\n
    clearTimeout(realtime.refreshTimer);\n
    closeLiveAccessStream();\n
    realtime.state = 'OFFLINE';\n
}\n
