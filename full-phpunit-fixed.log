    document.getElementById('empEmploymentType').value = emp.employment_type || ''; document.getElementById('empEmploymentStatus').value = emp.employment_status || 'ACTIVE'; document.getElementById('empHireDate').value = emp.hire_date || '';\n
    document.getElementById('empFp').checked = Boolean(emp.biometric_status?.fingerprint_enrolled);\n
    document.getElementById('empCard').checked = Boolean(emp.biometric_status?.card_enrolled);\n
