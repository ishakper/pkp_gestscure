// SPRINT 12: OVERTIME REQUESTS (CLIENT CONTROLLER)\n
// = = = = =\n
async function loadOvertimeRequestsData() {\n
    const tbody = document.getElementById('overtimeRequestsTableBody');\n
    if (!tbody) return;\n
\n
    tbody.innerHTML = `<tr><td colspan="10" class="loading-td"><div class="spinner"></div> Memuat data pengajuan lembur...</td></tr>`;\n
\n
    // 1. Metrics\n
    try {\n
        const mRes = await apiFetch('/overtime-requests/metrics');\n
        if (mRes.success && mRes.data) {\n
            const d = mRes.data;\n
            const setVal = (id, v) => { const el = document.getElementById(id); if (el) el.innerText = v; };\n
            setVal('otMetricPending', d.submitted || 0);\n
            setVal('otMetricApproved', d.approved || 0);\n
            setVal('otMetricRejected', d.rejected || 0);\n
            const totalHours = ((d.total_approved_minutes || 0) / 60).toFixed(1);\n
            setVal('otMetricTotalHours', `${totalHours} Jam`);\n
        }\n
    } catch (e) {\n
        console.warn('Failed to load overtime metrics:', e);\n
    }\n
\n
    // 2. List\n
    const status = document.getElementById('otFilterStatus')?.value || '';\n
    const from = document.getElementById('otFilterFrom')?.value || '';\n
    const to = document.getElementById('otFilterTo')?.value || '';\n
\n
    const params = new URLSearchParams();\n
    if (status) params.append('status', status);\n
    if (from) params.append('from_date', from);\n
    if (to) params.append('to_date', to);\n
\n
    try {\n
        const res = await apiFetch('/overtime-requests?' + params.toString());\n
        if (!res.success || !res.data || res.data.length === 0) {\n
            tbody.innerHTML = `<tr><td colspan="10" style="text-align: center; padding: 2rem; color: var(--text-muted);">Tidak ada pengajuan lembur yang sesuai.</td></tr>`;\n
            return;\n
        }\n
\n
        const role = (window.APP_CONFIG?.admin?.role || '').toLowerCase();\n
        const canApprove = ['super_admin', 'hrd', 'management', 'supervisor'].includes(role);\n
\n
        tbody.innerHTML = res.data.map(item => {\n
            const empName = item.employee?.name || `Karyawan #${item.employee_id}`;\n
            const otDate = item.overtime_date ? item.overtime_date.substring(0, 10) : '-';\n
            const timeRange = `${item.requested_start?.substring(0, 5) || '-'} s/d ${item.requested_end?.substring(0, 5) || '-'}`;\n
            const reqDuration = `${item.requested_minutes || 0} mnt`;\n
            const appDuration = item.status === 'APPROVED' ? `<strong style="color: var(--success);">${item.approved_minutes || 0} mnt</strong>` : `<span style="color: var(--text-muted);">-</span>`;\n
\n
            // Status Badge\n
            let statusBadge = `<span class="badge badge-warning">SUBMITTED</span>`;\n
            if (item.status === 'APPROVED') statusBadge = `<span class="badge badge-success">APPROVED</span>`;\n
            if (item.status === 'REJECTED') statusBadge = `<span class="badge badge-danger">REJECTED</span>`;\n
            if (item.status === 'CANCELLED') statusBadge = `<span class="badge" style="background: var(--text-muted); color: #fff;">CANCELLED</span>`;\n
\n
            // Attachment link\n
            let docLink = `<span style="color: var(--text-muted); font-size: 0.75rem;">-</span>`;\n
            if (item.attachment_path) {\n
                docLink = `<a href="/api/v1/overtime-requests/${item.id}/attachment" target="_blank" class="btn-secondary" style="padding: 0.25rem 0.5rem; font-size: 0.75rem; text-decoration: none;">≡ƒôÄ Unduh</a>`;\n
            }\n
\n
            // Action buttons\n
            let actions = [];\n
            if (item.status === 'SUBMITTED') {\n
                if (canApprove) {\n
                    actions.push(`<button class="btn-primary" style="padding: 0.25rem 0.6rem; font-size: 0.75rem; background: var(--success); border-color: var(--success);" onclick="openApproveOvertimeModal(${item.id}, ${item.requested_minutes || 0})">Γ£ö Setujui</button>`);\n
                    actions.push(`<button class="btn-secondary" style="padding: 0.25rem 0.6rem; font-size: 0.75rem; color: var(--danger); border-color: var(--danger);" onclick="openRejectOvertimeModal(${item.id})">Γ£û Tolak</button>`);\n
                }\n
                actions.push(`<button class="btn-secondary" style="padding: 0.25rem 0.5rem; font-size: 0.75rem;" onclick="cancelOvertimeRequest(${item.id})">Batalkan</button>`);\n
            } else {\n
                actions.push(`<span style="color: var(--text-muted); font-size: 0.75rem;">Selesai</span>`);\n
            }\n
\n
            return `\n
                <tr>\n
                    <td style="font-family: monospace; font-size: 0.8rem;">#${item.id}</td>\n
                    <td><strong>${escapeHtml(empName)}</strong></td>\n
                    <td>${otDate}</td>\n
                    <td><span style="font-size: 0.8rem; font-weight: 600;">${timeRange}</span></td>\n
                    <td>${reqDuration}</td>\n
                    <td>${appDuration}</td>\n
                    <td style="max-width: 220px; font-size: 0.8rem; line-height: 1.2;">\n
                        ${escapeHtml(item.reason || '-')}\n
                        ${item.project_task_reference ? `<div style="color: #6366f1; font-size: 0.75rem; margin-top: 0.2rem;">Ref: ${escapeHtml(item.project_task_reference)}</div>` : ''}\n
                        ${item.rejection_reason ? `<div style="color: var(--danger); font-size: 0.75rem; margin-top: 0.25rem;">Alasan tolak: ${escapeHtml(item.rejection_reason)}</div>` : ''}\n
                    </td>\n
                    <td>${docLink}</td>\n
                    <td>${statusBadge}</td>\n
                    <td><div style="display: flex; gap: 0.35rem; flex-wrap: wrap;">${actions.join('')}</div></td>\n
                </tr>\n
            `;\n
        }).join('');\n
    } catch (err) {\n
        tbody.innerHTML = `<tr><td colspan="10" style="text-align: center; color: var(--danger); padding: 2rem;">Gagal memuat pengajuan lembur: ${escapeHtml(err.message)}</td></tr>`;\n
    }\n
}\n
