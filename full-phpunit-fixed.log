    if (window.APP_CONFIG?.sseEnabled !== false) {\n
        initLiveAccessStream();\n
    }\n
\n
    document.addEventListener('visibilitychange', () => {\n
        if (document.hidden) {\n
            stopRealtime();\n
            return;\n
        }\n
        reconcileLiveData();\n
        if (window.APP_CONFIG?.sseEnabled !== false) initLiveAccessStream();\n
    });\n
    window.addEventListener('pagehide', stopRealtime);\n
});\n
