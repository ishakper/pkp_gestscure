async function loadOnboardingContracts() {\n
    const tbody = document.getElementById('contractsTableBody');\n
    if (!tbody) return;\n
\n
    const search = document.getElementById('onbContractSearch')?.value.trim() || '';\n
    const type = document.getElementById('onbContractTypeFilter')?.value || '';\n
\n
    let url = `/onboarding/contracts?search=${encodeURIComponent(search)}`;\n
    if (type) url += `&contract_type=${encodeURIComponent(type)}`;\n
\n
    try {\n
        const res = await apiFetch(url);\n
        if (res.success && res.data) {\n
            state.onboarding.contracts = res.data;\n
            renderContractsTable(res.data);\n
        }\n
    } catch (err) {\n
        tbody.innerHTML = `<tr><td colspan="8" style="text-align: center; color: #f87171; padding: 2rem;">Gagal memuat kontrak kerja: ${escapeHtml(err.message)}</td></tr>`;\n
    }\n
}\n
\n
function renderContractsTable(contracts) {\n
    const tbody = document.getElementById('contractsTableBody');\n
    if (!tbody) return;\n
\n
    if (!contracts || contracts.length === 0) {\n
        tbody.innerHTML = `<tr><td colspan="8" style="text-align: center; color: var(--text-muted); padding: 2rem;">Belum ada kontrak kerja tersimpan.</td></tr>`;\n
        return;\n
    }\n
\n
    const statusBadge = (s) => {\n
        if (s === 'ACTIVE') return `<span style="background: rgba(16, 185, 129, 0.2); color: #10b981; padding: 0.2rem 0.6rem; border-radius: 999px; font-size: 0.75rem; font-weight: 700;">Γ£ô AKTIF</span>`;\n
        if (s === 'EXPIRED') return `<span style="background: rgba(239, 68, 68, 0.2); color: #ef4444; padding: 0.2rem 0.6rem; border-radius: 999px; font-size: 0.75rem; font-weight: 700;">KADALUARSA</span>`;\n
        if (s === 'PENDING_SIGNATURE') return `<span style="background: rgba(245, 158, 11, 0.2); color: #f59e0b; padding: 0.2rem 0.6rem; border-radius: 999px; font-size: 0.75rem; font-weight: 700;">MENUNGGU TTD</span>`;\n
        return `<span style="background: rgba(148, 163, 184, 0.2); color: #94a3b8; padding: 0.2rem 0.6rem; border-radius: 999px; font-size: 0.75rem; font-weight: 700;">DRAFT</span>`;\n
    };\n
\n
    tbody.innerHTML = contracts.map(c => {\n
        const empName = c.employee?.name || c.internship?.intern_name || '-';\n
        return `\n
            <tr>\n
                <td style="font-weight: 700; color: #38bdf8;">${escapeHtml(c.contract_number)}</td>\n
                <td style="font-weight: 600; color: #fff;">${escapeHtml(empName)}</td>\n
                <td>\n
                    <div style="font-weight: 600; color: #fff;">${escapeHtml(c.title)}</div>\n
                    <div style="font-size: 0.75rem; color: #38bdf8;">${escapeHtml(c.contract_type)}</div>\n
                </td>\n
                <td>\n
                    <div>Mulai: ${escapeHtml(c.start_date)}</div>\n
                    <div style="font-size: 0.75rem; color: var(--text-muted);">${c.end_date ? `Selesai: ${c.end_date}` : 'Tanpa Batas Waktu'}</div>\n
                </td>\n
                <td>\n
                    <div>${escapeHtml(c.signed_by_employee || '-')}</div>\n
                    <div style="font-size: 0.75rem; color: var(--text-muted);">${escapeHtml(c.signed_by_company || '-')}</div>\n
                </td>\n
                <td>${statusBadge(c.status)}</td>\n
                <td><span style="font-size: 0.8rem; font-weight: 600; color: #fbbf24;">${escapeHtml(c.renewal_status)}</span></td>\n
                <td style="text-align: right;">\n
                    <span style="font-size: 0.75rem; color: var(--text-muted);">Tersimpan</span>\n
                </td>\n
            </tr>\n
        `;\n
    }).join('');\n
}\n
