function renderDocumentsTable(docs) {\n
    const tbody = document.getElementById('documentsTableBody');\n
    if (!tbody) return;\n
\n
    if (!docs || docs.length === 0) {\n
        tbody.innerHTML = `<tr><td colspan="8" style="text-align: center; color: var(--text-muted); padding: 2rem;">Belum ada dokumen privat terunggah.</td></tr>`;\n
        return;\n
    }\n
\n
    const statusBadge = (s) => {\n
        if (s === 'VERIFIED') return `<span style="background: rgba(16, 185, 129, 0.2); color: #10b981; padding: 0.2rem 0.6rem; border-radius: 999px; font-size: 0.75rem; font-weight: 700;">Γ£ô TERVERIFIKASI</span>`;\n
        if (s === 'REJECTED') return `<span style="background: rgba(239, 68, 68, 0.2); color: #ef4444; padding: 0.2rem 0.6rem; border-radius: 999px; font-size: 0.75rem; font-weight: 700;">Γ£ò DITOLAK</span>`;\n
        if (s === 'ARCHIVED') return `<span style="background: rgba(148, 163, 184, 0.2); color: #94a3b8; padding: 0.2rem 0.6rem; border-radius: 999px; font-size: 0.75rem; font-weight: 700;">ARSIP (LAMA)</span>`;\n
        return `<span style="background: rgba(245, 158, 11, 0.2); color: #f59e0b; padding: 0.2rem 0.6rem; border-radius: 999px; font-size: 0.75rem; font-weight: 700;">MENUNGGU VERIFIKASI</span>`;\n
    };\n
\n
    const sizeStr = (bytes) => {\n
        if (!bytes) return '0 KB';\n
        return `${Math.round(bytes / 1024)} KB`;\n
    };\n
\n
    tbody.innerHTML = docs.map(d => {\n
        const empName = d.employee?.name || d.internship?.intern_name || '-';\n
        const isHR = (window.APP_CONFIG?.admin?.role === 'super_admin' || window.APP_CONFIG?.admin?.role === 'hrd');\n
\n
        return `\n
            <tr>\n
                <td style="font-weight: 700; color: #38bdf8;">${escapeHtml(d.document_number)}</td>\n
                <td style="font-weight: 600; color: #fff;">${escapeHtml(empName)}</td>\n
                <td>\n
                    <div style="font-weight: 600; color: #fff;">${escapeHtml(d.title)}</div>\n
                    <div style="font-size: 0.75rem; color: #38bdf8;">${escapeHtml(d.category)} - ${escapeHtml(d.file_name)}</div>\n
                </td>\n
                <td>\n
                    <div>v${d.version}</div>\n
                    <div style="font-size: 0.75rem; color: var(--text-muted);">${sizeStr(d.file_size)}</div>\n
                </td>\n
                <td><span style="font-size: 0.75rem; color: var(--text-muted);">${escapeHtml(d.visibility)}</span></td>\n
                <td>${statusBadge(d.status)}</td>\n
                <td>${d.created_at ? d.created_at.split('T')[0] : '-'}</td>\n
                <td style="text-align: right; white-space: nowrap;">\n
                    <button class="btn-secondary" style="padding: 0.35rem 0.65rem; font-size: 0.75rem;" onclick="downloadSecureDocument(${d.id}, '${escapeHtml(d.file_name)}')">\n
                        Γ¼ç∩╕Å Unduh\n
                    </button>\n
                    ${isHR && d.status === 'PENDING_VERIFICATION' ? `\n
                        <button class="btn-primary" style="padding: 0.35rem 0.65rem; font-size: 0.75rem; margin-left: 0.35rem;" onclick="openVerifyDocumentModal(${d.id}, '${escapeHtml(d.title)}')">\n
                            ≡ƒ¢í∩╕Å Verifikasi\n
                        </button>\n
                    ` : ''}\n
                </td>\n
            </tr>\n
        `;\n
    }).join('');\n
}\n
