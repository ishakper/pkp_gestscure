async function loadRecruitmentData() {\n
    await Promise.allSettled([\n
        loadAtsMetrics(),\n
        loadAtsLookups(),\n
    ]);\n
\n
    if (state.ats.activePill === 'pipeline') loadAtsApplications();\n
    else if (state.ats.activePill === 'vacancies') loadAtsVacancies();\n
    else if (state.ats.activePill === 'candidates') loadAtsCandidates();\n
    else if (state.ats.activePill === 'interviews') loadAtsInterviews();\n
}\n
\n
async function loadAtsLookups() {\n
    try {\n
        const [stagesRes, vacanciesRes, candidatesRes] = await Promise.allSettled([\n
            apiFetch('/recruitment/stages'),\n
            apiFetch('/recruitment/vacancies?status=OPEN'),\n
            apiFetch('/recruitment/candidates')\n
        ]);\n
\n
        if (stagesRes.status === 'fulfilled' && stagesRes.value?.status === 'success') {\n
            state.ats.stages = stagesRes.value.data || [];\n
        }\n
        if (vacanciesRes.status === 'fulfilled' && vacanciesRes.value?.status === 'success') {\n
            state.ats.vacancies = vacanciesRes.value.data || [];\n
        }\n
        if (candidatesRes.status === 'fulfilled' && candidatesRes.value?.status === 'success') {\n
            state.ats.candidates = candidatesRes.value.data || [];\n
        }\n
    } catch (err) {\n
        console.warn('ATS lookups error:', err);\n
