function loadAssetsData() {\n
    loadAssetsMetrics();\n
    loadAssetsCategories();\n
    loadAssetsInventory();\n
    loadAssetAssignments();\n
    loadAssetMaintenances();\n
    loadAssetIncidents();\n
    populateAssetDropdowns();\n
