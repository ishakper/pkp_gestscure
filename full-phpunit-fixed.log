async function loadExpiringContracts() {\n
    const tbody = document.getElementById('expiringContractsTableBody');\n
    if (!tbody) return;\n
\n
    try {\n
        const res = await apiFetch('/onboarding/contracts?expiring=true&days=30');\n
        if (res.success && res.data) {\n
            state.onboarding.expiringContracts = res.data;\n
            renderExpiringContractsTable(res.data);\n
        }\n
    } catch (err) {\n
        tbody.innerHTML = `<tr><td colspan="7" style="text-align: center; color: #f87171; padding: 2rem;">Gagal memeriksa masa berlaku: ${escapeHtml(err.message)}</td></tr>`;\n
    }\n
}\n
\n
function renderExpiringContractsTable(contracts) {\n
    const tbody = document.getElementById('expiringContractsTableBody');\n
    if (!tbody) return;\n
\n
    if (!contracts || contracts.length === 0) {\n
        tbody.innerHTML = `<tr><td colspan="7" style="text-align: center; color: #10b981; padding: 2rem;">Γ£ô Aman: Tidak ada kontrak kerja yang akan berakhir dalam 30 hari ke depan.</td></tr>`;\n
        return;\n
    }\n
\n
    tbody.innerHTML = contracts.map(c => {\n
        const empName = c.employee?.name || c.internship?.intern_name || '-';\n
        const diffDays = Math.ceil((new Date(c.end_date) - new Date()) / (1000 * 60 * 60 * 24));\n
\n
        return `\n
            <tr>\n
                <td style="font-weight: 700; color: #f59e0b;">${escapeHtml(c.contract_number)}</td>\n
                <td style="font-weight: 600; color: #fff;">${escapeHtml(empName)}</td>\n
                <td>${escapeHtml(c.contract_type)}</td>\n
                <td>${escapeHtml(c.end_date)}</td>\n
                <td><span style="color: #ef4444; font-weight: 700;">${diffDays} Hari Lagi</span></td>\n
                <td><span style="color: #fbbf24; font-weight: 600;">${escapeHtml(c.renewal_status)}</span></td>\n
                <td style="text-align: right;">\n
                    <button class="btn-primary" style="padding: 0.35rem 0.65rem; font-size: 0.75rem;" onclick="showToast('Silakan perpanjang kontrak melalui pembuatan addendum baru.', 'info')">\n
                        Perpanjang / Evaluasi\n
                    </button>\n
                </td>\n
            </tr>\n
        `;\n
    }).join('');\n
}\n
