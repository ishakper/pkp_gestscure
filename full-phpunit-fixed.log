\n
// Each loader resolves to `false` when its request failed (the table already shows the error).\n
function loadAccessData() {\n
    return Promise.all([\n
        loadAccessMetrics(),\n
        loadAccessRequests(),\n
        loadAccessProfiles(),\n
        loadCredentials(),\n
        loadDeviceSyncs(),\n
        loadEmoneyCards(),\n
        populateAccessEmployees(),\n
    ]);\n
}\n
\n
async function refreshAccessData(button) {\n
    const original = button?.innerHTML || '';\n
    if (button) { button.disabled = true; button.innerHTML = '╬ô├àΓöé Memuat...'; }\n
    try {\n
        const results = await loadAccessData();\n
        const failed = results.filter(ok => ok === false).length;\n
        if (failed > 0) {\n
            showToast(`${failed} dari ${results.length} bagian data gagal dimuat. Periksa pesan di tabel, lalu coba lagi.`, 'warning');\n
        } else {\n
            showToast('Data Hak Akses & Kredensial berhasil dimuat ulang.', 'success');\n
        }\n
    } finally {\n
        if (button) { button.disabled = false; button.innerHTML = original; }\n
    }\n
}\n
\n
function switchAccessSubTab(subTab, btn) {\n
    document.querySelectorAll('#accessTab .ats-subnav .subnav-btn').forEach(b => b.classList.remove('active'));\n
    if (btn) btn.classList.add('active');\n
\n
    const subs = {\n
        'requests': 'accessSubRequests',\n
        'profiles': 'accessSubProfiles',\n
        'credentials': 'accessSubCredentials',\n
        'syncs': 'accessSubSyncs',\n
        'emoney': 'accessSubEmoney'\n
    };\n
\n
    Object.values(subs).forEach(id => {\n
        const el = document.getElementById(id);\n
        if (el) el.style.display = 'none';\n
    });\n
\n
    const activeEl = document.getElementById(subs[subTab]);\n
    if (activeEl) activeEl.style.display = 'block';\n
}\n
\n
async function loadAccessMetrics() {\n
    try {\n
        const res = await apiFetch('/access/metrics');\n
        if (res && res.success) {\n
            const d = res.data;\n
            const elPending = document.getElementById('metricPendingAccessRequests');\n
            const elCred = document.getElementById('metricActiveCredentials');\n
            const elSync = document.getElementById('metricPendingDeviceSyncs');\n
            const elEmn = document.getElementById('metricTotalEmoneyCards');\n
\n
            if (elPending) elPending.innerText = d.pending_requests ?? 0;\n
            if (elCred) elCred.innerText = d.active_credentials ?? 0;\n
            if (elSync) elSync.innerText = d.pending_syncs ?? 0;\n
            if (elEmn) elEmn.innerText = d.total_emoney ?? 0;\n
        }\n
    } catch (e) {\n
        console.error('Failed to load access metrics', e);\n
        return false;\n
    }\n
}\n
\n
async function loadAccessRequests() {\n
    const tbody = document.getElementById('accessRequestsTableBody');\n
    if (!tbody) return;\n
\n
    try {\n
        const search = document.getElementById('accessRequestSearch')?.value || '';\n
        const status = document.getElementById('accessRequestStatusFilter')?.value || '';\n
        const params = new URLSearchParams();\n
        if (search) params.append('search', search);\n
        if (status) params.append('status', status);\n
\n
        const res = await apiFetch(`/access/requests?${params.toString()}`);\n
        if (!res || !res.success || !res.data.length) {\n
            tbody.innerHTML = `<tr><td colspan="7" style="text-align: center; color: var(--text-muted); padding: 2rem;">Belum ada permohonan hak akses yang diajukan.</td></tr>`;\n
            return;\n
        }\n
\n
        tbody.innerHTML = res.data.map(r => {\n
            const empName = r.employee?.name || (r.internship ? `[Intern] ${r.internship.intern_id}` : '-');\n
            const profName = r.access_profile?.name || (r.specific_doors?.length ? `Khusus (${r.specific_doors.join(', ')})` : 'Standar');\n
            const statusBadge = getAccessStatusBadge(r.status);\n
            const validUntil = r.valid_until ? r.valid_until.substring(0, 10) : 'Permanen';\n
            const validRange = `${(r.valid_from || '').substring(0, 10)} s/d ${validUntil}`;\n
\n
            let actions = '';\n
            if (r.status === 'PENDING_APPROVAL') {\n
                actions = `\n
                    <button class="btn-primary" style="padding: 0.35rem 0.65rem; font-size: 0.75rem; background: #10b981; border-color: #059669;" onclick="openApproveRequestModal(${r.id})">Γ£ô Setujui</button>\n
                    <button class="btn-secondary" style="padding: 0.35rem 0.65rem; font-size: 0.75rem; color: #ef4444; border-color: #ef4444;" onclick="openRejectRequestModal(${r.id})">Γ£ò Tolak</button>\n
                `;\n
            } else {\n
                actions = `<span style="font-size: 0.75rem; color: var(--text-muted);">${escapeHtml(r.status)}</span>`;\n
            }\n
\n
            return `\n
                <tr>\n
                    <td style="font-weight: 700; color: #38bdf8;">${escapeHtml(r.request_number)}</td>\n
                    <td style="font-weight: 600; color: #fff;">${escapeHtml(empName)}</td>\n
                    <td>${escapeHtml(profName)}</td>\n
                    <td>${escapeHtml(r.building_name || 'Kantor Pusat')}</td>\n
                    <td style="font-size: 0.8rem; color: var(--text-muted);">${escapeHtml(validRange)}</td>\n
                    <td>${statusBadge}</td>\n
                    <td style="text-align: right; white-space: nowrap;">${actions}</td>\n
                </tr>\n
            `;\n
        }).join('');\n
    } catch (e) {\n
        tbody.innerHTML = `<tr><td colspan="7" style="text-align: center; color: #ef4444; padding: 2rem;">Gagal memuat permohonan akses: ${escapeHtml(e.message)}</td></tr>`;\n
        return false;\n
    }\n
}\n
\n
async function loadAccessProfiles() {\n
    const tbody = document.getElementById('accessProfilesTableBody');\n
    if (!tbody) return;\n
\n
    try {\n
        const search = document.getElementById('accessProfileSearch')?.value || '';\n
        const params = new URLSearchParams();\n
        if (search) params.append('search', search);\n
\n
        const res = await apiFetch(`/access/profiles?${params.toString()}`);\n
        if (!res || !res.success || !res.data.length) {\n
            tbody.innerHTML = `<tr><td colspan="6" style="text-align: center; color: var(--text-muted); padding: 2rem;">Belum ada profil hak akses yang terdaftar.</td></tr>`;\n
            return;\n
        }\n
\n
        tbody.innerHTML = res.data.map(p => {\n
            const doors = (p.allowed_doors && p.allowed_doors.length) ? p.allowed_doors.join(', ') : 'Semua Pintu';\n
            const schedule = `${p.schedule_type} (${p.start_time} - ${p.end_time})`;\n
            const statusBadge = p.is_active ? '<span class="badge" style="background: rgba(16,185,129,0.2); color: #10b981;">AKTIF</span>' : '<span class="badge" style="background: rgba(239,68,68,0.2); color: #ef4444;">NONAKTIF</span>';\n
\n
            return `\n
                <tr>\n
                    <td style="font-weight: 700; color: #fbbf24;">${escapeHtml(p.code)}</td>\n
                    <td style="font-weight: 600; color: #fff;">${escapeHtml(p.name)}</td>\n
                    <td>${escapeHtml(p.building_name || '-')}</td>\n
                    <td style="font-size: 0.8rem;">${escapeHtml(schedule)}</td>\n
                    <td style="font-size: 0.8rem; color: #38bdf8;">${escapeHtml(doors)}</td>\n
                    <td>${statusBadge}</td>\n
                </tr>\n
            `;\n
        }).join('');\n
    } catch (e) {\n
        tbody.innerHTML = `<tr><td colspan="6" style="text-align: center; color: #ef4444; padding: 2rem;">Gagal memuat profil: ${escapeHtml(e.message)}</td></tr>`;\n
        return false;\n
    }\n
}\n
