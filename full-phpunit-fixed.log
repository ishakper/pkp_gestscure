// Setup Gedung & Facility Hierarchy Manager\n
// = = = = =\n
async function loadBuildingHierarchy() {\n
    const container = document.getElementById('buildingHierarchyContainer');\n
    if (!container) return;\n
\n
    container.innerHTML = `<div class="table-container" style="padding: 2.5rem; text-align: center;"><div class="spinner"></div> Memuat hierarki gedung dan perangkat pintu...</div>`;\n
\n
    try {\n
        const [bldRes, doorRes] = await Promise.all([\n
            apiFetch('/admin/buildings'),\n
            apiFetch('/admin/doors')\n
        ]);\n
\n
        const buildings = (bldRes.status === 'success' && Array.isArray(bldRes.data)) ? bldRes.data : [];\n
        const doors = (doorRes.status === 'success' && Array.isArray(doorRes.data)) ? doorRes.data : [];\n
\n
        if (buildings.length === 0 && doors.length === 0) {\n
            const canManageOrganization = (window.APP_CONFIG?.permissions || []).includes('organization.manage');\n
            container.innerHTML = `\n
                <div class="table-container" style="padding: 3rem 2rem; text-align: center; background: var(--card-bg); border: 1px solid var(--border-color); border-radius: 1rem;">\n
                    <div style="font-size: 3rem; margin-bottom: 0.75rem;">≡ƒÅó</div>\n
                    <h3 style="color: var(--text-main); margin-bottom: 0.5rem;">Belum Ada Master Gedung Registered</h3>\n
                    <p style="color: var(--text-muted); font-size: 0.875rem; margin-bottom: 1.25rem;">Belum ada hierarki gedung tersimpan di database.</p>\n
                    ${canManageOrganization ? '<button class="btn-primary" onclick="openAddBuildingModal()">+ Tambah Gedung Pertama</button>' : ''}\n
                </div>\n
            `;\n
            return;\n
        }\n
\n
        const doorsByBuilding = {};\n
        doors.forEach(d => {\n
            const bKey = d.building_id || d.location || 'UNASSIGNED';\n
            if (!doorsByBuilding[bKey]) doorsByBuilding[bKey] = [];\n
            doorsByBuilding[bKey].push(d);\n
        });\n
\n
        let html = '';\n
\n
        buildings.forEach(bld => {\n
            const bldDoors = doorsByBuilding[bld.id] || doorsByBuilding[bld.name] || doors.filter(d => d.building_id === bld.id || d.location === bld.name);\n
            const zones = Array.isArray(bld.zones) ? bld.zones : [];\n
\n
            html += `\n
                <div style="margin-bottom: 2rem; background: var(--card-bg); border: 1px solid var(--border-color); border-radius: 1rem; padding: 1.5rem; transition: border-color 0.2s ease;">\n
                    <!-- LEVEL 1: BUILDING HEADER -->\n
                    <div style="display: flex; justify-content: space-between; align-items: flex-start; border-bottom: 1px solid var(--border-color); padding-bottom: 1rem; margin-bottom: 1.25rem; flex-wrap: wrap; gap: 0.75rem;">\n
                        <div>\n
                            <div style="display: flex; align-items: center; gap: 0.65rem; margin-bottom: 0.25rem;">\n
                                <span style="font-size: 1.35rem;">≡ƒÅó</span>\n
                                <h3 style="font-size: 1.25rem; font-weight: 700; color: #ffffff; margin: 0;">${escapeHtml(bld.name)}</h3>\n
                                <span class="badge badge-neutral" style="font-size: 0.75rem;">Kode: ${escapeHtml(bld.code || 'BLD')}</span>\n
                                ${bld.is_active ? '<span class="badge badge-granted">Aktif</span>' : '<span class="badge badge-dim">Non-Aktif</span>'}\n
                            </div>\n
                            <div style="font-size: 0.85rem; color: var(--text-muted); margin-left: 2rem;">\n
                                ${escapeHtml(bld.description || 'Gedung fasilitas operasional PKP SecureGate')}\n
                            </div>\n
                        </div>\n
                        <div style="display: flex; gap: 0.5rem; align-items: center;">\n
                            <span class="badge badge-info">${zones.length} Zona</span>\n
                            <span class="badge badge-success">${bldDoors.length} Perangkat Pintu</span>\n
                        </div>\n
                    </div>\n
\n
                    <!-- LEVEL 2: ZONES -->\n
                    <div style="display: flex; flex-direction: column; gap: 1rem; margin-left: 1rem; padding-left: 1.25rem; border-left: 2px solid rgba(56, 189, 248, 0.3);">\n
                        ${zones.length > 0 ? zones.map(z => {\n
                            const zDoors = bldDoors.filter(d => d.zone_id === z.id);\n
                            return renderZoneBlock(z, zDoors);\n
                        }).join('') + renderDefaultZoneBlock(bldDoors.filter(d => !d.zone_id)) : renderDefaultZoneBlock(bldDoors)}\n
                    </div>\n
                </div>\n
            `;\n
        });\n
\n
        container.innerHTML = html;\n
    } catch (err) {\n
        container.innerHTML = `<div class="table-container" style="padding: 2rem; color: var(--danger); text-align: center;">Gagal memuat hierarki gedung: ${escapeHtml(err.message)}</div>`;\n
    }\n
}\n
\n
function renderZoneBlock(zone, zoneDoors) {\n
    return `\n
        <div style="background: rgba(15, 23, 42, 0.6); border: 1px solid rgba(255, 255, 255, 0.06); border-radius: 0.75rem; padding: 1rem 1.25rem;">\n
            <div style="display: flex; align-items: center; justify-content: space-between; margin-bottom: 0.75rem;">\n
                <div style="display: flex; align-items: center; gap: 0.5rem;">\n
                    <span style="font-size: 1rem;">≡ƒôì</span>\n
                    <strong style="font-size: 0.9rem; color: #f8fafc;">${escapeHtml(zone.name)}</strong>\n
                    <span class="badge badge-dim" style="font-size: 0.65rem;">${escapeHtml(zone.code)}</span>\n
                </div>\n
                <span class="badge badge-neutral" style="font-size: 0.7rem;">${zoneDoors.length} Terminal</span>\n
            </div>\n
\n
            <!-- LEVEL 4: DEVICES / DOORS -->\n
            <div style="display: grid; grid-template-columns: repeat(auto-fill, minmax(280px, 1fr)); gap: 0.75rem; margin-top: 0.5rem;">\n
                ${zoneDoors.length > 0 ? zoneDoors.map(d => renderDoorDeviceChip(d)).join('') : '<div style="font-size: 0.8rem; color: var(--text-dim); font-style: italic;">Belum ada perangkat pintu dialokasikan pada zona ini.</div>'}\n
            </div>\n
        </div>\n
    `;\n
}\n
\n
function renderDefaultZoneBlock(doors) {\n
    return `\n
        <div style="background: rgba(15, 23, 42, 0.6); border: 1px solid rgba(255, 255, 255, 0.06); border-radius: 0.75rem; padding: 1rem 1.25rem;">\n
            <div style="display: flex; align-items: center; justify-content: space-between; margin-bottom: 0.75rem;">\n
                <div style="display: flex; align-items: center; gap: 0.5rem;">\n
                    <span style="font-size: 1rem;">≡ƒôì</span>\n
                    <strong style="font-size: 0.9rem; color: #f8fafc;">Zona Akses Pintu Standar</strong>\n
                    <span class="badge badge-dim" style="font-size: 0.65rem;">ZN-DEFAULT</span>\n
                </div>\n
                <span class="badge badge-neutral" style="font-size: 0.7rem;">${doors.length} Terminal</span>\n
            </div>\n
\n
            <!-- LEVEL 4: DEVICES / DOORS -->\n
            <div style="display: grid; grid-template-columns: repeat(auto-fill, minmax(280px, 1fr)); gap: 0.75rem; margin-top: 0.5rem;">\n
                ${doors.length > 0 ? doors.map(d => renderDoorDeviceChip(d)).join('') : '<div style="font-size: 0.8rem; color: var(--text-dim); font-style: italic;">Belum ada perangkat pintu dialokasikan.</div>'}\n
            </div>\n
        </div>\n
    `;\n
}\n
\n
function renderDoorDeviceChip(door) {\n
    const isOnline = (door.connection_status === 'online' || door.status === 'online');\n
\n
    return `\n
        <div style="background: rgba(30, 41, 59, 0.8); border: 1px solid ${isOnline ? 'rgba(16, 185, 129, 0.3)' : 'var(--border-color)'}; border-radius: 0.5rem; padding: 0.75rem; display: flex; flex-direction: column; gap: 0.35rem;">\n
            <div style="display: flex; justify-content: space-between; align-items: center;">\n
                <div style="font-size: 0.85rem; font-weight: 700; color: #ffffff; display: flex; align-items: center; gap: 0.35rem;">\n
                    ≡ƒÜ¬ ${escapeHtml(door.door_name || door.name || door.door_id)}\n
                </div>\n
                ${isOnline ? '<span class="badge badge-granted" style="font-size: 0.65rem;">ONLINE</span>' : '<span class="badge badge-denied" style="font-size: 0.65rem;">OFFLINE</span>'}\n
            </div>\n
            <div style="font-size: 0.75rem; color: var(--text-muted); display: flex; flex-direction: column; gap: 0.15rem;">\n
                <div>≡ƒåö Code: <code>${escapeHtml(door.door_id)}</code></div>\n
                <div>≡ƒîÉ IP: <code>${escapeHtml(door.device_ip || door.ip_address || '-')}</code></div>\n
                <div>≡ƒôá Hardware: ${escapeHtml(door.device_model || door.model || '-')}</div>\n
            </div>\n
        </div>\n
    `;\n
}\n
