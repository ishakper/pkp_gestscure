// Employee CRUD Modals\n
// = = = = =\n
function openAddEmployeeModal() {\n
    document.getElementById('employeeModalTitle').innerText = 'Tambah Karyawan Baru';\n
    document.getElementById('empDbId').value = '';\n
    document.getElementById('empUserId').value = 'USR-' + Math.floor(1000 + Math.random() * 9000);\n
    document.getElementById('empNik').value = 'NIK-' + Math.floor(882000 + Math.random() * 999);\n
    document.getElementById('empName').value = '';\n
    document.getElementById('empCardNo').value = 'CARD-' + Math.floor(100000 + Math.random() * 900000);\n
    document.getElementById('empRole').value = 'Staff';\n
    ['empEmail','empPhone','empBuilding','empDivision','empPosition','empEmploymentType','empHireDate'].forEach(id => document.getElementById(id).value = '');\n
    document.getElementById('empEmploymentStatus').value = 'ACTIVE';\n
    document.getElementById('empFp').checked = true;\n
    document.getElementById('empCard').checked = true;\n
    document.getElementById('employeeModal').classList.add('active');\n
}\n
\n
function openEditEmployeeModal(empId) {\n
    const emp = state.employees.find(e => e.id === empId || e.id == empId);\n
    if (!emp) return;\n
\n
    document.getElementById('employeeModalTitle').innerText = 'Edit Data Karyawan';\n
    document.getElementById('empDbId').value = emp.id;\n
    document.getElementById('empUserId').value = emp.user_id;\n
    document.getElementById('empNik').value = emp.nik;\n
    document.getElementById('empName').value = emp.name;\n
    document.getElementById('empCardNo').value = '';\n
    document.getElementById('empCardNo').placeholder = emp.card_registered === 'YES' ? 'Kartu terdaftar; isi hanya untuk mengganti' : 'Nomor kartu baru';\n
    document.getElementById('empDept').value = emp.department;\n
    document.getElementById('empRole').value = emp.role || emp.role_jabatan || 'Staff';\n
    document.getElementById('empEmail').value = emp.email || ''; document.getElementById('empPhone').value = emp.phone || '';\n
    document.getElementById('empBuilding').value = emp.building?.id || ''; document.getElementById('empDivision').value = emp.division?.id || ''; document.getElementById('empPosition').value = emp.position?.id || '';\n
    document.getElementById('empEmploymentType').value = emp.employment_type || ''; document.getElementById('empEmploymentStatus').value = emp.employment_status || 'ACTIVE'; document.getElementById('empHireDate').value = emp.hire_date || '';\n
    document.getElementById('empFp').checked = Boolean(emp.biometric_status?.fingerprint_enrolled);\n
    document.getElementById('empCard').checked = Boolean(emp.biometric_status?.card_enrolled);\n
    document.getElementById('employeeModal').classList.add('active');\n
}\n
\n
async function saveEmployee(e) {\n
    e.preventDefault();\n
    const id = document.getElementById('empDbId').value;\n
    const rawCardInput = document.getElementById('empCardNo').value.trim();\n
    const payload = {\n
        employee_id: document.getElementById('empUserId').value,\n
        nik: document.getElementById('empNik').value,\n
        name: document.getElementById('empName').value,\n
        email: document.getElementById('empEmail').value, phone: document.getElementById('empPhone').value,\n
        building_id: document.getElementById('empBuilding').value || null, division_id: document.getElementById('empDivision').value || null, position_id: document.getElementById('empPosition').value || null,\n
        employment_type: document.getElementById('empEmploymentType').value || null, employment_status: document.getElementById('empEmploymentStatus').value, hire_date: document.getElementById('empHireDate').value || null,\n
        department: document.getElementById('empDept').value,\n
        role_jabatan: document.getElementById('empRole').value,\n
        fingerprint_enrolled: document.getElementById('empFp').checked,\n
        card_enrolled: document.getElementById('empCard').checked,\n
    };\n
\n
    if (rawCardInput !== '') {\n
        payload.card_no = rawCardInput;\n
    }\n
\n
    const method = id ? 'PUT' : 'POST';\n
    const endpoint = id ? `/user-management/employees/${id}` : '/user-management/employees';\n
\n
    try {\n
        const res = await apiFetch(endpoint, { method, body: JSON.stringify(payload) });\n
        if (res.status === 'success') {\n
            showToast(id ? 'Data karyawan berhasil diperbarui!' : 'Karyawan baru berhasil ditambahkan!', 'success');\n
            closeModal('employeeModal');\n
            await loadEmployees();\n
        }\n
    } catch (err) {\n
        showToast(`Gagal menyimpan data karyawan: ${err.message}`, 'error');\n
    }\n
}\n
\n
async function deleteEmployee(id, name) {\n
    if (!confirm(`Apakah Anda yakin ingin menghapus data karyawan "${name}"?`)) return;\n
\n
    try {\n
        const res = await apiFetch(`/user-management/employees/${id}`, { method: 'DELETE' });\n
        if (res.status === 'success') {\n
            showToast(`Karyawan "${name}" berhasil dinonaktifkan (Soft Deleted).`, 'success');\n
            await loadEmployees();\n
        }\n
    } catch (err) {\n
        showToast(`Gagal menghapus karyawan: ${err.message}`, 'error');\n
    }\n
}\n
