// Sub-Tab 1: Daftar Pemagang\n
async function loadInternships() {\n
    const tbody = document.getElementById('internsTableBody');\n
    if (!tbody) return;\n
\n
    const search = document.getElementById('searchInternships')?.value.trim() || '';\n
    const status = document.getElementById('filterInternshipStatus')?.value || '';\n
\n
    tbody.innerHTML = `<tr><td colspan="8" class="loading-td"><div class="spinner"></div> Memuat daftar pemagang...</td></tr>`;\n
\n
    try {\n
        let url = '/internships';\n
        const params = [];\n
        if (search) params.push(`search=${encodeURIComponent(search)}`);\n
        if (status) params.push(`status=${encodeURIComponent(status)}`);\n
        if (params.length > 0) url += `?${params.join('&')}`;\n
\n
        const res = await apiFetch(url);\n
        if (res.status !== 'success' || !Array.isArray(res.data) || res.data.length === 0) {\n
            tbody.innerHTML = `<tr><td colspan="8" class="empty-td">Tidak ada data pemagang ditemukan. Klik "+ Tambah Pemagang" atau konversi dari pelamar.</td></tr>`;\n
            return;\n
        }\n
\n
        state.internship.internships = res.data;\n
\n
        tbody.innerHTML = res.data.map(intn => {\n
            const emp = intn.employee || {};\n
            const mentor = intn.mentor || {};\n
            const internName = emp.name || intn.candidate?.full_name || 'Pemagang';\n
            const statusClass = intn.status === 'ACTIVE' ? 'badge-active' : (intn.status === 'COMPLETED' ? 'badge-info' : 'badge-danger');\n
\n
            return `\n
                <tr>\n
                    <td>\n
                        <span style="font-family: monospace; font-weight: 700; color: var(--primary);">${escapeHtml(intn.intern_id)}</span>\n
                    </td>\n
                    <td>\n
                        <div style="font-weight: 600; color: #ffffff;">${escapeHtml(internName)}</div>\n
                        <div style="font-size: 0.775rem; color: var(--text-muted);">${escapeHtml(emp.email || intn.candidate?.email || '-')} ${emp.phone ? 'ΓÇó ' + escapeHtml(emp.phone) : ''}</div>\n
                    </td>\n
                    <td>\n
                        <div style="font-weight: 600; color: #e2e8f0;">${escapeHtml(intn.institution)}</div>\n
                        <div style="font-size: 0.775rem; color: var(--text-muted);">${escapeHtml(intn.major)} (${escapeHtml(intn.education_level || 'S1')})</div>\n
                    </td>\n
                    <td>\n
                        <div style="color: #cbd5e1;">${escapeHtml(intn.position_title || 'Intern')}</div>\n
                        <div style="font-size: 0.775rem; color: var(--text-muted);">${escapeHtml(intn.division?.name || 'Seluruh Divisi')}</div>\n
                    </td>\n
                    <td>\n
                        <div style="color: #a5b4fc; font-weight: 600;">${escapeHtml(mentor.name || 'Belum Ditugaskan')}</div>\n
                        <div style="font-size: 0.775rem; color: var(--text-muted);">${escapeHtml(mentor.role || '')}</div>\n
                    </td>\n
                    <td style="font-size: 0.8rem; color: var(--text-muted);">\n
                        ${escapeHtml(intn.start_date || '')} s/d ${escapeHtml(intn.end_date || '')}\n
                    </td>\n
                    <td>\n
                        <span class="badge ${statusClass}">${escapeHtml(intn.status)}</span>\n
                    </td>\n
                    <td style="text-align: right;">\n
                        <div style="display: flex; gap: 0.4rem; justify-content: flex-end; flex-wrap: wrap;">\n
                            <button class="btn-action" title="Catat Aktivitas Harian" onclick="openLogActivityModal(${intn.id}, '${escapeHtml(internName)}')">\n
                                ≡ƒô¥ Log\n
                            </button>\n
                            <button class="btn-action" title="Ajukan Laporan Magang" onclick="openSubmitReportModal(${intn.id}, '${escapeHtml(internName)}')">\n
                                ≡ƒôæ Laporan\n
                            </button>\n
                            <button class="btn-action" title="Lembar Evaluasi" onclick="openSubmitEvaluationModal(${intn.id}, '${escapeHtml(internName)}')">\n
                                Γ¡É Nilai\n
                            </button>\n
                            ${intn.status === 'ACTIVE' ? `\n
                            <button class="btn-action" style="background: rgba(16, 185, 129, 0.2); color: #34d399; border-color: rgba(16, 185, 129, 0.4);" title="Selesaikan Magang & Cetak Sertifikat" onclick="openCompleteInternshipModal(${intn.id}, '${escapeHtml(internName)}')">\n
                                Γ£ô Lulus\n
                            </button>\n
                            ` : ''}\n
                        </div>\n
                    </td>\n
                </tr>\n
            `;\n
        }).join('');\n
    } catch (err) {\n
        tbody.innerHTML = `<tr><td colspan="8" class="error-td">Gagal memuat pemagang: ${escapeHtml(err.message)}</td></tr>`;\n
    }\n
}\n
\n
// Sub-Tab 2: Logbook Aktivitas Harian\n
async function loadInternActivities() {\n
    const tbody = document.getElementById('internActivitiesTableBody');\n
    if (!tbody) return;\n
\n
    tbody.innerHTML = `<tr><td colspan="8" class="loading-td"><div class="spinner"></div> Memuat aktivitas harian...</td></tr>`;\n
\n
    try {\n
        if (!state.internship.internships.length) {\n
            const resInt = await apiFetch('/internships');\n
            if (resInt.status === 'success') state.internship.internships = resInt.data || [];\n
        }\n
\n
        const allActivities = [];\n
        for (const intn of state.internship.internships.slice(0, 10)) {\n
            const actRes = await apiFetch(`/internships/${intn.id}/activities`);\n
            if (actRes.status === 'success' && Array.isArray(actRes.data)) {\n
                actRes.data.forEach(a => {\n
                    a.intern_name = intn.employee?.name || intn.candidate?.full_name || intn.intern_id;\n
                    allActivities.push(a);\n
                });\n
            }\n
        }\n
\n
        if (allActivities.length === 0) {\n
            tbody.innerHTML = `<tr><td colspan="8" class="empty-td">Belum ada aktivitas harian yang dicatat. Klik "+ Catat Aktivitas Harian".</td></tr>`;\n
            return;\n
        }\n
\n
        tbody.innerHTML = allActivities.map(act => {\n
            const statusClass = act.status === 'REVIEWED' ? 'badge-active' : (act.status === 'REJECTED' ? 'badge-danger' : 'badge-warning');\n
\n
            return `\n
                <tr>\n
                    <td>\n
                        <div style="font-weight: 600; color: #ffffff;">${escapeHtml(act.activity_date)}</div>\n
                        <div style="font-size: 0.775rem; color: var(--text-muted);">${escapeHtml(act.start_time || '08:30')} - ${escapeHtml(act.end_time || '17:00')}</div>\n
                    </td>\n
                    <td>\n
                        <div style="font-weight: 600; color: #a5b4fc;">${escapeHtml(act.intern_name)}</div>\n
                    </td>\n
                    <td>\n
                        <div style="font-weight: 700; color: #ffffff;">${escapeHtml(act.title)}</div>\n
                        <div style="font-size: 0.8rem; color: #cbd5e1; margin-top: 2px;">${escapeHtml(act.description)}</div>\n
                    </td>\n
                    <td>\n
                        <span style="font-size: 0.8rem; color: var(--text-muted);">${escapeHtml(act.project_task_ref || '-')}</span>\n
                    </td>\n
                    <td style="text-align: center; font-weight: 700; color: #38bdf8;">\n
                        ${act.progress_percent}%\n
                    </td>\n
                    <td>\n
                        <span class="badge ${statusClass}">${escapeHtml(act.status)}</span>\n
                    </td>\n
                    <td>\n
                        <div style="font-size: 0.8rem; color: var(--text-muted);">${escapeHtml(act.mentor_notes || 'Belum diverifikasi')}</div>\n
                    </td>\n
                    <td style="text-align: right;">\n
                        ${act.status === 'SUBMITTED' ? `\n
                            <button class="btn-action" style="background: rgba(99, 102, 241, 0.2); color: #a5b4fc; border-color: rgba(99, 102, 241, 0.4);" onclick="openReviewActivityModal(${act.id})">\n
                                ≡ƒöì Verifikasi\n
                            </button>\n
                        ` : ''}\n
                    </td>\n
                </tr>\n
            `;\n
        }).join('');\n
    } catch (err) {\n
        tbody.innerHTML = `<tr><td colspan="8" class="error-td">Gagal memuat aktivitas: ${escapeHtml(err.message)}</td></tr>`;\n
    }\n
}\n
