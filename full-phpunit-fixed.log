\n
    if (!contracts || contracts.length === 0) {\n
        tbody.innerHTML = `<tr><td colspan="8" style="text-align: center; color: var(--text-muted); padding: 2rem;">Belum ada kontrak kerja tersimpan.</td></tr>`;\n
