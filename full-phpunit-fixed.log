function openAddVacancyModal() {\n
    const divSelect = document.getElementById('vacDivisionId');\n
    const bldSelect = document.getElementById('vacBuildingId');\n
\n
    if (divSelect && state.organization?.divisions) {\n
        divSelect.innerHTML = '<option value="">Pilih Divisi</option>' +\n
            state.organization.divisions.map(d => `<option value="${d.id}">${escapeHtml(d.name)}</option>`).join('');\n
    }\n
    if (bldSelect && state.organization?.buildings) {\n
        bldSelect.innerHTML = '<option value="">Pilih Gedung</option>' +\n
            state.organization.buildings.map(b => `<option value="${b.id}">${escapeHtml(b.name)}</option>`).join('');\n
    }\n
\n
    const modal = document.getElementById('modalAddVacancy');\n
    if (modal) modal.classList.add('active');\n
}\n
