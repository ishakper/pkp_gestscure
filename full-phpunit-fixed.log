function openNewOvertimeRequestModal() {\n
    const modal = document.getElementById('newOvertimeRequestModal');\n
    if (!modal) return;\n
    const form = document.getElementById('newOvertimeRequestForm');\n
    if (form) form.reset();\n
\n
    const dateInput = document.getElementById('newOtDate');\n
    if (dateInput) {\n
        dateInput.value = new Date().toISOString().substring(0, 10);\n
    }\n
    openModal('newOvertimeRequestModal');\n
}\n
\n
async function submitNewOvertimeRequest(e) {\n
    e.preventDefault();\n
    const btn = document.getElementById('btnSubmitNewOt');\n
    const origText = btn ? btn.innerText : '';\n
    if (btn) { btn.disabled = true; btn.innerText = 'Mengirim...'; }\n
\n
    const formData = new FormData();\n
    formData.append('overtime_date', document.getElementById('newOtDate').value);\n
    formData.append('requested_start', document.getElementById('newOtStartTime').value);\n
    formData.append('requested_end', document.getElementById('newOtEndTime').value);\n
    formData.append('reason', document.getElementById('newOtReason').value);\n
\n
    const refVal = document.getElementById('newOtTaskRef').value;\n
    if (refVal) formData.append('project_task_reference', refVal);\n
\n
    const attInput = document.getElementById('newOtAttachment');\n
    if (attInput && attInput.files && attInput.files[0]) {\n
        formData.append('attachment', attInput.files[0]);\n
    }\n
\n
    try {\n
        const res = await apiFetchForm('/overtime-requests', formData);\n
        if (res.success) {\n
            showToast(res.message || 'Pengajuan lembur berhasil dibuat.', 'success');\n
            closeModal('newOvertimeRequestModal');\n
            await loadOvertimeRequestsData();\n
        }\n
    } catch (err) {\n
        showToast('Gagal mengajukan lembur: ' + err.message, 'error');\n
    } finally {\n
        if (btn) { btn.disabled = false; btn.innerText = origText; }\n
    }\n
}\n
\n
function openApproveOvertimeModal(id, requestedMinutes) {\n
    const modal = document.getElementById('approveOvertimeModal');\n
    if (!modal) return;\n
    document.getElementById('approveOtId').value = id;\n
    document.getElementById('approveOtRequestedMinutes').value = requestedMinutes;\n
    document.getElementById('approveOtMinutesInput').value = requestedMinutes;\n
    document.getElementById('approveOtMinutesInput').max = requestedMinutes;\n
    openModal('approveOvertimeModal');\n
}\n
\n
async function submitApproveOvertime(e) {\n
    e.preventDefault();\n
    const id = document.getElementById('approveOtId').value;\n
    const minutes = parseInt(document.getElementById('approveOtMinutesInput').value, 10);\n
    const btn = document.getElementById('btnSubmitApproveOt');\n
\n
    if (!minutes || minutes <= 0) {\n
        showToast('Durasi lembur harus lebih dari 0 menit.', 'warning');\n
        return;\n
    }\n
\n
    const origText = btn ? btn.innerText : '';\n
    if (btn) { btn.disabled = true; btn.innerText = 'Memproses...'; }\n
\n
    try {\n
        const res = await apiFetch(`/overtime-requests/${id}/approve`, {\n
            method: 'POST',\n
            body: JSON.stringify({ approved_minutes: minutes })\n
        });\n
        if (res.success) {\n
            showToast(res.message || 'Pengajuan lembur berhasil disetujui.', 'success');\n
            closeModal('approveOvertimeModal');\n
            await loadOvertimeRequestsData();\n
        }\n
    } catch (err) {\n
        showToast('Gagal menyetujui lembur: ' + err.message, 'error');\n
    } finally {\n
        if (btn) { btn.disabled = false; btn.innerText = origText; }\n
    }\n
}\n
