// Sub-Tab 3: Talent Pool Kandidat\n
async function loadAtsCandidates() {\n
    const tbody = document.getElementById('atsCandidatesTableBody');\n
    if (!tbody) return;\n
\n
    const search = document.getElementById('searchAtsCandidates')?.value.trim() || '';\n
\n
    tbody.innerHTML = `<tr><td colspan="7" class="loading-td"><div class="spinner"></div> Memuat database kandidat...</td></tr>`;\n
\n
    try {\n
        let url = '/recruitment/candidates';\n
        if (search) url += `?search=${encodeURIComponent(search)}`;\n
\n
        const res = await apiFetch(url);\n
        if (res.status !== 'success' || !Array.isArray(res.data) || res.data.length === 0) {\n
            tbody.innerHTML = `<tr><td colspan="7" class="empty-td">Belum ada profil kandidat. Klik "+ Tambah Kandidat" untuk mendaftarkan talenta baru.</td></tr>`;\n
            return;\n
        }\n
\n
        tbody.innerHTML = res.data.map(c => {\n
            const fullName = `${c.first_name || ''} ${c.last_name || ''}`.trim();\n
            return `\n
                <tr>\n
                    <td>\n
                        <span style="font-family: monospace; font-weight: 700; color: var(--primary);">${escapeHtml(c.candidate_number)}</span>\n
                    </td>\n
                    <td>\n
                        <div style="font-weight: 600; color: #ffffff;">${escapeHtml(fullName)}</div>\n
                        <div style="font-size: 0.775rem; color: var(--text-muted);">${c.national_id ? 'NIK: ' + escapeHtml(c.national_id) : ''}</div>\n
                    </td>\n
                    <td>\n
                        <div style="color: #cbd5e1;">${escapeHtml(c.email || '-')}</div>\n
                        <div style="font-size: 0.775rem; color: var(--text-muted);">${escapeHtml(c.phone || '-')}</div>\n
                    </td>\n
                    <td>\n
                        <div style="color: #e2e8f0;">${escapeHtml(c.current_position || 'Belum Tercatat')}</div>\n
                        <div style="font-size: 0.775rem; color: var(--text-muted);">${escapeHtml(c.current_company || '-')}</div>\n
                    </td>\n
                    <td>\n
                        <span class="badge" style="background: rgba(148, 163, 184, 0.2); color: #cbd5e1;">\n
                            ${escapeHtml(c.source || 'CAREER_SITE')}\n
                        </span>\n
                    </td>\n
                    <td>\n
                        <span class="badge ${c.status === 'HIRED' ? 'badge-active' : (c.status === 'BLACKLISTED' ? 'badge-danger' : 'badge-info')}">\n
                            ${escapeHtml(c.status || 'ACTIVE')}\n
                        </span>\n
                    </td>\n
                    <td style="text-align: right;">\n
                        <button class="btn-action" onclick="openApplyModal(${c.id})" title="Daftarkan lamaran untuk kandidat ini">\n
                            ≡ƒô¥ Lamar Lowongan\n
                        </button>\n
                    </td>\n
                </tr>\n
            `;\n
        }).join('');\n
    } catch (err) {\n
        tbody.innerHTML = `<tr><td colspan="7" class="error-td">Gagal memuat kandidat: ${escapeHtml(err.message)}</td></tr>`;\n
    }\n
}\n
\n
// Sub-Tab 4: Jadwal Interview\n
async function loadAtsInterviews() {\n
    const tbody = document.getElementById('atsInterviewsTableBody');\n
    if (!tbody) return;\n
\n
    tbody.innerHTML = `<tr><td colspan="8" class="loading-td"><div class="spinner"></div> Memuat jadwal interview...</td></tr>`;\n
\n
    try {\n
        const res = await apiFetch('/recruitment/interviews');\n
        if (res.status !== 'success' || !Array.isArray(res.data) || res.data.length === 0) {\n
            tbody.innerHTML = `<tr><td colspan="8" class="empty-td">Belum ada sesi wawancara yang dijadwalkan.</td></tr>`;\n
            return;\n
        }\n
\n
        tbody.innerHTML = res.data.map(inv => {\n
            const app = inv.application || {};\n
            const cand = app.candidate || {};\n
            const candName = `${cand.first_name || ''} ${cand.last_name || ''}`.trim() || 'Kandidat';\n
            const statusClass = inv.status === 'COMPLETED' ? 'badge-active' : (inv.status === 'CANCELLED' ? 'badge-danger' : 'badge-warning');\n
\n
            const isLink = inv.location && (inv.location.startsWith('http://') || inv.location.startsWith('https://'));\n
\n
            return `\n
                <tr>\n
                    <td>\n
                        <div style="font-weight: 600; color: #ffffff;">${escapeHtml(candName)}</div>\n
                        <div style="font-size: 0.775rem; color: var(--primary); font-family: monospace;">${escapeHtml(app.application_number || '-')}</div>\n
                    </td>\n
                    <td>\n
                        <span class="badge" style="background: rgba(245, 158, 11, 0.2); color: #fbbf24; font-weight: 600;">\n
                            ${escapeHtml(inv.stage_code)}\n
                        </span>\n
                    </td>\n
                    <td>\n
                        <div style="color: #cbd5e1;">${escapeHtml(inv.interviewer_name || '-')}</div>\n
                    </td>\n
                    <td>\n
                        <div style="color: #e2e8f0; font-weight: 600;">${formatDateTime(inv.scheduled_at)}</div>\n
                        <div style="font-size: 0.775rem; color: var(--text-muted);">${inv.duration_minutes} Menit</div>\n
                    </td>\n
                    <td>\n
                        ${isLink ? `<a href="${escapeHtml(inv.location)}" target="_blank" style="color: var(--primary); text-decoration: underline;">Tautan Meeting Γåù</a>` : `<span style="color: #cbd5e1;">${escapeHtml(inv.location || '-')}</span>`}\n
                    </td>\n
                    <td>\n
                        <span class="badge ${statusClass}">${escapeHtml(inv.status)}</span>\n
                    </td>\n
                    <td>\n
                        ${inv.result ? `\n
                            <div style="font-weight: 700; color: ${inv.result === 'PROCEED' ? '#10b981' : (inv.result === 'REJECT' ? '#ef4444' : '#f59e0b')}">${escapeHtml(inv.result)}</div>\n
                            <div style="font-size: 0.775rem; color: var(--text-muted);">Skor: ${inv.score ?? '-'}/100</div>\n
                        ` : '<span style="color: var(--text-muted); font-size: 0.8rem;">Menunggu Evaluasi</span>'}\n
                    </td>\n
                    <td style="text-align: right;">\n
                        ${inv.status === 'SCHEDULED' ? `\n
                            <button class="btn-action" style="background: rgba(99, 102, 241, 0.2); color: #a5b4fc; border-color: rgba(99, 102, 241, 0.4);" onclick="openInterviewFeedbackModal(${inv.id})">\n
                                Γ£ì∩╕Å Nilai\n
                            </button>\n
                        ` : ''}\n
                    </td>\n
                </tr>\n
            `;\n
        }).join('');\n
    } catch (err) {\n
        tbody.innerHTML = `<tr><td colspan="8" class="error-td">Gagal memuat interview: ${escapeHtml(err.message)}</td></tr>`;\n
    }\n
}\n
