async function loadOnboardingMetrics() {\n
    try {\n
        const res = await apiFetch('/onboarding/metrics');\n
        if (res.success && res.data) {\n
            state.onboarding.metrics = res.data;\n
            const m = res.data;\n
            const elAct = document.getElementById('metricActiveOnboardings');\n
            const elBlk = document.getElementById('metricBlockedTasks');\n
            const elCtr = document.getElementById('metricActiveContracts');\n
            const elDoc = document.getElementById('metricPendingDocuments');\n
\n
            if (elAct) elAct.textContent = m.active_onboardings ?? 0;\n
            if (elBlk) elBlk.textContent = m.blocked_tasks ?? 0;\n
            if (elCtr) elCtr.textContent = m.active_contracts ?? 0;\n
            if (elDoc) elDoc.textContent = m.pending_documents ?? 0;\n
        }\n
    } catch (err) {\n
        console.error('Failed to load onboarding metrics', err);\n
    }\n
}\n
\n
function switchOnboardingSubTab(subTab, btn) {\n
    document.querySelectorAll('#onboardingTab .ats-sub-content').forEach(el => el.style.display = 'none');\n
    document.querySelectorAll('#onboardingTab .subnav-btn').forEach(el => el.classList.remove('active'));\n
\n
    if (btn) btn.classList.add('active');\n
\n
    if (subTab === 'cases') {\n
        const el = document.getElementById('onbSubCases');\n
        if (el) el.style.display = 'block';\n
        loadOnboardingCases();\n
    } else if (subTab === 'contracts') {\n
        const el = document.getElementById('onbSubContracts');\n
        if (el) el.style.display = 'block';\n
        loadOnboardingContracts();\n
    } else if (subTab === 'documents') {\n
        const el = document.getElementById('onbSubDocuments');\n
        if (el) el.style.display = 'block';\n
        loadOnboardingDocuments();\n
    } else if (subTab === 'expiring') {\n
        const el = document.getElementById('onbSubExpiring');\n
        if (el) el.style.display = 'block';\n
        loadExpiringContracts();\n
    }\n
}\n
\n
async function loadOnboardingCases() {\n
    const tbody = document.getElementById('onboardingCasesTableBody');\n
    if (!tbody) return;\n
\n
    const search = document.getElementById('onbCaseSearch')?.value.trim() || '';\n
    const status = document.getElementById('onbCaseStatusFilter')?.value || '';\n
    const empType = document.getElementById('onbCaseTypeFilter')?.value || '';\n
\n
    let url = `/onboarding/cases?search=${encodeURIComponent(search)}`;\n
    if (status) url += `&status=${encodeURIComponent(status)}`;\n
    if (empType) url += `&employment_type=${encodeURIComponent(empType)}`;\n
\n
    try {\n
        const res = await apiFetch(url);\n
        if (res.success && res.data) {\n
            state.onboarding.cases = res.data;\n
            renderOnboardingCasesTable(res.data);\n
        }\n
    } catch (err) {\n
        tbody.innerHTML = `<tr><td colspan="8" style="text-align: center; color: #f87171; padding: 2rem;">Gagal memuat kasus onboarding: ${escapeHtml(err.message)}</td></tr>`;\n
    }\n
}\n
\n
function renderOnboardingCasesTable(cases) {\n
    const tbody = document.getElementById('onboardingCasesTableBody');\n
    if (!tbody) return;\n
\n
    if (!cases || cases.length === 0) {\n
        tbody.innerHTML = `<tr><td colspan="8" style="text-align: center; color: var(--text-muted); padding: 2rem;">Belum ada kasus onboarding terdaftar.</td></tr>`;\n
        return;\n
    }\n
\n
    const statusBadge = (s) => {\n
        if (s === 'COMPLETED') return `<span style="background: rgba(16, 185, 129, 0.2); color: #10b981; padding: 0.2rem 0.6rem; border-radius: 999px; font-size: 0.75rem; font-weight: 700;">Γ£ô SELESAI</span>`;\n
        if (s === 'BLOCKED') return `<span style="background: rgba(239, 68, 68, 0.2); color: #ef4444; padding: 0.2rem 0.6rem; border-radius: 999px; font-size: 0.75rem; font-weight: 700;">ΓÜá∩╕Å TERKENDALA</span>`;\n
        if (s === 'IN_PROGRESS') return `<span style="background: rgba(56, 189, 248, 0.2); color: #38bdf8; padding: 0.2rem 0.6rem; border-radius: 999px; font-size: 0.75rem; font-weight: 700;">ΓÅ│ PROSES</span>`;\n
        return `<span style="background: rgba(148, 163, 184, 0.2); color: #94a3b8; padding: 0.2rem 0.6rem; border-radius: 999px; font-size: 0.75rem; font-weight: 700;">PENDING</span>`;\n
    };\n
\n
    tbody.innerHTML = cases.map(c => {\n
        const empName = c.employee?.name || c.internship?.intern_name || 'Karyawan Baru';\n
        const empId = c.employee?.employee_id || c.internship?.intern_id || '-';\n
        const divName = c.division?.name || c.employee?.department || '-';\n
        const posName = c.position?.name || c.employee?.role || c.employment_type;\n
\n
        const totalTasks = c.tasks ? c.tasks.length : 0;\n
        const completedTasks = c.tasks ? c.tasks.filter(t => t.status === 'COMPLETED' || t.status === 'NOT_REQUIRED').length : 0;\n
        const progressPct = totalTasks > 0 ? Math.round((completedTasks / totalTasks) * 100) : 0;\n
\n
        return `\n
            <tr>\n
                <td style="font-weight: 700; color: #38bdf8;">${escapeHtml(c.case_number)}</td>\n
                <td>\n
                    <div style="font-weight: 600; color: #fff;">${escapeHtml(empName)}</div>\n
                    <div style="font-size: 0.75rem; color: var(--text-muted);">${escapeHtml(empId)}</div>\n
                </td>\n
                <td>\n
                    <div>${escapeHtml(divName)}</div>\n
                    <div style="font-size: 0.75rem; color: var(--text-muted);">${escapeHtml(posName)}</div>\n
                </td>\n
                <td>\n
                    <div><span style="font-size: 0.775rem; font-weight: 600; color: #f59e0b;">${escapeHtml(c.employment_type)}</span></div>\n
                    <div style="font-size: 0.75rem; color: var(--text-muted);">${escapeHtml(c.work_location || '-')}</div>\n
                </td>\n
                <td>${escapeHtml(c.start_date)}</td>\n
                <td>\n
                    <div style="display: flex; align-items: center; gap: 0.5rem;">\n
                        <div style="flex: 1; background: rgba(255,255,255,0.1); height: 6px; border-radius: 999px; overflow: hidden; min-width: 60px;">\n
                            <div style="width: ${progressPct}%; background: ${c.status === 'BLOCKED' ? '#ef4444' : '#10b981'}; height: 100%;"></div>\n
                        </div>\n
                        <span style="font-size: 0.75rem; font-weight: 700; color: #fff;">${progressPct}%</span>\n
                    </div>\n
                    <div style="font-size: 0.7rem; color: var(--text-muted);">${completedTasks}/${totalTasks} Tugas</div>\n
                </td>\n
                <td>${statusBadge(c.status)}</td>\n
                <td style="text-align: right;">\n
                    <button class="btn-secondary" style="padding: 0.35rem 0.65rem; font-size: 0.75rem;" onclick="viewOnboardingCaseDetail(${c.id})">\n
                        ≡ƒöì Detail & Checklist\n
                    </button>\n
                </td>\n
            </tr>\n
        `;\n
    }).join('');\n
}\n
\n
async function viewOnboardingCaseDetail(caseId) {\n
    try {\n
        const res = await apiFetch(`/onboarding/cases/${caseId}`);\n
        if (res.success && res.data) {\n
            state.onboarding.currentCase = res.data;\n
            const c = res.data;\n
\n
            const titleEl = document.getElementById('viewOnbCaseTitle');\n
            const subEl = document.getElementById('viewOnbCaseSubtitle');\n
            const barEl = document.getElementById('viewOnbProgressBar');\n
            const txtEl = document.getElementById('viewOnbProgressText');\n
            const listEl = document.getElementById('viewOnbTasksList');\n
            const completeBtn = document.getElementById('btnCompleteCaseAction');\n
\n
            const empName = c.employee?.name || c.internship?.intern_name || 'Karyawan Baru';\n
            if (titleEl) titleEl.textContent = `≡ƒôï Kasus Onboarding: ${c.case_number} (${empName})`;\n
            if (subEl) subEl.textContent = `Mulai: ${c.start_date} | Target: ${c.target_completion_date || '-'} | Status: ${c.status}`;\n
\n
            const progress = res.progress ?? 0;\n
            if (barEl) barEl.style.width = `${progress}%`;\n
            if (txtEl) txtEl.textContent = `${progress}% (${c.status})`;\n
\n
            if (completeBtn) {\n
                if (c.status === 'COMPLETED') {\n
                    completeBtn.style.display = 'none';\n
                } else {\n
                    completeBtn.style.display = 'inline-block';\n
                }\n
            }\n
\n
            if (listEl) {\n
                if (!c.tasks || c.tasks.length === 0) {\n
                    listEl.innerHTML = `<div style="text-align: center; color: var(--text-muted); padding: 1.5rem;">Tidak ada tugas checklist.</div>`;\n
                } else {\n
                    const taskBadge = (s) => {\n
                        if (s === 'COMPLETED') return `<span style="color: #10b981; font-weight: 700; font-size: 0.75rem;">Γ£ô SELESAI</span>`;\n
                        if (s === 'BLOCKED') return `<span style="color: #ef4444; font-weight: 700; font-size: 0.75rem;">ΓÜá∩╕Å TERBLOKIR</span>`;\n
                        if (s === 'IN_PROGRESS') return `<span style="color: #38bdf8; font-weight: 700; font-size: 0.75rem;">ΓÅ│ PROSES</span>`;\n
                        if (s === 'NOT_REQUIRED') return `<span style="color: #94a3b8; font-weight: 700; font-size: 0.75rem;">TIDAK PERLU</span>`;\n
                        return `<span style="color: #fbbf24; font-weight: 700; font-size: 0.75rem;">PENDING</span>`;\n
                    };\n
\n
                    listEl.innerHTML = c.tasks.map(t => `\n
                        <div style="display: flex; justify-content: space-between; align-items: center; background: rgba(255,255,255,0.03); border: 1px solid var(--border-color); border-radius: 0.5rem; padding: 0.75rem 1rem;">\n
                            <div style="flex: 1;">\n
                                <div style="display: flex; align-items: center; gap: 0.5rem;">\n
                                    <span style="font-weight: 600; color: #fff; font-size: 0.85rem;">${t.order_index}. ${escapeHtml(t.title)}</span>\n
                                    ${t.is_required ? '<span style="color: #ef4444; font-size: 0.7rem; font-weight: 700;">*WAJIB</span>' : '<span style="color: #94a3b8; font-size: 0.7rem;">(OPSIONAL)</span>'}\n
                                </div>\n
                                <div style="font-size: 0.75rem; color: var(--text-muted); margin-top: 0.2rem;">\n
                                    Kategori: <strong style="color: #38bdf8;">${escapeHtml(t.category)}</strong>\n
                                    ${t.due_date ? ` | Tenggat: ${t.due_date}` : ''}\n
                                    ${t.blocker_reason ? ` | <span style="color: #f87171; font-weight: 600;">Kendala: ${escapeHtml(t.blocker_reason)}</span>` : ''}\n
                                </div>\n
                            </div>\n
                            <div style="display: flex; align-items: center; gap: 0.75rem;">\n
                                ${taskBadge(t.status)}\n
                                ${c.status !== 'COMPLETED' ? `\n
                                    <button class="btn-secondary" style="padding: 0.25rem 0.5rem; font-size: 0.725rem;" onclick="openUpdateTaskModal(${t.id}, '${escapeHtml(t.title)}', '${t.status}', '${escapeHtml(t.blocker_reason || '')}')">\n
                                        Ubah Status\n
                                    </button>\n
                                ` : ''}\n
                            </div>\n
                        </div>\n
                    `).join('');\n
                }\n
            }\n
\n
            const modal = document.getElementById('modalViewOnboardingCase');\n
            if (modal) modal.classList.add('active');\n
        }\n
    } catch (err) {\n
        showToast(`Gagal memuat detail checklist: ${err.message}`, 'error');\n
    }\n
}\n
\n
function openUpdateTaskModal(taskId, title, status, blocker) {\n
    document.getElementById('taskUpdateId').value = taskId;\n
    const titleEl = document.getElementById('taskUpdateTitle');\n
    if (titleEl) titleEl.textContent = title;\n
\n
    const statusEl = document.getElementById('taskUpdateStatus');\n
    if (statusEl) statusEl.value = status;\n
\n
    const blockerEl = document.getElementById('taskBlockerReason');\n
    if (blockerEl) blockerEl.value = blocker || '';\n
\n
    toggleBlockerReasonField(status);\n
\n
    const modal = document.getElementById('modalUpdateOnboardingTask');\n
    if (modal) modal.classList.add('active');\n
}\n
\n
function toggleBlockerReasonField(status) {\n
    const container = document.getElementById('taskBlockerReasonContainer');\n
    if (container) {\n
        container.style.display = status === 'BLOCKED' ? 'block' : 'none';\n
    }\n
}\n
\n
async function submitTaskUpdate(e) {\n
    e.preventDefault();\n
    const taskId = document.getElementById('taskUpdateId')?.value;\n
    const status = document.getElementById('taskUpdateStatus')?.value;\n
    const blocker = document.getElementById('taskBlockerReason')?.value.trim();\n
    const notes = document.getElementById('taskUpdateNotes')?.value.trim();\n
\n
    try {\n
        const res = await apiFetch(`/onboarding/tasks/${taskId}`, {\n
            method: 'PUT',\n
            body: JSON.stringify({\n
                status: status,\n
                blocker_reason: blocker || null,\n
                notes: notes || null\n
            })\n
        });\n
\n
        if (res.success) {\n
            showToast('Status checklist berhasil diperbarui!', 'success');\n
            closeModal('modalUpdateOnboardingTask');\n
            if (state.onboarding.currentCase) {\n
                await viewOnboardingCaseDetail(state.onboarding.currentCase.id);\n
            }\n
            await Promise.all([loadOnboardingCases(), loadOnboardingMetrics()]);\n
        }\n
    } catch (err) {\n
        showToast(`Gagal memperbarui checklist: ${err.message}`, 'error');\n
    }\n
}\n
\n
async function submitCompleteCaseDirect() {\n
    if (!state.onboarding.currentCase) return;\n
    const caseId = state.onboarding.currentCase.id;\n
\n
    if (!confirm('Apakah Anda yakin seluruh checklist telah terpenuhi dan proses onboarding siap diselesaikan?')) {\n
        return;\n
    }\n
\n
    try {\n
        const res = await apiFetch(`/onboarding/cases/${caseId}/complete`, {\n
            method: 'POST'\n
        });\n
\n
        if (res.success) {\n
            showToast('Γ£ô Selamat! Proses onboarding berhasil diselesaikan secara resmi.', 'success');\n
            closeModal('modalViewOnboardingCase');\n
            await Promise.all([loadOnboardingCases(), loadOnboardingMetrics()]);\n
        }\n
    } catch (err) {\n
        showToast(`Γ£ò Gagal menyelesaikan onboarding: ${err.message}`, 'error');\n
    }\n
}\n
