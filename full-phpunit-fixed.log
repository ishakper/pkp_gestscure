async function saveEmployee(e) {\n
    e.preventDefault();\n
    const id = document.getElementById('empDbId').value;\n
    const rawCardInput = document.getElementById('empCardNo').value.trim();\n
    const payload = {\n
        employee_id: document.getElementById('empUserId').value,\n
        nik: document.getElementById('empNik').value,\n
        name: document.getElementById('empName').value,\n
        email: document.getElementById('empEmail').value, phone: document.getElementById('empPhone').value,\n
        building_id: document.getElementById('empBuilding').value || null, division_id: document.getElementById('empDivision').value || null, position_id: document.getElementById('empPosition').value || null,\n
        employment_type: document.getElementById('empEmploymentType').value || null, employment_status: document.getElementById('empEmploymentStatus').value, hire_date: document.getElementById('empHireDate').value || null,\n
        department: document.getElementById('empDept').value,\n
        role_jabatan: document.getElementById('empRole').value,\n
        fingerprint_enrolled: document.getElementById('empFp').checked,\n
        card_enrolled: document.getElementById('empCard').checked,\n
    };\n
\n
    if (rawCardInput !== '') {\n
        payload.card_no = rawCardInput;\n
    }\n
\n
    const method = id ? 'PUT' : 'POST';\n
    const endpoint = id ? `/user-management/employees/${id}` : '/user-management/employees';\n
\n
    try {\n
        const res = await apiFetch(endpoint, { method, body: JSON.stringify(payload) });\n
        if (res.status === 'success') {\n
            showToast(id ? 'Data karyawan berhasil diperbarui!' : 'Karyawan baru berhasil ditambahkan!', 'success');\n
            closeModal('employeeModal');\n
            await loadEmployees();\n
        }\n
    } catch (err) {\n
        showToast(`Gagal menyimpan data karyawan: ${err.message}`, 'error');\n
    }\n
}\n
\n
async function deleteEmployee(id, name) {\n
    if (!confirm(`Apakah Anda yakin ingin menghapus data karyawan "${name}"?`)) return;\n
\n
    try {\n
        const res = await apiFetch(`/user-management/employees/${id}`, { method: 'DELETE' });\n
        if (res.status === 'success') {\n
            showToast(`Karyawan "${name}" berhasil dinonaktifkan (Soft Deleted).`, 'success');\n
            await loadEmployees();\n
        }\n
    } catch (err) {\n
        showToast(`Gagal menghapus karyawan: ${err.message}`, 'error');\n
    }\n
}\n
