async function submitAddBuilding(e) {\n
    e.preventDefault();\n
    const code = document.getElementById('buildingCodeInput')?.value.trim();\n
    const name = document.getElementById('buildingNameInput')?.value.trim();\n
    const description = document.getElementById('buildingDescInput')?.value.trim();\n
\n
    if (!code || !name) return;\n
\n
