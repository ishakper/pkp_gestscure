function healthAge(seconds) {\n
    if (seconds === null || seconds === undefined) return 'Belum ada bukti pemeriksaan';\n
    if (seconds < 60) return `${seconds} detik lalu`;\n
    if (seconds < 3600) return `${Math.floor(seconds / 60)} menit lalu`;\n
    return `${Math.floor(seconds / 3600)} jam lalu`;\n
}\n
\n
async function loadSystemHealth() {\n
    const error = document.getElementById('systemHealthError');\n
    if (error) error.hidden = true;\n
\n
    try {\n
        const response = await apiFetch('/admin/system-health');\n
        const data = response.data || {};\n
        const set = (id, value) => { const el = document.getElementById(id); if (el) el.textContent = value ?? '-'; };\n
        set('healthApp', data.app?.status || 'UNKNOWN');\n
        set('healthTime', data.app?.server_time ? `Waktu server: ${new Date(data.app.server_time).toLocaleString('id-ID')}` : 'Waktu server tidak tersedia');\n
        set('healthDatabase', data.database?.status || 'UNKNOWN');\n
        set('healthDoor', data.primary_door?.status || 'UNKNOWN');\n
        set('healthDoorFreshness', data.primary_door?.last_checked_at ? `Terakhir diperiksa ${new Date(data.primary_door.last_checked_at).toLocaleString('id-ID')} (${healthAge(data.primary_door.freshness_seconds)})` : healthAge(null));\n
        const doors = data.doors || {};\n
        set('healthDoorsTotal', doors.total ?? 0);\n
        set('healthDoorsAggregate', `Healthy: ${doors.healthy ?? doors.online ?? 0} ┬╖ Offline: ${doors.offline ?? 0} ┬╖ Stale: ${doors.stale ?? 0} ┬╖ Unknown: ${doors.unknown ?? 0}`);\n
        set('healthWebhook', data.webhook?.status === 'HEALTHY' ? 'ACTIVE' : (data.webhook?.status || 'UNKNOWN'));\n
        set('healthWebhookFreshness', data.webhook?.received_at ? `Terakhir diterima ${new Date(data.webhook.received_at).toLocaleString('id-ID')} (${healthAge(data.webhook.freshness_seconds)})` : 'Belum ada bukti penerimaan');\n
        set('healthQueue', data.queue?.status || 'UNKNOWN');\n
        set('healthQueueCounts', `Pending: ${data.queue?.pending_jobs ?? 'N/A'} ┬╖ Gagal: ${data.queue?.failed_jobs ?? 'N/A'}`);\n
        set('healthLastEvent', data.last_access_event?.timestamp ? new Date(data.last_access_event.timestamp).toLocaleString('id-ID') : '-');\n
        set('healthLastEventDetail', data.last_access_event ? `${data.last_access_event.employee_name || 'Pegawai tidak teridentifikasi'} ┬╖ ${data.last_access_event.access_status || 'Status tidak tersedia'}` : 'Belum ada data');\n
    } catch (err) {\n
        if (err.message === 'Unauthorized') return;\n
        if (error) { error.textContent = `Status sistem gagal dimuat: ${err.message}`; error.hidden = false; }\n
    }\n
}\n
