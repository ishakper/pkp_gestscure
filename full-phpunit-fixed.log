// = = = = =\n
// Section 4: ISAPI Hardware Simulator\n
// = = = = =\n
function handleSimEventTypeChange(eventType) {\n
    const userLabel = document.getElementById('simUserLabel');\n
    const userNik = document.getElementById('simUserNik');\n
    const methodSelect = document.getElementById('simMethod');\n
    const statusSelect = document.getElementById('simStatus');\n
    const infoBox = document.getElementById('simScenarioInfo');\n
\n
    if (!userNik || !methodSelect || !statusSelect) return;\n
\n
    if (eventType === 'DOOR_FORCED_OPEN') {\n
        userNik.value = 'SENSOR-FORCED-OPEN';\n
        userNik.placeholder = 'Sensor pembobolan fisik';\n
        if (userLabel) userLabel.textContent = 'Identitas Sensor / Pemicu';\n
        methodSelect.value = 'Sensor';\n
        statusSelect.value = 'Alarm';\n
        if (infoBox) {\n
            infoBox.style.borderLeftColor = '#ef4444';\n
            infoBox.style.background = 'rgba(239, 68, 68, 0.1)';\n
            infoBox.innerHTML = `<strong>≡ƒÜ¿ Skenario Pembobolan Pintu (DOOR_FORCED_OPEN):</strong> <span>Event pembobolan pintu fisik tanpa autentikasi kartu/biometrik. Sistem memicu status ALARM (High Severity) dan mencatat insiden keamanan ke audit log.</span>`;\n
        }\n
    } else if (eventType === 'TAMPER_ALARM') {\n
        userNik.value = 'SENSOR-TAMPER';\n
        userNik.placeholder = 'Sensor tamper hardware';\n
        if (userLabel) userLabel.textContent = 'Identitas Sensor / Pemicu';\n
        methodSelect.value = 'Sensor';\n
        statusSelect.value = 'Alarm';\n
        if (infoBox) {\n
            infoBox.style.borderLeftColor = '#ef4444';\n
            infoBox.style.background = 'rgba(239, 68, 68, 0.1)';\n
            infoBox.innerHTML = `<strong>≡ƒöº Skenario Sabotase Terminal (TAMPER_ALARM):</strong> <span>Event sensor fisik anti-tamper terpicu akibat pembongkaran casing perangkat terminal oleh pihak tidak bertanggung jawab. Memicu status ALARM.</span>`;\n
        }\n
    } else if (eventType === 'DURESS_FINGERPRINT') {\n
        userNik.value = 'NIK-882101';\n
        userNik.placeholder = 'Misal: NIK-882101';\n
        if (userLabel) userLabel.textContent = 'NIK Karyawan (Korban Tekanan)';\n
        methodSelect.value = 'Duress_Fingerprint';\n
        statusSelect.value = 'Duress';\n
        if (infoBox) {\n
            infoBox.style.borderLeftColor = '#f59e0b';\n
            infoBox.style.background = 'rgba(245, 158, 11, 0.1)';\n
            infoBox.innerHTML = `<strong>ΓÜá∩╕Å Skenario Sidik Jari Darurat (DURESS_FINGERPRINT):</strong> <span>Event sidik jari khusus saat karyawan ditekan/diancam. Pintu fisik tetap terbuka agar keselamatan karyawan terjaga, namun sistem secara senyap (silent alert) memicu status DURESS di dashboard keamanan.</span>`;\n
        }\n
    } else {\n
        // STANDARD_TAP\n
        userNik.value = 'NIK-882101';\n
        userNik.placeholder = 'Misal: NIK-882101 atau CARD-1001';\n
        if (userLabel) userLabel.textContent = 'NIK / User ID / Nomor Kartu';\n
        methodSelect.value = 'Fingerprint';\n
        statusSelect.value = 'Granted';\n
        if (infoBox) {\n
            infoBox.style.borderLeftColor = '#38bdf8';\n
            infoBox.style.background = 'rgba(56, 189, 248, 0.08)';\n
            infoBox.innerHTML = `<strong>≡ƒÆí Skenario Terpilih:</strong> <span>Simulasi tap kartu / sidik jari reguler pegawai. Akses diberikan jika NIK terdaftar dan memiliki izin ke pintu tersebut.</span>`;\n
        }\n
    }\n
}\n
\n
async function runEventSimulation(e) {\n
    e.preventDefault();\n
    const doorId = document.getElementById('simDoorId')?.value || 'DOOR-A';\n
    const eventType = document.getElementById('simEventType')?.value || 'STANDARD_TAP';\n
    const user = document.getElementById('simUserNik')?.value.trim() || '';\n
    const method = document.getElementById('simMethod')?.value || 'Fingerprint';\n
    const status = document.getElementById('simStatus')?.value || 'Granted';\n
\n
    const payload = {\n
        door_id: doorId,\n
        event_type: eventType,\n
        user: user,\n
        verify_method: method,\n
        access_status: status,\n
        timestamp: new Date().toISOString(),\n
    };\n
\n
    const simBtn = document.getElementById('btnSendSimulation');\n
    if (simBtn) {\n
        simBtn.disabled = true;\n
        simBtn.innerHTML = `Mengirimkan sinyal ${eventType}...`;\n
    }\n
\n
    try {\n
        const res = await apiFetch('/doors/simulate-event', {\n
            method: 'POST',\n
            headers: {\n
                'X-Simulator': 'true',\n
            },\n
            body: JSON.stringify(payload),\n
            isBackground: false,\n
        });\n
\n
        const data = res;\n
        const resBox = document.getElementById('simResult');\n
        if (resBox) resBox.style.display = 'block';\n
\n
        if (res.status === 'success' || res.data) {\n
            const simDoor = escapeHtml(data.data?.door_id || doorId);\n
            const simEmp = escapeHtml(data.data?.employee_name || 'N/A');\n
            const simStatus = escapeHtml(data.data?.access_status || status);\n
            const simLogId = escapeHtml(data.data?.log_id || '-');\n
            const simReason = escapeHtml(data.data?.reason || '');\n
\n
            let alertClass = 'alert-success';\n
            let statusTitle = 'Γ£ô Sinyal Tap Hardware Berhasil Diproses!';\n
\n
            if (simStatus === 'Alarm' || eventType === 'DOOR_FORCED_OPEN' || eventType === 'TAMPER_ALARM') {\n
                alertClass = 'alert-danger';\n
                statusTitle = '≡ƒÜ¿ PERINGATAN: Sinyal ALARM Hardware Terdeteksi!';\n
            } else if (simStatus === 'Duress' || eventType === 'DURESS_FINGERPRINT') {\n
                alertClass = 'alert-warning';\n
                statusTitle = 'ΓÜá∩╕Å PERINGATAN DARURAT: Silent DURESS Alarm Terpicu!';\n
            } else if (simStatus === 'Denied') {\n
                alertClass = 'alert-warning';\n
                statusTitle = 'Γ£ò Sinyal Tap Ditolak (Akses Tidak Diizinkan)';\n
            }\n
\n
            if (resBox) {\n
                resBox.innerHTML = `\n
                    <div class="alert ${alertClass}">\n
                        <strong>${statusTitle}</strong><br>\n
                        <span>Door: <code>${simDoor}</code> | Event: <strong>${escapeHtml(eventType)}</strong> | Target: <strong>${simEmp}</strong> | Status: <strong>${simStatus}</strong></span><br>\n
                        ${simReason ? `<small>Keterangan: <em>${simReason}</em></small><br>` : ''}\n
                        <small>Log Audit ID: <code>${simLogId}</code></small>\n
                    </div>\n
                `;\n
            }\n
\n
            showToast(`Event ${eventType} pada pintu ${simDoor} berhasil dicatat!`, simStatus === 'Alarm' ? 'error' : (simStatus === 'Duress' ? 'warning' : 'success'));\n
            await loadAccessLogs();\n
            await loadDoors();\n
        } else {\n
            const errMsg = escapeHtml(data.message || 'Error');\n
            const errStatus = Number(res.status) || 400;\n
\n
            if (resBox) {\n
                resBox.innerHTML = `\n
                    <div class="alert alert-danger">\n
                        <strong>Γ£ò Simulasi Gagal (${errStatus}):</strong> ${errMsg}\n
                    </div>\n
                `;\n
            }\n
            showToast(`Simulasi gagal: ${errMsg}`, 'error');\n
        }\n
    } catch (err) {\n
        showToast(`Simulasi error: ${err.message}`, 'error');\n
    } finally {\n
        if (simBtn) {\n
            simBtn.disabled = false;\n
            simBtn.innerHTML = `ΓÜí Kirim Sinyal Event Hardware`;\n
        }\n
    }\n
}\n
