// Modal 4: Transisi Tahapan\n
function openTransitionStageModal(applicationId, candidateName, currentStage) {\n
    document.getElementById('transAppId').value = applicationId;\n
    const nameEl = document.getElementById('transCandName');\n
    if (nameEl) nameEl.textContent = candidateName;\n
\n
    const selectEl = document.getElementById('transNewStage');\n
    if (selectEl && currentStage) {\n
        selectEl.value = currentStage;\n
    }\n
\n
    const modal = document.getElementById('modalTransitionStage');\n
    if (modal) modal.classList.add('active');\n
}\n
\n
async function submitTransitionStage(e) {\n
    e.preventDefault();\n
    const appId = document.getElementById('transAppId')?.value;\n
    const payload = {\n
        stage_code: document.getElementById('transNewStage')?.value,\n
        notes: document.getElementById('transReason')?.value.trim() || null,\n
    };\n
\n
    try {\n
        const res = await apiFetch(`/recruitment/applications/${appId}/transition`, {\n
            method: 'POST',\n
            body: JSON.stringify(payload)\n
        });\n
        if (res.status === 'success') {\n
            showToast('Tahapan pelamar berhasil diperbarui!', 'success');\n
            closeModal('modalTransitionStage');\n
            document.getElementById('formTransitionStage')?.reset();\n
            await Promise.all([loadAtsApplications(), loadAtsMetrics()]);\n
        }\n
    } catch (err) {\n
        showToast(`Gagal memperbarui tahapan: ${err.message}`, 'error');\n
    }\n
}\n
