        if (s === 'PENDING_SIGNATURE') return `<span style="background: rgba(245, 158, 11, 0.2); color: #f59e0b; padding: 0.2rem 0.6rem; border-radius: 999px; font-size: 0.75rem; font-weight: 700;">MENUNGGU TTD</span>`;\n
