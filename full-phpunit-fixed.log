\n
let currentFieldAssignment = null;\n
let currentGpsCoords = null;\n
let currentFieldPhotoFile = null;\n
let isSubmittingFieldAttendance = false;\n
let todayAttendanceData = null;\n
\n
async function loadFieldAttendanceData() {\n
    const assignBadge = document.getElementById('fieldAssignmentStatusBadge');\n
    const assignDetails = document.getElementById('fieldAssignmentDetails');\n
    const todayCard = document.getElementById('fieldTodayAttendanceCard');\n
    const tbody = document.getElementById('fieldAttendanceTableBody');\n
\n
    if (assignDetails) {\n
        assignDetails.innerHTML = '<div class="spinner"></div> Memeriksa penugasan lapangan...';\n
    }\n
\n
    try {\n
        // 1. Fetch Today's status & assignment\n
        const statusRes = await apiFetch('/field-attendance/status-today');\n
        const data = statusRes.data || statusRes;\n
\n
        currentFieldAssignment = data.assignment;\n
        todayAttendanceData = data.attendance;\n
\n
        if (currentFieldAssignment) {\n
            const loc = currentFieldAssignment.field_location;\n
            if (assignBadge) {\n
                assignBadge.className = 'status-badge status-active';\n
                assignBadge.innerText = 'PENUGASAN AKTIF';\n
            }\n
            if (assignDetails) {\n
                assignDetails.innerHTML = `\n
                    <div style="font-weight: 700; font-size: 1.05rem; color: #fff; margin-bottom: 0.25rem;">\n
                        ${escapeHtml(loc?.name || 'Lokasi Lapangan')}\n
                    </div>\n
                    <div style="font-size: 0.8rem; color: var(--primary); margin-bottom: 0.5rem;">\n
                        Proyek: ${escapeHtml(loc?.project_name || '-')} ΓÇó Klien: ${escapeHtml(loc?.client_name || '-')}\n
                    </div>\n
                    <div style="font-size: 0.8rem; color: var(--text-muted); margin-bottom: 0.5rem;">\n
                        ≡ƒôì ${escapeHtml(loc?.site_address || 'Alamat tidak ditentukan')}\n
                    </div>\n
                    <div style="display: flex; gap: 0.5rem; flex-wrap: wrap;">\n
                        <span class="status-badge" style="background: rgba(56, 189, 248, 0.15); color: var(--primary);">\n
                            Radius Geofence: ${loc?.radius_meters || 100} m\n
                        </span>\n
                        <span class="status-badge" style="background: rgba(148, 163, 184, 0.15); color: var(--text-muted);">\n
                            Masa Tugas: ${escapeHtml(currentFieldAssignment.start_date || '')} s/d ${escapeHtml(currentFieldAssignment.end_date || '')}\n
                        </span>\n
                    </div>\n
                `;\n
            }\n
        } else {\n
            if (assignBadge) {\n
                assignBadge.className = 'status-badge status-inactive';\n
                assignBadge.innerText = 'TIDAK ADA PENUGASAN';\n
            }\n
            if (assignDetails) {\n
                assignDetails.innerHTML = `\n
                    <div style="color: var(--text-muted); font-size: 0.85rem; padding: 0.5rem 0;">\n
                        Anda belum memiliki penugasan lapangan aktif untuk hari ini. Hubungi HRD atau Supervisor untuk penerbitan surat tugas lapangan.\n
                    </div>\n
                `;\n
            }\n
        }\n
\n
        // 2. Render Today's Attendance State Card\n
        if (todayCard) {\n
            if (todayAttendanceData && (todayAttendanceData.clock_in_at || todayAttendanceData.clock_out_at)) {\n
                todayCard.style.display = 'block';\n
                const inTime = formatAttendanceTime(todayAttendanceData.clock_in_at) || '-';\n
                const outTime = formatAttendanceTime(todayAttendanceData.clock_out_at) || 'Belum Check-Out';\n
                const duration = todayAttendanceData.effective_work_minutes ? `${Math.floor(todayAttendanceData.effective_work_minutes / 60)}j ${todayAttendanceData.effective_work_minutes % 60}m` : '-';\n
\n
                let badge = '<span class="status-badge status-active">HADIR</span>';\n
                if (todayAttendanceData.status === 'LATE') {\n
                    badge = `<span class="status-badge status-warning">TERLAMBAT (+${todayAttendanceData.late_minutes}m)</span>`;\n
                }\n
\n
                todayCard.innerHTML = `\n
                    <div style="display: flex; justify-content: space-between; align-items: center; flex-wrap: wrap; gap: 0.5rem;">\n
                        <div>\n
                            <div style="font-size: 0.8rem; font-weight: 600; color: var(--text-muted); text-transform: uppercase;">\n
                                Ringkasan Kehadiran Lapangan Hari Ini (${escapeHtml(data.date)})\n
                            </div>\n
                            <div style="font-size: 1.1rem; font-weight: 700; color: #fff; margin-top: 0.25rem;">\n
                                Check-In: <span style="color: var(--success);">${inTime}</span> ΓÇó Check-Out: <span style="color: #818cf8;">${outTime}</span>\n
                            </div>\n
                        </div>\n
                        <div style="display: flex; gap: 0.5rem; align-items: center;">\n
                            <span style="font-size: 0.85rem; color: var(--text-muted);">Durasi Kerja: <strong>${duration}</strong></span>\n
                            ${badge}\n
                        </div>\n
                    </div>\n
                `;\n
            } else {\n
                todayCard.style.display = 'none';\n
            }\n
        }\n
\n
        // 3. Fetch Evidence Records\n
        if (tbody) {\n
            tbody.innerHTML = '<tr><td colspan="9" class="loading-td"><div class="spinner"></div> Memuat riwayat...</td></tr>';\n
            const recRes = await apiFetch('/field-attendance/records');\n
            const records = recRes.data?.data || recRes.data || [];\n
\n
            if (!records.length) {\n
                tbody.innerHTML = '<tr><td colspan="9" class="empty-td" style="text-align:center; padding: 2rem; color: var(--text-muted);">Belum ada bukti presensi lapangan yang tercatat.</td></tr>';\n
                return;\n
            }\n
\n
            const canManage = window.APP_CONFIG?.admin?.role === 'hrd' || window.APP_CONFIG?.admin?.role === 'super_admin';\n
\n
            tbody.innerHTML = records.map(ev => {\n
                const empName = ev.employee ? ev.employee.name : '-';\n
                const locName = ev.field_location ? ev.field_location.name : '-';\n
                const dateStr = ev.attendance_date ? ev.attendance_date.substring(0, 10) : '';\n
                const timeStr = formatAttendanceTime(ev.captured_at) || '';\n
\n
                let typeBadge = ev.type === 'CHECK_IN'\n
                    ? '<span class="status-badge" style="background:rgba(16,185,129,0.15);color:#10b981;">CHECK-IN</span>'\n
                    : '<span class="status-badge" style="background:rgba(99,102,241,0.15);color:#818cf8;">CHECK-OUT</span>';\n
\n
                let geoBadge = '';\n
                switch (ev.geofence_result) {\n
                    case 'VALID':\n
                        geoBadge = '<span class="status-badge status-active">VALID</span>';\n
                        break;\n
                    case 'OUTSIDE_GEOFENCE':\n
                        geoBadge = '<span class="status-badge status-inactive">LUAR RADIUS</span>';\n
                        break;\n
                    case 'LOW_ACCURACY':\n
                        geoBadge = '<span class="status-badge status-warning">AKURASI RENDAH</span>';\n
                        break;\n
                    default:\n
                        geoBadge = `<span class="status-badge">${escapeHtml(ev.geofence_result)}</span>`;\n
                }\n
\n
                let statusBadge = ev.is_override\n
                    ? '<span class="status-badge" style="background:rgba(245,158,11,0.2);color:#f59e0b;" title="' + escapeHtml(ev.override_reason || '') + '">OVERRIDE HRD</span>'\n
                    : (ev.geofence_result === 'VALID' ? '<span class="status-badge status-active">TERVERIFIKASI</span>' : '<span class="status-badge status-inactive">TERTUNDA</span>');\n
\n
                let actionBtns = `\n
                    <button class="btn-action btn-ping" style="padding: 0.3rem 0.6rem; font-size: 0.75rem;" onclick="viewFieldPhoto(${ev.id})">\n
                        ≡ƒô╖ Foto\n
                    </button>\n
                `;\n
\n
                if (canManage && !ev.is_override && ev.geofence_result !== 'VALID') {\n
                    actionBtns += `\n
                        <button class="btn-action btn-override" style="padding: 0.3rem 0.6rem; font-size: 0.75rem; margin-left: 0.25rem;" onclick="openFieldOverrideModal(${ev.id})">\n
                            ΓÜû∩╕Å Override\n
                        </button>\n
                    `;\n
                }\n
\n
                return `\n
                    <tr>\n
                        <td><strong>${escapeHtml(dateStr)}</strong> ${escapeHtml(timeStr)}</td>\n
                        <td>${escapeHtml(empName)}</td>\n
                        <td>${escapeHtml(locName)}</td>\n
                        <td>${typeBadge}</td>\n
                        <td>${ev.distance_meters != null ? Math.round(ev.distance_meters) + ' m' : '-'}</td>\n
                        <td>┬▒${ev.accuracy_meters != null ? Math.round(ev.accuracy_meters) + ' m' : '-'}</td>\n
                        <td>${geoBadge}</td>\n
                        <td>${statusBadge}</td>\n
                        <td>${actionBtns}</td>\n
                    </tr>\n
                `;\n
            }).join('');\n
        }\n
\n
        updateFieldActionButtons();\n
    } catch (e) {\n
        console.error('Error loading field attendance', e);\n
        if (assignDetails) {\n
            assignDetails.innerHTML = `<div style="color:var(--danger);font-size:0.85rem;">Gagal memuat data: ${escapeHtml(e.message)}</div>`;\n
        }\n
    }\n
}\n
\n
function acquireFieldGps() {\n
    const badge = document.getElementById('fieldGpsStatusBadge');\n
    const details = document.getElementById('fieldGpsDetails');\n
    const btn = document.getElementById('btnAcquireGps');\n
\n
    if (!navigator.geolocation) {\n
        showToast('Browser Anda tidak mendukung Geolocation API.', 'error');\n
        if (badge) { badge.className = 'status-badge status-inactive'; badge.innerText = 'UNAVAILABLE'; }\n
        return;\n
    }\n
\n
    if (badge) {\n
        badge.className = 'status-badge status-info';\n
        badge.innerText = 'GPS ACQUIRING...';\n
    }\n
    if (btn) { btn.disabled = true; btn.innerText = 'ΓÅ│ Mendeteksi Satelit...'; }\n
\n
    navigator.geolocation.getCurrentPosition(\n
        pos => {\n
            currentGpsCoords = {\n
                latitude: pos.coords.latitude,\n
                longitude: pos.coords.longitude,\n
                accuracy: pos.coords.accuracy,\n
                timestamp: new Date().toISOString()\n
            };\n
\n
            const lat = currentGpsCoords.latitude.toFixed(6);\n
            const lon = currentGpsCoords.longitude.toFixed(6);\n
            const acc = Math.round(currentGpsCoords.accuracy);\n
\n
            let distanceMeters = null;\n
            let isInside = false;\n
\n
            if (currentFieldAssignment?.field_location) {\n
                const targetLat = currentFieldAssignment.field_location.latitude;\n
                const targetLon = currentFieldAssignment.field_location.longitude;\n
                const radius = currentFieldAssignment.field_location.radius_meters || 100;\n
\n
                // Client-side Haversine estimate\n
                const R = 6371000;\n
                const dLat = (targetLat - currentGpsCoords.latitude) * Math.PI / 180;\n
                const dLon = (targetLon - currentGpsCoords.longitude) * Math.PI / 180;\n
                const a = Math.sin(dLat/2) * Math.sin(dLat/2) +\n
                          Math.cos(currentGpsCoords.latitude * Math.PI / 180) * Math.cos(targetLat * Math.PI / 180) *\n
                          Math.sin(dLon/2) * Math.sin(dLon/2);\n
                const c = 2 * Math.atan2(Math.sqrt(a), Math.sqrt(1-a));\n
                distanceMeters = Math.round(R * c);\n
                isInside = (distanceMeters <= radius);\n
            }\n
\n
            if (acc > 50) {\n
                if (badge) { badge.className = 'status-badge status-warning'; badge.innerText = 'LOW ACCURACY'; }\n
            } else if (distanceMeters !== null && !isInside) {\n
                if (badge) { badge.className = 'status-badge status-inactive'; badge.innerText = 'OUTSIDE GEOFENCE'; }\n
            } else {\n
                if (badge) { badge.className = 'status-badge status-active'; badge.innerText = 'GPS READY'; }\n
            }\n
\n
            if (details) {\n
                details.innerHTML = `\n
                    <div style="color: #fff; font-weight: 600;">Koordinat Terkunci:</div>\n
                    <div>Lat: <code>${lat}</code>, Lon: <code>${lon}</code></div>\n
                    <div>Akurasi GPS: <strong style="color:${acc <= 50 ? 'var(--success)' : '#f59e0b'}">┬▒${acc} meter</strong></div>\n
                    ${distanceMeters !== null ? `<div>Jarak ke Pusat Proyek: <strong style="color:${isInside ? 'var(--success)' : '#ef4444'}">${distanceMeters} meter</strong> (Radius: ${currentFieldAssignment.field_location.radius_meters}m)</div>` : ''}\n
                `;\n
            }\n
\n
            if (btn) { btn.disabled = false; btn.innerText = '≡ƒöä Perbarui Titik GPS'; }\n
            showToast('Posisi GPS berhasil dideteksi', 'info');\n
            updateFieldActionButtons();\n
        },\n
        err => {\n
            console.error('Geolocation error', err);\n
            if (badge) { badge.className = 'status-badge status-inactive'; badge.innerText = 'ERROR'; }\n
            if (details) {\n
                details.innerHTML = `<span style="color:var(--danger);">Gagal mendapatkan GPS: ${escapeHtml(err.message)}. Pastikan izin lokasi aktif pada browser.</span>`;\n
            }\n
            if (btn) { btn.disabled = false; btn.innerText = '≡ƒôí Coba Lagi Ambil GPS'; }\n
            showToast('Gagal memperoleh titik GPS: ' + err.message, 'error');\n
            updateFieldActionButtons();\n
        },\n
        { enableHighAccuracy: true, timeout: 15000, maximumAge: 0 }\n
    );\n
}\n
\n
function handleFieldPhotoSelected(e) {\n
    const file = e.target.files?.[0];\n
    const previewBox = document.getElementById('fieldPhotoPreviewBox');\n
    const previewImg = document.getElementById('fieldPhotoPreviewImg');\n
    const placeholder = document.getElementById('fieldPhotoPlaceholderText');\n
    const badge = document.getElementById('fieldPhotoStatusBadge');\n
\n
    if (!file) {\n
        currentFieldPhotoFile = null;\n
        if (badge) { badge.className = 'status-badge status-warning'; badge.innerText = 'FOTO DIPERLUKAN'; }\n
        if (previewImg) previewImg.style.display = 'none';\n
        if (placeholder) placeholder.style.display = 'block';\n
        updateFieldActionButtons();\n
        return;\n
    }\n
\n
    if (file.size > 5 * 1024 * 1024) {\n
        showToast('Ukuran foto melebihi batas maksimal 5 MB.', 'error');\n
        e.target.value = '';\n
        currentFieldPhotoFile = null;\n
        updateFieldActionButtons();\n
        return;\n
    }\n
\n
    currentFieldPhotoFile = file;\n
    if (badge) { badge.className = 'status-badge status-active'; badge.innerText = 'FOTO SIAP'; }\n
\n
    const reader = new FileReader();\n
    reader.onload = evt => {\n
        if (previewImg) {\n
            previewImg.src = evt.target.result;\n
            previewImg.style.display = 'block';\n
        }\n
        if (placeholder) {\n
            placeholder.style.display = 'none';\n
        }\n
    };\n
    reader.readAsDataURL(file);\n
\n
    showToast('Foto bukti berhasil dipilih', 'success');\n
    updateFieldActionButtons();\n
}\n
\n
function updateFieldActionButtons() {\n
    const btnIn = document.getElementById('btnFieldCheckIn');\n
    const btnOut = document.getElementById('btnFieldCheckOut');\n
\n
    const hasGps = currentGpsCoords !== null;\n
    const hasPhoto = currentFieldPhotoFile !== null;\n
    const hasAssignment = currentFieldAssignment !== null;\n
\n
    const canSubmit = hasGps && hasPhoto && hasAssignment && !isSubmittingFieldAttendance;\n
\n
    const hasCheckedInToday = todayAttendanceData && todayAttendanceData.clock_in_at;\n
    const hasCheckedOutToday = todayAttendanceData && todayAttendanceData.clock_out_at;\n
\n
    if (btnIn) {\n
        btnIn.disabled = !canSubmit || !!hasCheckedInToday;\n
        if (hasCheckedInToday) {\n
            btnIn.title = 'Anda sudah melakukan check-in hari ini.';\n
        }\n
    }\n
\n
    if (btnOut) {\n
        btnOut.disabled = !canSubmit || !hasCheckedInToday || !!hasCheckedOutToday;\n
        if (!hasCheckedInToday) {\n
            btnOut.title = 'Lakukan check-in terlebih dahulu.';\n
        } else if (hasCheckedOutToday) {\n
            btnOut.title = 'Anda sudah melakukan check-out hari ini.';\n
        }\n
    }\n
}\n
\n
async function submitFieldAttendance(type) {\n
    if (isSubmittingFieldAttendance) return;\n
\n
    if (!currentGpsCoords) {\n
        showToast('Ambil titik GPS Anda terlebih dahulu.', 'warning');\n
        return;\n
    }\n
    if (!currentFieldPhotoFile) {\n
        showToast('Ambil atau pilih foto bukti kehadiran terlebih dahulu.', 'warning');\n
        return;\n
    }\n
\n
    isSubmittingFieldAttendance = true;\n
    updateFieldActionButtons();\n
\n
    const btnIn = document.getElementById('btnFieldCheckIn');\n
    const btnOut = document.getElementById('btnFieldCheckOut');\n
    const notesInput = document.getElementById('fieldAttendanceNotes');\n
\n
    const activeBtn = type === 'CHECK_IN' ? btnIn : btnOut;\n
    const origText = activeBtn ? activeBtn.innerText : '';\n
    if (activeBtn) activeBtn.innerText = 'ΓÅ│ Mengirim...';\n
\n
    const formData = new FormData();\n
    formData.append('latitude', currentGpsCoords.latitude);\n
    formData.append('longitude', currentGpsCoords.longitude);\n
    formData.append('accuracy_meters', currentGpsCoords.accuracy);\n
    formData.append('captured_at', currentGpsCoords.timestamp || new Date().toISOString());\n
    formData.append('photo', currentFieldPhotoFile);\n
    if (notesInput && notesInput.value.trim()) {\n
        formData.append('notes', notesInput.value.trim());\n
    }\n
\n
    const endpoint = type === 'CHECK_IN'\n
        ? '/field-attendance/check-in'\n
        : '/field-attendance/check-out';\n
\n
    try {\n
        const csrfToken = document.querySelector('meta[name="csrf-token"]')?.getAttribute('content') || '';\n
        const headers = csrfToken ? { 'X-CSRF-TOKEN': csrfToken } : {};\n
\n
        const data = await apiFetchForm(endpoint, formData, { headers });\n
\n
        showToast(data.message || 'Presensi lapangan berhasil dicatat!', 'success');\n
\n
        // Reset photo\n
        currentFieldPhotoFile = null;\n
        const photoInput = document.getElementById('fieldPhotoInput');\n
        if (photoInput) photoInput.value = '';\n
        const previewImg = document.getElementById('fieldPhotoPreviewImg');\n
        if (previewImg) previewImg.style.display = 'none';\n
        const placeholder = document.getElementById('fieldPhotoPlaceholderText');\n
        if (placeholder) placeholder.style.display = 'block';\n
        const photoBadge = document.getElementById('fieldPhotoStatusBadge');\n
        if (photoBadge) { photoBadge.className = 'status-badge status-warning'; photoBadge.innerText = 'FOTO DIPERLUKAN'; }\n
\n
        if (notesInput) notesInput.value = '';\n
\n
        await loadFieldAttendanceData();\n
    } catch (e) {\n
        showToast('Terjadi kesalahan pengiriman: ' + e.message, 'error');\n
    } finally {\n
        isSubmittingFieldAttendance = false;\n
        if (activeBtn) activeBtn.innerText = origText;\n
        updateFieldActionButtons();\n
    }\n
}\n
\n
async function viewFieldPhoto(evidenceId) {\n
    const modal = document.getElementById('fieldPhotoModal');\n
    const body = document.getElementById('fieldPhotoModalBody');\n
    if (!modal || !body) return;\n
\n
    body.innerHTML = '<div class="spinner"></div> Mengambil foto secara terotorisasi...';\n
    modal.classList.add('active');\n
\n
    try {\n
        const appToken = window.APP_CONFIG?.apiToken || '';\n
        const headers = appToken ? { 'Authorization': `Bearer ${appToken}` } : {};\n
\n
        const res = await fetch(`/api/v1/field-attendance/records/${evidenceId}/photo`, { headers });\n
        if (!res.ok) {\n
            const err = await res.json().catch(() => ({}));\n
            body.innerHTML = `<div style="color:var(--danger);padding:1rem;">Gagal memuat foto: ${escapeHtml(err.message || 'Akses ditolak.')}</div>`;\n
            return;\n
        }\n
\n
        const blob = await res.blob();\n
        const objUrl = URL.createObjectURL(blob);\n
\n
        body.innerHTML = `\n
            <img src="${objUrl}" style="max-width: 100%; max-height: 420px; border-radius: 0.75rem; box-shadow: 0 4px 20px rgba(0,0,0,0.5); object-fit: contain;" />\n
            <div style="margin-top: 0.75rem; font-size: 0.8rem; color: var(--text-muted);">\n
                Foto bukti kehadiran terenkripsi lokal ΓÇó ID Rekaman #${evidenceId}\n
            </div>\n
        `;\n
    } catch (e) {\n
        body.innerHTML = `<div style="color:var(--danger);padding:1rem;">Kesalahan koneksi: ${escapeHtml(e.message)}</div>`;\n
    }\n
}\n
