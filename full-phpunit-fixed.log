// Modal 1: Tambah Pemagang Langsung\n
function openAddInternshipModal() {\n
    const divSelect = document.getElementById('intDivisionId');\n
    const mentorSelect = document.getElementById('intMentorId');\n
\n
    if (divSelect && state.organization?.divisions) {\n
        divSelect.innerHTML = '<option value="">Pilih Divisi</option>' +\n
            state.organization.divisions.map(d => `<option value="${d.id}">${escapeHtml(d.name)}</option>`).join('');\n
    }\n
\n
    if (mentorSelect && state.internship.mentors) {\n
        mentorSelect.innerHTML = '<option value="">Pilih Mentor</option>' +\n
            state.internship.mentors.map(m => `<option value="${m.id}">${escapeHtml(m.name)} (${escapeHtml(m.role)})</option>`).join('');\n
    }\n
\n
    const now = new Date();\n
    const end = new Date();\n
    end.setMonth(end.getMonth() + 3);\n
\n
    const sEl = document.getElementById('intStartDate');\n
    const eEl = document.getElementById('intEndDate');\n
    if (sEl) sEl.value = now.toISOString().slice(0, 10);\n
    if (eEl) eEl.value = end.toISOString().slice(0, 10);\n
\n
    const modal = document.getElementById('modalAddInternship');\n
    if (modal) modal.classList.add('active');\n
}\n
\n
async function saveInternship(e) {\n
    e.preventDefault();\n
    const payload = {\n
        institution: document.getElementById('intInstitution')?.value.trim(),\n
        major: document.getElementById('intMajor')?.value.trim(),\n
        education_level: document.getElementById('intEducationLevel')?.value,\n
        semester: parseInt(document.getElementById('intSemester')?.value || 6),\n
        position_title: document.getElementById('intPositionTitle')?.value.trim() || 'Intern',\n
        start_date: document.getElementById('intStartDate')?.value,\n
        end_date: document.getElementById('intEndDate')?.value,\n
        division_id: document.getElementById('intDivisionId')?.value || null,\n
        mentor_id: document.getElementById('intMentorId')?.value || null,\n
        campus_supervisor_name: document.getElementById('intCampusSupervisor')?.value.trim() || null,\n
        campus_supervisor_contact: document.getElementById('intCampusContact')?.value.trim() || null,\n
        project_assignment: document.getElementById('intProjectAssignment')?.value.trim() || null,\n
    };\n
\n
    try {\n
        const res = await apiFetch('/internships', {\n
            method: 'POST',\n
            body: JSON.stringify(payload)\n
        });\n
        if (res.status === 'success') {\n
            showToast('Program magang baru berhasil didaftarkan!', 'success');\n
            closeModal('modalAddInternship');\n
            document.getElementById('formAddInternship')?.reset();\n
            await Promise.all([loadInternships(), loadInternMetrics()]);\n
        }\n
    } catch (err) {\n
        showToast(`Gagal mendaftarkan magang: ${err.message}`, 'error');\n
    }\n
}\n
\n
// Modal 2: Konversi Kandidat ke Magang\n
async function openConvertCandidateModal() {\n
    await loadInternLookups();\n
\n
    const candSelect = document.getElementById('convCandidateId');\n
    const divSelect = document.getElementById('convDivisionId');\n
    const mentorSelect = document.getElementById('convMentorId');\n
\n
    if (candSelect && state.internship.candidates) {\n
        candSelect.innerHTML = '<option value="">-- Pilih Pelamar/Kandidat --</option>' +\n
            state.internship.candidates.map(c => {\n
                const name = `${c.first_name || ''} ${c.last_name || ''}`.trim();\n
                return `<option value="${c.id}">${escapeHtml(name)} (${escapeHtml(c.candidate_no || '')})</option>`;\n
            }).join('');\n
    }\n
\n
    if (divSelect && state.organization?.divisions) {\n
        divSelect.innerHTML = '<option value="">Pilih Divisi</option>' +\n
            state.organization.divisions.map(d => `<option value="${d.id}">${escapeHtml(d.name)}</option>`).join('');\n
    }\n
\n
    if (mentorSelect && state.internship.mentors) {\n
        mentorSelect.innerHTML = '<option value="">Pilih Mentor</option>' +\n
            state.internship.mentors.map(m => `<option value="${m.id}">${escapeHtml(m.name)} (${escapeHtml(m.role)})</option>`).join('');\n
    }\n
\n
    const now = new Date();\n
    const end = new Date();\n
    end.setMonth(end.getMonth() + 3);\n
\n
    const sEl = document.getElementById('convStartDate');\n
    const eEl = document.getElementById('convEndDate');\n
    if (sEl) sEl.value = now.toISOString().slice(0, 10);\n
    if (eEl) eEl.value = end.toISOString().slice(0, 10);\n
\n
    const modal = document.getElementById('modalConvertCandidateToIntern');\n
    if (modal) modal.classList.add('active');\n
}\n
