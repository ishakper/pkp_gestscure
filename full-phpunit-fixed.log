// Populate Asset Dropdowns (Available assets, active employees, active interns)\n
async function populateAssetDropdowns() {\n
    try {\n
        const res = await apiFetch('/assets?status=AVAILABLE');\n
        const asgSelect = document.getElementById('asgAssetSelect');\n
        const mntSelect = document.getElementById('mntAssetSelect');\n
        const incSelect = document.getElementById('incAssetSelect');\n
\n
        if (res && res.success && Array.isArray(res.data)) {\n
            const opts = res.data.map(a => `<option value="${a.id}">[${escapeHtml(a.asset_code)}] ${escapeHtml(a.asset_name)} (${escapeHtml(a.building_name)})</option>`).join('');\n
            if (asgSelect) asgSelect.innerHTML = '<option value="">-- Pilih Aset Tersedia --</option>' + opts;\n
        }\n
\n
        const resAll = await apiFetch('/assets');\n
        if (resAll && resAll.success && Array.isArray(resAll.data)) {\n
            const allOpts = resAll.data.map(a => `<option value="${a.id}">[${escapeHtml(a.asset_code)}] ${escapeHtml(a.asset_name)} (${escapeHtml(a.status)})</option>`).join('');\n
            if (mntSelect) mntSelect.innerHTML = '<option value="">-- Pilih Aset --</option>' + allOpts;\n
            if (incSelect) incSelect.innerHTML = '<option value="">-- Pilih Aset --</option>' + allOpts;\n
        }\n
\n
        const empSelect = document.getElementById('asgEmployeeSelect');\n
        if (empSelect && state.employees && state.employees.length) {\n
            empSelect.innerHTML = '<option value="">-- Tidak Ada / Kosongkan Jika Pemagang --</option>' +\n
                state.employees.filter(e => e.employment_status === 'ACTIVE' || e.employment_status === 'PROBATION')\n
                    .map(e => `<option value="${e.id}">${escapeHtml(e.name)} (${escapeHtml(e.employee_id)})</option>`).join('');\n
        }\n
\n
        const internSelect = document.getElementById('asgInternSelect');\n
        if (internSelect) {\n
            const intRes = await apiFetch('/internships?status=ACTIVE');\n
            if (intRes && intRes.status === 'success' && Array.isArray(intRes.data)) {\n
                internSelect.innerHTML = '<option value="">-- Tidak Ada / Kosongkan Jika Karyawan --</option>' +\n
                    intRes.data.map(i => `<option value="${i.id}">[${escapeHtml(i.intern_id)}] ${escapeHtml(i.employee?.name || i.institution)}</option>`).join('');\n
            }\n
        }\n
    } catch (e) {\n
        console.warn('Could not populate asset dropdowns', e);\n
    }\n
}\n
