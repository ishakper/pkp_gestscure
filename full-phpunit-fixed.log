        const res = await apiFetch('/admin/buildings', {\n
            method: 'POST',\n
            body: JSON.stringify({ code, name, description })\n
        });\n
\n
        if (res.status === 'success') {\n
            showToast(`Gedung ${escapeHtml(name)} berhasil ditambahkan`, 'success');\n
            closeModal('addBuildingModal');\n
            document.getElementById('addBuildingForm')?.reset();\n
            await Promise.all([loadBuildingHierarchy(), loadDoors()]);\n
        }\n
    } catch (err) {\n
        showToast(`Gagal menyimpan gedung: ${err.message}`, 'error');\n
    }\n
}\n
