// SPRINT 12: ATTENDANCE CORRECTIONS (CLIENT CONTROLLER)\n
// = = = = =\n
async function loadAttendanceCorrectionsData() {\n
    const tbody = document.getElementById('attendanceCorrectionsTableBody');\n
    if (!tbody) return;\n
\n
    tbody.innerHTML = `<tr><td colspan="10" class="loading-td"><div class="spinner"></div> Memuat data koreksi presensi...</td></tr>`;\n
\n
    // 1. Load metrics\n
    try {\n
        const mRes = await apiFetch('/attendance-corrections/metrics');\n
        if (mRes.success && mRes.data) {\n
            const d = mRes.data;\n
            const setVal = (id, v) => { const el = document.getElementById(id); if (el) el.innerText = v; };\n
            setVal('corrMetricPending', d.submitted || 0);\n
            setVal('corrMetricApproved', d.approved || 0);\n
            setVal('corrMetricRejected', d.rejected || 0);\n
            setVal('corrMetricCancelled', d.cancelled || 0);\n
        }\n
    } catch (e) {\n
        console.warn('Failed to load correction metrics:', e);\n
    }\n
\n
    // 2. Load list\n
    const type = document.getElementById('corrFilterType')?.value || '';\n
    const status = document.getElementById('corrFilterStatus')?.value || '';\n
    const from = document.getElementById('corrFilterFrom')?.value || '';\n
    const to = document.getElementById('corrFilterTo')?.value || '';\n
\n
    const params = new URLSearchParams();\n
    if (type) params.append('request_type', type);\n
    if (status) params.append('status', status);\n
    if (from) params.append('from_date', from);\n
    if (to) params.append('to_date', to);\n
\n
    try {\n
        const res = await apiFetch('/attendance-corrections?' + params.toString());\n
        if (!res.success || !res.data || res.data.length === 0) {\n
            tbody.innerHTML = `<tr><td colspan="10" style="text-align: center; padding: 2rem; color: var(--text-muted);">Tidak ada pengajuan koreksi presensi yang sesuai.</td></tr>`;\n
            return;\n
        }\n
\n
        const role = (window.APP_CONFIG?.admin?.role || '').toLowerCase();\n
        const canApprove = ['super_admin', 'hrd', 'management', 'supervisor'].includes(role);\n
\n
        tbody.innerHTML = res.data.map(item => {\n
            const empName = item.employee?.name || `Karyawan #${item.employee_id}`;\n
            const corrDate = item.correction_date ? item.correction_date.substring(0, 10) : '-';\n
\n
            // Original snapshot\n
            const origIn = formatAttendanceTime(item.original_check_in) || '-';\n
            const origOut = formatAttendanceTime(item.original_check_out) || '-';\n
            const origStat = item.original_status || '-';\n
            const origSummary = `<span style="font-size: 0.75rem; color: var(--text-muted);">${origIn} - ${origOut} [${origStat}]</span>`;\n
\n
            // Requested snapshot\n
            const reqIn = formatAttendanceTime(item.requested_check_in) || origIn;\n
            const reqOut = formatAttendanceTime(item.requested_check_out) || origOut;\n
            const reqStat = item.requested_status || (item.status === 'APPROVED' ? item.corrected_status : '-');\n
            const reqSummary = `<span style="font-size: 0.8rem; font-weight: 600; color: #fff;">${reqIn} - ${reqOut}</span>` + (reqStat !== '-' ? ` <span class="badge" style="font-size: 0.65rem; background: var(--border-color);">${reqStat}</span>` : '');\n
\n
            // Status Badge\n
            let statusBadge = `<span class="badge badge-warning">SUBMITTED</span>`;\n
            if (item.status === 'APPROVED') statusBadge = `<span class="badge badge-success">APPROVED</span>`;\n
            if (item.status === 'REJECTED') statusBadge = `<span class="badge badge-danger">REJECTED</span>`;\n
            if (item.status === 'CANCELLED') statusBadge = `<span class="badge" style="background: var(--text-muted); color: #fff;">CANCELLED</span>`;\n
\n
            // Attachment link\n
            let docLink = `<span style="color: var(--text-muted); font-size: 0.75rem;">-</span>`;\n
            if (item.attachment_path) {\n
                docLink = `<a href="/api/v1/attendance-corrections/${item.id}/attachment" target="_blank" class="btn-secondary" style="padding: 0.25rem 0.5rem; font-size: 0.75rem; text-decoration: none;">≡ƒôÄ Unduh</a>`;\n
            }\n
\n
            // Action buttons\n
            let actions = [];\n
            if (item.status === 'SUBMITTED') {\n
                if (canApprove) {\n
                    actions.push(`<button class="btn-primary" style="padding: 0.25rem 0.6rem; font-size: 0.75rem; background: var(--success); border-color: var(--success);" onclick="approveAttendanceCorrection(${item.id})">Γ£ö Setujui</button>`);\n
                    actions.push(`<button class="btn-secondary" style="padding: 0.25rem 0.6rem; font-size: 0.75rem; color: var(--danger); border-color: var(--danger);" onclick="openRejectAttendanceCorrectionModal(${item.id})">Γ£û Tolak</button>`);\n
                }\n
                actions.push(`<button class="btn-secondary" style="padding: 0.25rem 0.5rem; font-size: 0.75rem;" onclick="cancelAttendanceCorrection(${item.id})">Batalkan</button>`);\n
            } else {\n
                actions.push(`<span style="color: var(--text-muted); font-size: 0.75rem;">Selesai</span>`);\n
            }\n
\n
            return `\n
                <tr>\n
                    <td style="font-family: monospace; font-size: 0.8rem;">#${item.id}</td>\n
                    <td><strong>${escapeHtml(empName)}</strong></td>\n
                    <td>${corrDate}</td>\n
                    <td><span class="badge" style="background: var(--bg-base); border: 1px solid var(--border-color); font-size: 0.7rem;">${item.request_type}</span></td>\n
                    <td>${origSummary}</td>\n
                    <td>${reqSummary}</td>\n
                    <td style="max-width: 220px; font-size: 0.8rem; line-height: 1.2;">\n
                        ${escapeHtml(item.reason || '-')}\n
                        ${item.rejection_reason ? `<div style="color: var(--danger); font-size: 0.75rem; margin-top: 0.25rem;">Alasan tolak: ${escapeHtml(item.rejection_reason)}</div>` : ''}\n
                    </td>\n
                    <td>${docLink}</td>\n
                    <td>${statusBadge}</td>\n
                    <td><div style="display: flex; gap: 0.35rem; flex-wrap: wrap;">${actions.join('')}</div></td>\n
                </tr>\n
            `;\n
        }).join('');\n
    } catch (err) {\n
        tbody.innerHTML = `<tr><td colspan="10" style="text-align: center; color: var(--danger); padding: 2rem;">Gagal memuat koreksi presensi: ${escapeHtml(err.message)}</td></tr>`;\n
    }\n
}\n
\n
