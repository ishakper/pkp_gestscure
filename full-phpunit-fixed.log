                employee_id: state.selectedEmployeeForAssign.id,\n
            })\n
        });\n
\n
        if (res.status === 'success') {\n
            showToast(`Seluruh izin pintu untuk ${state.selectedEmployeeForAssign.name} berhasil dicabut.`, 'success');\n
            closeModal('doorAssignModal');\n
            await loadEmployees();\n
            await loadDoors();\n
        }\n
    } catch (err) {\n
        showToast(`Gagal mencabut hak akses: ${err.message}`, 'error');\n
    }\n
}\n
\n
async function revokeSingleDoor(empId, doorId) {\n
    if (!confirm(`Cabut izin akses pintu ${doorId} untuk karyawan ini?`)) {\n
        return;\n
    }\n
\n
    try {\n
        const res = await apiFetch('/user-management/revoke-doors', {\n
            method: 'POST',\n
            body: JSON.stringify({\n
                employee_id: empId,\n
                door_id: doorId,\n
            })\n
        });\n
\n
        if (res.status === 'success') {\n
            showToast(`Izin akses pintu ${doorId} berhasil dicabut.`, 'success');\n
            await loadEmployees();\n
            await loadDoors();\n
        }\n
    } catch (err) {\n
        showToast(`Gagal mencabut akses ${doorId}: ${err.message}`, 'error');\n
    }\n
}\n
\n
