function renderEmployeePagination() {\n
    const pagination = state.employeePagination;\n
    document.querySelectorAll('.employee-pagination').forEach(container => {\n
        if (!pagination || Number(pagination.total_pages || 1) <= 1) {\n
            container.innerHTML = '';\n
            return;\n
        }\n
        const current = Number(pagination.current_page || 1);\n
        const total = Number(pagination.total_pages || 1);\n
        const prevDisabled = current <= 1;\n
        const nextDisabled = current >= total;\n
        container.innerHTML = `\n
            <nav aria-label="Pengguna pagination" class="pagination-container">\n
                <div class="pagination-wrapper">\n
                    <button class="btn-secondary pagination-btn" aria-label="Halaman sebelumnya" ${prevDisabled ? 'disabled' : ''} onclick="loadEmployees(${current - 1})">ΓåÉ Sebelumnya</button>\n
                    <span class="pagination-status" aria-live="polite" aria-atomic="true">Halaman ${current} dari ${total}</span>\n
                    <button class="btn-secondary pagination-btn" aria-label="Halaman berikutnya" ${nextDisabled ? 'disabled' : ''} onclick="loadEmployees(${current + 1})">Berikutnya ΓåÆ</button>\n
                </div>\n
            </nav>`;\n
    });\n
}\n
