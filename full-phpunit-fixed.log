async function openEditAssetModal(id) {\n
    try {\n
        const res = await apiFetch(`/assets/${id}`);\n
        if (!res || !res.success) return;\n
        const a = res.data;\n
\n
        document.getElementById('assetEditId').value = a.id;\n
        document.getElementById('assetModalTitle').innerText = `Edit Data Aset (${a.asset_code})`;\n
        document.getElementById('assetFormName').value = a.asset_name || '';\n
        document.getElementById('assetFormCategory').value = a.category_id || '';\n
        document.getElementById('assetFormBrand').value = a.brand || '';\n
        document.getElementById('assetFormModel').value = a.model || '';\n
        document.getElementById('assetFormSerial').value = a.serial_number || '';\n
        document.getElementById('assetFormBuilding').value = a.building_name || 'Kantor Pusat PKP';\n
        document.getElementById('assetFormLocation').value = a.location || '';\n
        document.getElementById('assetFormCondition').value = a.condition || 'GOOD';\n
        document.getElementById('assetFormPurchaseDate').value = a.purchase_date ? a.purchase_date.substring(0, 10) : '';\n
        document.getElementById('assetFormWarrantyEnd').value = a.warranty_end ? a.warranty_end.substring(0, 10) : '';\n
        document.getElementById('assetFormNotes').value = a.notes || '';\n
\n
        openModal('modalAddAsset');\n
    } catch (e) {\n
        showToast(e.message, 'error');\n
    }\n
}\n
\n
async function submitAssetForm(e) {\n
    e.preventDefault();\n
    const editId = document.getElementById('assetEditId').value;\n
    const isEdit = Boolean(editId);\n
\n
    const payload = {\n
        asset_name: document.getElementById('assetFormName').value,\n
        category_id: document.getElementById('assetFormCategory').value || null,\n
        brand: document.getElementById('assetFormBrand').value || null,\n
        model: document.getElementById('assetFormModel').value || null,\n
        serial_number: document.getElementById('assetFormSerial').value || null,\n
        building_name: document.getElementById('assetFormBuilding').value || null,\n
        location: document.getElementById('assetFormLocation').value || null,\n
        condition: document.getElementById('assetFormCondition').value || 'GOOD',\n
        purchase_date: document.getElementById('assetFormPurchaseDate').value || null,\n
        warranty_end: document.getElementById('assetFormWarrantyEnd').value || null,\n
        notes: document.getElementById('assetFormNotes').value || null,\n
    };\n
\n
    try {\n
        const url = isEdit ? `/assets/${editId}` : '/assets';\n
        const method = isEdit ? 'PUT' : 'POST';\n
\n
        const res = await apiFetch(url, {\n
            method: method,\n
            body: JSON.stringify(payload)\n
        });\n
\n
        if (res && res.success) {\n
            showToast(res.message || 'Data aset berhasil disimpan', 'success');\n
            closeModal('modalAddAsset');\n
            loadAssetsInventory();\n
            loadAssetsMetrics();\n
            populateAssetDropdowns();\n
        } else {\n
            showToast(res?.message || 'Gagal menyimpan aset', 'error');\n
        }\n
    } catch (err) {\n
        showToast(err.message, 'error');\n
    }\n
}\n
