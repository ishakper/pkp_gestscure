async function showAssetDetail(id) {\n
    const titleEl = document.getElementById('detailAssetTitle');\n
    const codeEl = document.getElementById('detailAssetCode');\n
    const bodyEl = document.getElementById('assetDetailBody');\n
\n
    bodyEl.innerHTML = '<div class="spinner"></div> Memuat rincian aset...';\n
    openModal('modalAssetDetail');\n
\n
    try {\n
        const res = await apiFetch(`/assets/${id}`);\n
        if (!res || !res.success) {\n
            bodyEl.innerHTML = '<div class="error-td">Aset tidak ditemukan.</div>';\n
            return;\n
        }\n
\n
        const a = res.data;\n
        titleEl.innerText = a.asset_name;\n
        codeEl.innerText = a.asset_code;\n
\n
        const assignmentsHtml = (a.assignments && a.assignments.length)\n
            ? a.assignments.map(asg => {\n
                const holder = asg.employee ? asg.employee.name : (asg.internship ? `Intern ${asg.internship.intern_id}` : '-');\n
                const period = `${(asg.assigned_at || '').substring(0, 10)} s/d ${asg.actual_return_date ? asg.actual_return_date.substring(0, 10) : 'Saat ini'}`;\n
                return `<li><strong>${escapeHtml(asg.assignment_number)}</strong>: ${escapeHtml(holder)} (${period}) [Status: ${asg.status}]</li>`;\n
            }).join('')\n
            : '<li style="color: var(--text-muted);">Belum pernah dialokasikan.</li>';\n
\n
        const maintenancesHtml = (a.maintenances && a.maintenances.length)\n
            ? a.maintenances.map(m => `<li><strong>${escapeHtml(m.maintenance_number)}</strong>: ${escapeHtml(m.maintenance_type)} - ${escapeHtml(m.issue_description)} [${m.status}]</li>`).join('')\n
            : '<li style="color: var(--text-muted);">Belum ada riwayat perbaikan/servis.</li>';\n
\n
        const incidentsHtml = (a.incidents && a.incidents.length)\n
            ? a.incidents.map(inc => `<li><strong>${escapeHtml(inc.incident_number)}</strong>: ${escapeHtml(inc.incident_type)} - ${escapeHtml(inc.description)} [${inc.status}]</li>`).join('')\n
            : '<li style="color: var(--text-muted);">Tidak ada catatan insiden.</li>';\n
\n
        bodyEl.innerHTML = `\n
            <div style="display: grid; grid-template-columns: 1fr 1fr; gap: 1rem; margin-bottom: 1.25rem;">\n
                <div style="background: rgba(15, 23, 42, 0.6); padding: 1rem; border-radius: 0.75rem; border: 1px solid var(--border-color);">\n
                    <div style="font-weight: 700; color: #ffffff; margin-bottom: 0.5rem;">Spesifikasi Perangkat</div>\n
                    <div>Brand / Model: <strong>${escapeHtml(a.brand || '-')} / ${escapeHtml(a.model || '-')}</strong></div>\n
                    <div>Nomor Seri (Masked): <code>${escapeHtml(a.masked_serial_number || '-')}</code></div>\n
                    <div>Kategori: <strong>${escapeHtml(a.category?.name || '-')}</strong></div>\n
                    <div>Kondisi Fisik: <strong>${escapeHtml(a.condition)}</strong></div>\n
                    <div>Status Inventaris: <strong>${escapeHtml(a.status)}</strong></div>\n
                </div>\n
                <div style="background: rgba(15, 23, 42, 0.6); padding: 1rem; border-radius: 0.75rem; border: 1px solid var(--border-color);">\n
                    <div style="font-weight: 700; color: #ffffff; margin-bottom: 0.5rem;">Lokasi & Pembelian</div>\n
                    <div>Gedung: <strong>${escapeHtml(a.building_name || '-')}</strong></div>\n
                    <div>Lokasi Ruangan: <strong>${escapeHtml(a.location || '-')}</strong></div>\n
                    <div>Tgl Pembelian: <strong>${(a.purchase_date || '').substring(0, 10) || '-'}</strong></div>\n
                    <div>Batas Garansi: <strong>${(a.warranty_end || '').substring(0, 10) || '-'}</strong></div>\n
                    <div>Harga Pembelian: <strong>Rp ${Number(a.purchase_price || 0).toLocaleString('id-ID')}</strong></div>\n
                </div>\n
            </div>\n
            <div style="margin-bottom: 1rem;">\n
                <div style="font-weight: 700; color: #ffffff; margin-bottom: 0.25rem;">Riwayat Penugasan (Assignment History)</div>\n
                <ul style="padding-left: 1.25rem; font-size: 0.825rem; color: var(--text-muted);">${assignmentsHtml}</ul>\n
            </div>\n
            <div style="margin-bottom: 1rem;">\n
                <div style="font-weight: 700; color: #ffffff; margin-bottom: 0.25rem;">Riwayat Pemeliharaan & Servis</div>\n
                <ul style="padding-left: 1.25rem; font-size: 0.825rem; color: var(--text-muted);">${maintenancesHtml}</ul>\n
            </div>\n
            <div>\n
                <div style="font-weight: 700; color: #ffffff; margin-bottom: 0.25rem;">Catatan Insiden (Rusak / Hilang)</div>\n
                <ul style="padding-left: 1.25rem; font-size: 0.825rem; color: var(--text-muted);">${incidentsHtml}</ul>\n
            </div>\n
        `;\n
    } catch (e) {\n
        bodyEl.innerHTML = `<div class="error-td">Gagal memuat detail aset: ${escapeHtml(e.message)}</div>`;\n
    }\n
}\n
