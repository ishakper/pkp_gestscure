async function loadOrganizationLookup() {\n
    try {\n
        const res = await apiFetch('/user-management/organization/lookup');\n
        if (res.status !== 'success') return;\n
        state.organization = res.data;\n
        for (const [field, values] of [['empBuilding', res.data.buildings], ['empDivision', res.data.divisions], ['empPosition', res.data.positions]]) {\n
            const el = document.getElementById(field); if (!el) continue;\n
            el.innerHTML = '<option value="">Pilih</option>' + values.map(x => `<option value="${x.id}">${escapeHtml(x.name)}</option>`).join('');\n
        }\n
    } catch (err) { console.warn('Organization lookup unavailable', err); }\n
}\n
\n
async function loadEmployees(page = state.employeePage) {\n
    const tbody = document.getElementById('employeesTableBody');\n
    const fullTbody = document.getElementById('fullEmployeesTableBody');\n
    const countBadge = document.getElementById('employeeCountText');\n
    const searchVal = document.getElementById('employeeSearch')?.value.trim() || '';\n
    const doorFilter = document.getElementById('employeeDoorFilter')?.value || '';\n
    state.employeePage = Math.max(1, Number(page) || 1);\n
\n
    const loadingHtml = `<tr><td colspan="7" class="loading-td"><div class="spinner"></div> Memuat data karyawan &amp; hak akses...</td></tr>`;\n
    if (tbody) tbody.innerHTML = loadingHtml;\n
    if (fullTbody) fullTbody.innerHTML = loadingHtml;\n
\n
    try {\n
        let url = `/user-management/employees?per_page=20&page=${state.employeePage}`;\n
        if (searchVal) url += `&search=${encodeURIComponent(searchVal)}`;\n
        if (doorFilter) url += `&door_id=${encodeURIComponent(doorFilter)}`;\n
\n
        const res = await apiFetch(url);\n
        if (res.status === 'success') {\n
            state.employees = res.data;\n
            state.employeePagination = res.pagination || null;\n
            state.metrics.totalUsers = res.pagination?.total_all ?? res.pagination?.total_records ?? state.employees.length;\n
            scheduleMetricCardsUpdate();\n
\n
            if (countBadge) {\n
                const total = res.pagination?.total_all ?? '-';\n
                const formattedTotal = typeof total === 'number' ? new Intl.NumberFormat('id-ID').format(total) : total;\n
                const from = res.pagination?.from ?? 0;\n
                const to = res.pagination?.to ?? 0;\n
                const filtered = res.pagination?.total_records ?? 0;\n
                \n
                if (filtered === 0) {\n
                    countBadge.innerText = `Menampilkan 0 pengguna`;\n
                } else if (searchVal || doorFilter) {\n
                    countBadge.innerText = `Menampilkan ${from}ΓÇô${to} dari ${new Intl.NumberFormat('id-ID').format(filtered)} hasil ΓÇö ${formattedTotal} total pengguna`;\n
                } else {\n
                    countBadge.innerText = `Menampilkan ${from}ΓÇô${to} dari ${formattedTotal} pengguna`;\n
                }\n
            }\n
            \n
            // Update total summary in section header\n
            const totalSummary = document.getElementById('employeeTotalSummary');\n
            if (totalSummary && res.pagination?.total_all !== undefined) {\n
                const total = res.pagination.total_all;\n
                const formatted = new Intl.NumberFormat('id-ID').format(total);\n
                totalSummary.innerHTML = `Total Pengguna: <strong>${formatted}</strong>`;\n
            }\n
\n
            renderEmployeesTable(state.employees);\n
            renderEmployeePagination();\n
        }\n
    } catch (err) {\n
        const errorHtml = `<tr><td colspan="7" class="error-td">Gagal memuat data karyawan: ${err.message}</td></tr>`;\n
        if (tbody) tbody.innerHTML = errorHtml;\n
        if (fullTbody) fullTbody.innerHTML = errorHtml;\n
    }\n
}\n
\n
function renderEmployeesTable(employees) {\n
    const targets = [\n
        document.getElementById('employeesTableBody'),\n
        document.getElementById('fullEmployeesTableBody')\n
    ].filter(Boolean);\n
\n
    if (targets.length === 0) return;\n
\n
    if (employees.length === 0) {\n
        targets.forEach(t => {\n
            t.innerHTML = `<tr><td colspan="7" class="empty-td">Tidak ada data karyawan ditemukan.</td></tr>`;\n
        });\n
        return;\n
    }\n
\n
    const html = employees.map(emp => {\n
        // Biometric Badges\n
        const hasFp = emp.biometric_status?.fingerprint_enrolled;\n
        const hasCard = emp.biometric_status?.card_enrolled || emp.card_registered === 'YES';\n
        const fpBadge = hasFp\n
            ? `<span class="badge badge-success" title="Sidik jari aktif"><span class="badge-dot"></span> FP</span>`\n
            : `<span class="badge badge-dim" title="Status sidik jari tidak diketahui">FP Unknown</span>`;\n
        const cardBadge = hasCard\n
            ? `<span class="badge badge-info" title="Kartu terdaftar"><span class="badge-dot"></span> Kartu</span>`\n
            : `<span class="badge badge-dim" title="Status kartu tidak diketahui">Card Unknown</span>`;\n
\n
        // Door Assignment Badges\n
        let doorBadges = '<span class="badge badge-dim">Belum Diberi Akses</span>';\n
        if (emp.door_assign && emp.door_assign.length > 0) {\n
            doorBadges = emp.door_assign.map(d => {\n
                let badgeCls = 'badge-pending';\n
                let icon = 'ΓÅ│';\n
                let tooltip = `Status: ${d.sync_status}`;\n
\n
                if (d.sync_status === 'synced') {\n
                    badgeCls = 'badge-synced';\n
                    icon = 'Γ£ô';\n
                } else if (d.sync_status === 'failed') {\n
                    badgeCls = 'badge-failed';\n
                    icon = 'Γ£ò';\n
                    tooltip = d.last_sync_error ? `Error: ${d.last_sync_error}` : 'Sinkronisasi gagal ke hardware';\n
                }\n
\n
                return `\n
                    <span class="badge ${badgeCls} sync-pill" title="${tooltip}">\n
                        ${icon} ${d.door_id}: ${d.sync_status}\n
                    </span>\n
                `;\n
            }).join(' ');\n
        }\n
\n
        const statusBadge = (emp.employment_status === 'ACTIVE' || !emp.employment_status)\n
            ? `<span class="badge badge-success" style="font-size:0.72rem;padding:0.15rem 0.5rem;"><span class="badge-dot"></span> Aktif</span>`\n
            : (emp.employment_status === 'INACTIVE'\n
                ? `<span class="badge badge-danger" style="font-size:0.72rem;padding:0.15rem 0.5rem;"><span class="badge-dot"></span> Non-Aktif</span>`\n
                : `<span class="badge badge-warning" style="font-size:0.72rem;padding:0.15rem 0.5rem;"><span class="badge-dot"></span> ${escapeHtml(emp.employment_status)}</span>`);\n
\n
        const safeUserId = escapeHtml(emp.user_id || emp.employee_id || '-');\n
        const safeNik = escapeHtml(emp.nik || '-');\n
        const safeName = escapeHtml(emp.name || 'Unnamed');\n
        const safeDept = escapeHtml(emp.department || '-');\n
        const safeRole = escapeHtml(emp.role || emp.role_jabatan || 'Staff');\n
        const empId = Number(emp.id);\n
\n
        return `\n
            <tr data-employee-id="${empId}">\n
                <td>\n
                    <div class="user-id-box">\n
                        <strong>${safeUserId}</strong>\n
                        <span class="user-nik">${safeNik}</span>\n
                    </div>\n
                </td>\n
                <td>\n
                    <div class="user-name-box">\n
                        <span class="name-text">${safeName}</span>\n
                    </div>\n
                </td>\n
                <td>${safeDept}</td>\n
                <td>\n
                    <div style="display:flex;flex-direction:column;gap:0.3rem;align-items:flex-start;">\n
                        <span>${safeRole}</span>\n
                        ${statusBadge}\n
                    </div>\n
                </td>\n
                <td>\n
                    <div class="bio-pill-group">\n
                        ${fpBadge}\n
                        ${cardBadge}\n
                    </div>\n
                </td>\n
                <td>\n
                    <div class="door-pills-wrap">\n
                        ${doorBadges}\n
                    </div>\n
                </td>\n
                <td style="text-align: right;">\n
                    <div class="action-btns" style="justify-content: flex-end;">\n
                        <button class="btn-sm btn-assign" onclick="openDoorAssignmentModal(${empId})" title="Atur Akses Pintu Fisik">\n
                            ≡ƒÜ¬ Akses\n
                        </button>\n
                        <button class="btn-sm btn-edit" onclick="openEditEmployeeModal(${empId})" title="Edit Profil & Biometrik">\n
                            Γ£Å∩╕Å Edit\n
                        </button>\n
                        <button class="btn-sm btn-delete" onclick="handleDeleteEmployeeBtn(${empId}, this)" data-name="${safeName}" title="Hapus Pengguna">\n
                            ≡ƒùæ∩╕Å\n
                        </button>\n
                    </div>\n
                </td>\n
            </tr>\n
        `;\n
    }).join('');\n
\n
    targets.forEach(t => t.innerHTML = html);\n
}\n
