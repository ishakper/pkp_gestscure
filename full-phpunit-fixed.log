        }\n
    } catch (err) {\n
        tbody.innerHTML = `<tr><td colspan="8" style="text-align: center; color: #f87171; padding: 2rem;">Gagal memuat kontrak kerja: ${escapeHtml(err.message)}</td></tr>`;\n
    }\n
}\n
