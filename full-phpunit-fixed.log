            await loadAttendanceCorrectionsData();\n
        }\n
    } catch (err) {\n
        showToast('Gagal mengajukan koreksi: ' + err.message, 'error');\n
    } finally {\n
        if (btn) { btn.disabled = false; btn.innerText = origText; }\n
    }\n
}\n
\n
async function approveAttendanceCorrection(id) {\n
    if (!confirm(`Setujui pengajuan koreksi presensi #${id}? Perubahan akan langsung diaplikasikan pada rekap presensi harian.`)) return;\n
\n
    try {\n
        const res = await apiFetch(`/attendance-corrections/${id}/approve`, { method: 'POST' });\n
        if (res.success) {\n
            showToast(res.message || 'Koreksi presensi berhasil disetujui.', 'success');\n
            await loadAttendanceCorrectionsData();\n
        }\n
    } catch (err) {\n
        showToast('Gagal menyetujui koreksi: ' + err.message, 'error');\n
    }\n
}\n
\n
function openRejectAttendanceCorrectionModal(id) {\n
    const modal = document.getElementById('rejectAttendanceCorrectionModal');\n
    if (!modal) return;\n
    document.getElementById('rejectCorrId').value = id;\n
    document.getElementById('rejectCorrReasonInput').value = '';\n
    openModal('rejectAttendanceCorrectionModal');\n
}\n
\n
async function submitRejectAttendanceCorrection(e) {\n
    e.preventDefault();\n
    const id = document.getElementById('rejectCorrId').value;\n
    const reason = document.getElementById('rejectCorrReasonInput').value;\n
    const btn = document.getElementById('btnSubmitRejectCorr');\n
\n
    if (!reason || reason.trim().length < 3) {\n
        showToast('Alasan penolakan minimal 3 karakter.', 'warning');\n
        return;\n
    }\n
\n
    const origText = btn ? btn.innerText : '';\n
    if (btn) { btn.disabled = true; btn.innerText = 'Menyimpan...'; }\n
\n
    try {\n
        const res = await apiFetch(`/attendance-corrections/${id}/reject`, {\n
            method: 'POST',\n
            body: JSON.stringify({ reason })\n
        });\n
        if (res.success) {\n
            showToast(res.message || 'Koreksi presensi berhasil ditolak.', 'success');\n
            closeModal('rejectAttendanceCorrectionModal');\n
            await loadAttendanceCorrectionsData();\n
        }\n
    } catch (err) {\n
        showToast('Gagal menolak: ' + err.message, 'error');\n
    } finally {\n
        if (btn) { btn.disabled = false; btn.innerText = origText; }\n
    }\n
}\n
