                    <td style="text-align: center;">\n
                        <span class="badge badge-info" style="font-weight: 700;">${v.applications_count ?? 0} Pelamar</span>\n
                    </td>\n
                    <td>\n
                        <span class="badge ${statusClass}">${escapeHtml(v.status)}</span>\n
                    </td>\n
                    <td style="font-size: 0.8rem; color: var(--text-muted);">\n
