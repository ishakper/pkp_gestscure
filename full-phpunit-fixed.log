function openFieldOverrideModal(evidenceId) {\n
    const modal = document.getElementById('fieldOverrideModal');\n
    const idInput = document.getElementById('overrideEvidenceId');\n
    const reasonInput = document.getElementById('overrideReasonInput');\n
\n
    if (idInput) idInput.value = evidenceId;\n
    if (reasonInput) reasonInput.value = '';\n
    if (modal) modal.classList.add('active');\n
}\n
