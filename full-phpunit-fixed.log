// Floating Logo & Sidebar Controller\n
// = = = = =\n
function initSidebar() {\n
    const isMobile = () => window.innerWidth <= 768;\n
    const backdrop = document.getElementById('sidebarBackdrop');\n
    const floatingLogo = document.getElementById('floatingLogo');\n
    const closeBtn = document.getElementById('sidebarCloseBtn');\n
\n
    // Retrieve saved state (default: open on desktop >= 768px, closed on mobile)\n
    let isSavedOpen = localStorage.getItem('pkp_sidebar_open');\n
    if (isSavedOpen === null) {\n
        isSavedOpen = localStorage.getItem('pkp_sidebar_collapsed') !== 'true';\n
    } else {\n
        isSavedOpen = isSavedOpen === 'true';\n
    }\n
\n
    // Apply initial state\n
    if (!isMobile() && isSavedOpen) {\n
        document.body.classList.add('sidebar-open');\n
        document.documentElement.classList.add('sidebar-open');\n
    } else {\n
        document.body.classList.remove('sidebar-open');\n
        document.documentElement.classList.remove('sidebar-open');\n
    }\n
\n
    // Clean up any stale legacy classes\n
    document.body.classList.remove('sidebar-collapsed', 'sidebar-mobile-open');\n
    document.documentElement.classList.remove('sidebar-collapsed', 'sidebar-mobile-open');\n
\n
    // 1. Floating Logo Trigger (PKP Coin + Title) -> Toggle Sidebar\n
    if (floatingLogo) {\n
        floatingLogo.addEventListener('click', (e) => {\n
            e.stopPropagation();\n
            toggleSidebar();\n
        });\n
        floatingLogo.addEventListener('keydown', (e) => {\n
            if (e.key === 'Enter' || e.key === ' ') {\n
                e.preventDefault();\n
                toggleSidebar();\n
            }\n
        });\n
    }\n
\n
    // 2. Close button in mobile drawer\n
    if (closeBtn) {\n
        closeBtn.addEventListener('click', (e) => {\n
            e.stopPropagation();\n
            toggleSidebar(false);\n
        });\n
    }\n
\n
    // 3. Mobile Backdrop overlay click -> Close drawer\n
    if (backdrop) {\n
        backdrop.addEventListener('click', () => {\n
            toggleSidebar(false);\n
        });\n
    }\n
\n
    // 4. Responsive resize synchronization\n
    window.addEventListener('resize', () => {\n
        if (!isMobile()) {\n
            if (backdrop) backdrop.classList.remove('active');\n
            const isOpen = localStorage.getItem('pkp_sidebar_open') === 'true';\n
            if (isOpen) {\n
                document.body.classList.add('sidebar-open');\n
                document.documentElement.classList.add('sidebar-open');\n
            } else {\n
                document.body.classList.remove('sidebar-open');\n
                document.documentElement.classList.remove('sidebar-open');\n
            }\n
        } else {\n
            if (!document.body.classList.contains('sidebar-open')) {\n
                if (backdrop) backdrop.classList.remove('active');\n
            }\n
        }\n
    });\n
\n
    // 5. Keyboard Shortcuts: Esc to close, Ctrl+B / Cmd+B to toggle\n
    document.addEventListener('keydown', (e) => {\n
        if (e.key === 'Escape') {\n
            if (document.body.classList.contains('sidebar-open')) {\n
                toggleSidebar(false);\n
            }\n
        } else if ((e.ctrlKey || e.metaKey) && e.key.toLowerCase() === 'b') {\n
            e.preventDefault();\n
            toggleSidebar();\n
        }\n
    });\n
}\n
\n
function toggleSidebar(forceState) {\n
    const isMobile = window.innerWidth <= 768;\n
    const backdrop = document.getElementById('sidebarBackdrop');\n
\n
    const isCurrentlyOpen = document.body.classList.contains('sidebar-open') ||\n
                            document.documentElement.classList.contains('sidebar-open');\n
    const shouldOpen = typeof forceState === 'boolean' ? forceState : !isCurrentlyOpen;\n
\n
    if (shouldOpen) {\n
        document.body.classList.add('sidebar-open');\n
        document.documentElement.classList.add('sidebar-open');\n
        localStorage.setItem('pkp_sidebar_open', 'true');\n
        localStorage.setItem('pkp_sidebar_collapsed', 'false');\n
        if (isMobile && backdrop) backdrop.classList.add('active');\n
    } else {\n
        document.body.classList.remove('sidebar-open');\n
        document.documentElement.classList.remove('sidebar-open');\n
        localStorage.setItem('pkp_sidebar_open', 'false');\n
        localStorage.setItem('pkp_sidebar_collapsed', 'true');\n
        if (backdrop) backdrop.classList.remove('active');\n
    }\n
}\n
