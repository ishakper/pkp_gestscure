// Modal 7: Buat Surat Offering\n
function openCreateOfferModal(applicationId, candidateName) {\n
    document.getElementById('offAppId').value = applicationId;\n
    const nameEl = document.getElementById('offCandName');\n
    if (nameEl) nameEl.textContent = candidateName;\n
\n
    // Default start date = 14 days later, expiry = 7 days later\n
    const start = new Date();\n
    start.setDate(start.getDate() + 14);\n
    const expiry = new Date();\n
    expiry.setDate(expiry.getDate() + 7);\n
\n
    const sEl = document.getElementById('offStartDate');\n
    const eEl = document.getElementById('offExpiryDate');\n
    if (sEl) sEl.value = start.toISOString().slice(0, 10);\n
    if (eEl) eEl.value = expiry.toISOString().slice(0, 10);\n
\n
    const modal = document.getElementById('modalCreateOffer');\n
    if (modal) modal.classList.add('active');\n
}\n
\n
async function saveOffer(e) {\n
    e.preventDefault();\n
    const payload = {\n
        application_id: document.getElementById('offAppId')?.value,\n
        basic_salary: parseFloat(document.getElementById('offSalary')?.value || 0),\n
        start_date: document.getElementById('offStartDate')?.value,\n
        expiry_date: document.getElementById('offExpiryDate')?.value,\n
        terms: document.getElementById('offTerms')?.value.trim() || null,\n
    };\n
\n
    try {\n
        const res = await apiFetch('/recruitment/offers', {\n
            method: 'POST',\n
            body: JSON.stringify(payload)\n
        });\n
        if (res.status === 'success') {\n
            showToast('Surat offering berhasil diterbitkan!', 'success');\n
            closeModal('modalCreateOffer');\n
            document.getElementById('formCreateOffer')?.reset();\n
            await Promise.all([loadAtsApplications(), loadAtsMetrics()]);\n
        }\n
    } catch (err) {\n
        showToast(`Gagal membuat offering: ${err.message}`, 'error');\n
    }\n
}\n
