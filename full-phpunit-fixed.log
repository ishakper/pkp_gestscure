async function loadAtsInterviews() {\n
    const tbody = document.getElementById('atsInterviewsTableBody');\n
    if (!tbody) return;\n
\n
    tbody.innerHTML = `<tr><td colspan="8" class="loading-td"><div class="spinner"></div> Memuat jadwal interview...</td></tr>`;\n
