async function openAddZoneModal() {\n
    const modal = document.getElementById('addZoneModal');\n
    const select = document.getElementById('zoneBuildingSelect');\n
\n
    if (!modal || !select) return;\n
\n
    select.innerHTML = '<option value="">Memuat data gedung...</option>';\n
\n
    try {\n
        const res = await apiFetch('/admin/buildings');\n
        const buildings = (res.status === 'success' && Array.isArray(res.data)) ? res.data : [];\n
\n
        select.innerHTML = '<option value="">Pilih Gedung Induk...</option>' + buildings.map(b => `\n
            <option value="${b.id}">${escapeHtml(b.name)} (${escapeHtml(b.code)})</option>\n
        `).join('');\n
\n
        modal.classList.add('active');\n
    } catch (err) {\n
        showToast('Gagal memuat opsi gedung', 'error');\n
    }\n
}\n
\n
async function submitAddZone(e) {\n
    e.preventDefault();\n
    const building_id = document.getElementById('zoneBuildingSelect')?.value;\n
    const code = document.getElementById('zoneCodeInput')?.value.trim();\n
    const name = document.getElementById('zoneNameInput')?.value.trim();\n
\n
    if (!building_id || !code || !name) return;\n
\n
    try {\n
        const res = await apiFetch('/admin/zones', {\n
            method: 'POST',\n
            body: JSON.stringify({ building_id: parseInt(building_id), code, name })\n
        });\n
\n
        if (res.status === 'success') {\n
            showToast(`Zona ${escapeHtml(name)} berhasil ditambahkan`, 'success');\n
            closeModal('addZoneModal');\n
            document.getElementById('addZoneForm')?.reset();\n
            await loadBuildingHierarchy();\n
        }\n
    } catch (err) {\n
        showToast(`Gagal menyimpan zona: ${err.message}`, 'error');\n
    }\n
}\n
\n
