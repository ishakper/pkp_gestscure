// Modal 3: Lamar Lowongan\n
async function openApplyModal(preselectedCandidateId = null) {\n
    await loadAtsLookups();\n
\n
    const candSelect = document.getElementById('applyCandidateId');\n
    const vacSelect = document.getElementById('applyVacancyId');\n
\n
    if (candSelect) {\n
        candSelect.innerHTML = '<option value="">-- Pilih Kandidat --</option>' +\n
            state.ats.candidates.map(c => {\n
                const name = `${c.first_name || ''} ${c.last_name || ''}`.trim();\n
                const selected = preselectedCandidateId && Number(preselectedCandidateId) === c.id ? 'selected' : '';\n
                return `<option value="${c.id}" ${selected}>${escapeHtml(name)} (${escapeHtml(c.candidate_number)})</option>`;\n
            }).join('');\n
    }\n
\n
    if (vacSelect) {\n
        vacSelect.innerHTML = '<option value="">-- Pilih Lowongan Dibuka --</option>' +\n
            state.ats.vacancies.map(v => {\n
                return `<option value="${v.id}">${escapeHtml(v.title)} (${escapeHtml(v.vacancy_code)})</option>`;\n
            }).join('');\n
    }\n
\n
    const modal = document.getElementById('modalApplyVacancy');\n
    if (modal) modal.classList.add('active');\n
}\n
