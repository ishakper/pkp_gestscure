function formatRupiah(amount) {\n
    if (!amount || isNaN(amount)) return '-';\n
    return 'Rp ' + Number(amount).toLocaleString('id-ID');\n
}\n
\n
function formatDateTime(dtStr) {\n
    if (!dtStr) return '-';\n
    try {\n
        const d = new Date(dtStr);\n
        return d.toLocaleDateString('id-ID', { day: '2-digit', month: 'short', year: 'numeric', hour: '2-digit', minute: '2-digit' });\n
    } catch {\n
        return dtStr;\n
    }\n
}\n
\n
function switchAtsPill(pillName, btn) {\n
    document.querySelectorAll('.ats-nav-pill').forEach(el => el.classList.remove('active'));\n
    document.querySelectorAll('.ats-sub-content').forEach(el => el.classList.remove('active'));\n
\n
    if (btn) {\n
        btn.classList.add('active');\n
    } else {\n
        const defaultBtn = document.getElementById(`pill${pillName.charAt(0).toUpperCase() + pillName.slice(1)}`);\n
        if (defaultBtn) defaultBtn.classList.add('active');\n
    }\n
\n
    const subId = `atsSub${pillName.charAt(0).toUpperCase() + pillName.slice(1)}`;\n
    const subTarget = document.getElementById(subId);\n
    if (subTarget) subTarget.classList.add('active');\n
\n
    state.ats.activePill = pillName;\n
\n
    if (pillName === 'pipeline') loadAtsApplications();\n
    if (pillName === 'vacancies') loadAtsVacancies();\n
    if (pillName === 'candidates') loadAtsCandidates();\n
    if (pillName === 'interviews') loadAtsInterviews();\n
}\n
\n
async function loadRecruitmentData() {\n
    await Promise.allSettled([\n
        loadAtsMetrics(),\n
        loadAtsLookups(),\n
    ]);\n
\n
    if (state.ats.activePill === 'pipeline') loadAtsApplications();\n
    else if (state.ats.activePill === 'vacancies') loadAtsVacancies();\n
    else if (state.ats.activePill === 'candidates') loadAtsCandidates();\n
    else if (state.ats.activePill === 'interviews') loadAtsInterviews();\n
}\n
\n
async function loadAtsLookups() {\n
    try {\n
        const [stagesRes, vacanciesRes, candidatesRes] = await Promise.allSettled([\n
            apiFetch('/recruitment/stages'),\n
            apiFetch('/recruitment/vacancies?status=OPEN'),\n
            apiFetch('/recruitment/candidates')\n
        ]);\n
\n
        if (stagesRes.status === 'fulfilled' && stagesRes.value?.status === 'success') {\n
            state.ats.stages = stagesRes.value.data || [];\n
        }\n
        if (vacanciesRes.status === 'fulfilled' && vacanciesRes.value?.status === 'success') {\n
            state.ats.vacancies = vacanciesRes.value.data || [];\n
        }\n
        if (candidatesRes.status === 'fulfilled' && candidatesRes.value?.status === 'success') {\n
            state.ats.candidates = candidatesRes.value.data || [];\n
        }\n
    } catch (err) {\n
        console.warn('ATS lookups error:', err);\n
    }\n
}\n
\n
async function loadAtsMetrics() {\n
    try {\n
        const res = await apiFetch('/recruitment/metrics');\n
        if (res.status === 'success' && res.data) {\n
            const m = res.data;\n
            const elVac = document.getElementById('atsMetricVacancies');\n
            const elCand = document.getElementById('atsMetricCandidates');\n
            const elApps = document.getElementById('atsMetricApplications');\n
            const elHired = document.getElementById('atsMetricHired');\n
\n
            if (elVac) elVac.textContent = m.open_vacancies ?? 0;\n
            if (elCand) elCand.textContent = m.total_candidates ?? 0;\n
            if (elApps) elApps.textContent = m.active_applications ?? 0;\n
            if (elHired) elHired.textContent = m.hired_count ?? 0;\n
        }\n
    } catch (err) {\n
        console.warn('Gagal memuat metrik ATS:', err);\n
    }\n
}\n
