// Modal 5: Jadwal Interview\n
function openScheduleInterviewModal(applicationId, candidateName) {\n
    document.getElementById('schAppId').value = applicationId;\n
    const nameEl = document.getElementById('schCandName');\n
    if (nameEl) nameEl.textContent = candidateName;\n
\n
    // Default time: tomorrow at 10:00\n
    const now = new Date();\n
    now.setDate(now.getDate() + 1);\n
    now.setHours(10, 0, 0, 0);\n
    const isoString = new Date(now.getTime() - (now.getTimezoneOffset() * 60000)).toISOString().slice(0, 16);\n
    const dtEl = document.getElementById('schDateTime');\n
    if (dtEl) dtEl.value = isoString;\n
\n
    const modal = document.getElementById('modalScheduleInterview');\n
    if (modal) modal.classList.add('active');\n
}\n
\n
async function saveInterviewSchedule(e) {\n
    e.preventDefault();\n
    const payload = {\n
        application_id: document.getElementById('schAppId')?.value,\n
        stage_code: document.getElementById('schStageCode')?.value,\n
        scheduled_at: document.getElementById('schDateTime')?.value,\n
        duration_minutes: parseInt(document.getElementById('schDuration')?.value || 45),\n
        location: document.getElementById('schLocation')?.value.trim(),\n
    };\n
\n
    try {\n
        const res = await apiFetch('/recruitment/interviews', {\n
            method: 'POST',\n
            body: JSON.stringify(payload)\n
        });\n
        if (res.status === 'success') {\n
            showToast('Jadwal interview berhasil ditetapkan!', 'success');\n
            closeModal('modalScheduleInterview');\n
            document.getElementById('formScheduleInterview')?.reset();\n
            if (state.ats.activePill === 'interviews') loadAtsInterviews();\n
            else loadAtsApplications();\n
        }\n
    } catch (err) {\n
        showToast(`Gagal menjadwalkan interview: ${err.message}`, 'error');\n
    }\n
}\n
