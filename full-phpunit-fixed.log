async function saveVacancy(e) {\n
    e.preventDefault();\n
    const payload = {\n
        title: document.getElementById('vacTitle')?.value.trim(),\n
        employment_type: document.getElementById('vacEmploymentType')?.value,\n
        experience_level: document.getElementById('vacExperienceLevel')?.value,\n
        division_id: document.getElementById('vacDivisionId')?.value || null,\n
        building_id: document.getElementById('vacBuildingId')?.value || null,\n
        quota: parseInt(document.getElementById('vacQuota')?.value || 1),\n
        salary_min: document.getElementById('vacSalaryMin')?.value || null,\n
        salary_max: document.getElementById('vacSalaryMax')?.value || null,\n
        description: document.getElementById('vacDescription')?.value.trim(),\n
        requirements: document.getElementById('vacRequirements')?.value.trim() || null,\n
    };\n
\n
    try {\n
        const res = await apiFetch('/recruitment/vacancies', {\n
            method: 'POST',\n
            body: JSON.stringify(payload)\n
        });\n
        if (res.status === 'success') {\n
            showToast('Lowongan pekerjaan baru berhasil dipublikasikan!', 'success');\n
            closeModal('modalAddVacancy');\n
            document.getElementById('formAddVacancy')?.reset();\n
            await Promise.all([loadAtsVacancies(), loadAtsMetrics()]);\n
        }\n
    } catch (err) {\n
        showToast(`Gagal membuat lowongan: ${err.message}`, 'error');\n
    }\n
}\n
