if (window.__secureGateInitialized) {\n
    console.warn('[SecureGate] Dashboard script already initialized. Skipping duplicate execution.');\n
} else {\n
window.__secureGateInitialized = true;\n
\n
const API_BASE = '/api/v1';\n
let APP_TOKEN = window.APP_CONFIG?.apiToken || '';\n
\n
// State Cache\n
let state = {\n
    doors: [],\n
    doorsLookup: [],\n
    employees: [],\n
    accessLogs: [],\n
    activityLogs: [],\n
    tasks: [],\n
    pendingRemoteUnlockDoor: null,\n
    employeePage: 1,\n
    employeePagination: null,\n
    metrics: {\n
        totalUsers: 0,\n
        activeDoors: 0,\n
        totalDoors: 4,\n
        grantedLogs: 0,\n
        deniedLogs: 0,\n
    },\n
    activeTab: 'overviewTab',\n
    selectedEmployeeForAssign: null,\n
    searchDebounceTimer: null,\n
    organization: { buildings: [], divisions: [], positions: [] },\n
    onboarding: {\n
        metrics: {},\n
        cases: [],\n
        contracts: [],\n
        documents: [],\n
        expiringContracts: [],\n
        currentCase: null\n
    },\n
};\n
\n
// = = = = =\n
// Security & Sanitization Utilities (XSS Prevention)\n
// = = = = =\n
function escapeHtml(str) {\n
    if (str === null || str === undefined) return '';\n
    return String(str)\n
        .replace(/&/g, '&amp;')\n
        .replace(/</g, '&lt;')\n
        .replace(/>/g, '&gt;')\n
        .replace(/"/g, '&quot;')\n
        .replace(/'/g, '&#039;');\n
}\n
\n
// = = = = =\n
// Toast Notification Utility\n
// = = = = =\n
function showToast(message, type = 'success', duration = 3500) {\n
    const container = document.getElementById('toastContainer');\n
    if (!container) return;\n
\n
    const toast = document.createElement('div');\n
    toast.className = `toast toast-${type}`;\n
\n
    const icons = {\n
        success: 'Γ£ô',\n
        error: 'Γ£ò',\n
        warning: 'ΓÜá',\n
        info: 'Γä╣',\n
    };\n
\n
    toast.innerHTML = `\n
        <div class="toast-icon">${icons[type] || 'Γä╣'}</div>\n
        <div class="toast-content">\n
            <div class="toast-title">${escapeHtml(type.toUpperCase())}</div>\n
            <div class="toast-message">${escapeHtml(message)}</div>\n
        </div>\n
        <button class="toast-close" onclick="this.parentElement.remove()">├ù</button>\n
    `;\n
\n
    container.appendChild(toast);\n
\n
    setTimeout(() => {\n
        toast.classList.add('toast-show');\n
    }, 10);\n
\n
    setTimeout(() => {\n
        toast.classList.remove('toast-show');\n
        setTimeout(() => toast.remove(), 300);\n
    }, duration);\n
}\n
\n
// = = = = =\n
// Modal Window Utility (Universal Modal Control)\n
// = = = = =\n
function openModal(modalId) {\n
    const modal = typeof modalId === 'string' ? document.getElementById(modalId) : modalId;\n
    if (!modal) return;\n
    modal.classList.add('active');\n
    document.body.classList.add('modal-open');\n
}\n
\n
function closeModal(modalId) {\n
    const modal = typeof modalId === 'string' ? document.getElementById(modalId) : modalId;\n
    if (!modal) return;\n
    modal.classList.remove('active');\n
    if (!document.querySelector('.modal-overlay.active')) {\n
        document.body.classList.remove('modal-open');\n
    }\n
}\n
window.openModal = openModal;\n
window.closeModal = closeModal;\n
\n
// = = = = =\n
// Centralized API Client (Fetch with Auth & Storm Guard)\n
// = = = = =\n
let isRedirectingToLogin = false;\n
const forbiddenCapabilities = new Set();\n
let rateLimitCooldownUntil = 0;\n
\n
function normalizeCapability(endpoint) {\n
    const clean = endpoint.split('?')[0].replace(/\/+$/, '');\n
    if (clean.includes('/activity-logs')) return 'audit.view';\n
    if (clean.includes('/system-accounts')) return 'system.manage';\n
    if (clean.includes('/system-health')) return 'system.view';\n
    if (clean.includes('/attendance/metrics') || clean.includes('/attendance/report')) return 'attendance.view';\n
    if (clean.includes('/check-connection') || clean.includes('/check-all') || clean.includes('/sync-hardware')) return 'device.manage';\n
    if (clean.includes('/emoney/cards')) return 'emoney.view';\n
    return clean;\n
}\n
\n
function hasCapability(capability) {\n
    const permissions = window.APP_CONFIG?.permissions || [];\n
    const role = window.APP_CONFIG?.admin?.role;\n
    if (role === 'super_admin') return true;\n
\n
    if (capability === 'audit.view') return permissions.includes('audit.view');\n
    if (capability === 'system.manage') return permissions.includes('system.manage');\n
    if (capability === 'system.view') return permissions.includes('system.view');\n
    if (capability === 'attendance.view') return permissions.includes('attendance.view');\n
    if (capability === 'device.manage') return permissions.includes('device.manage');\n
    if (capability === 'emoney.view') return permissions.includes('emoney.view');\n
\n
    return !forbiddenCapabilities.has(capability);\n
}\n
\n
async function apiFetch(endpoint, options = {}) {\n
    const capability = normalizeCapability(endpoint);\n
    const isBackground = options.isBackground !== false;\n
\n
    // 1. Permission Pre-Check: Prevent dispatching known forbidden endpoints\n
    if (forbiddenCapabilities.has(capability) || !hasCapability(capability)) {\n
        const error = new Error(`Forbidden: Access to capability [${capability}] denied.`);\n
        error.status = 403;\n
        error.suppressed = true;\n
        throw error;\n
    }\n
\n
    // 2. 429 Cooldown Guard: Prevent background request storms\n
    if (isBackground && Date.now() < rateLimitCooldownUntil) {\n
        const remainingSec = Math.ceil((rateLimitCooldownUntil - Date.now()) / 1000);\n
        const error = new Error(`Rate limit cooldown active. Skipping background request for ${remainingSec}s.`);\n
        error.status = 429;\n
        error.suppressed = true;\n
        throw error;\n
    }\n
\n
    const url = endpoint.startsWith('http') ? endpoint : `${API_BASE}${endpoint}`;\n
    const headers = {\n
        'Accept': 'application/json',\n
        ...(APP_TOKEN ? { 'Authorization': `Bearer ${APP_TOKEN}` } : {}),\n
        ...options.headers,\n
    };\n
    if (!(options.body instanceof FormData) && !headers['Content-Type'] && options.method !== 'GET' && options.method !== 'HEAD') {\n
        headers['Content-Type'] = 'application/json';\n
    }\n
\n
    try {\n
        const response = await fetch(url, { ...options, headers });\n
\n
        if (response.status === 401) {\n
            if (!isRedirectingToLogin) {\n
                isRedirectingToLogin = true;\n
                APP_TOKEN = '';\n
                if (typeof stopRealtime === 'function') stopRealtime();\n
                showToast('Sesi autentikasi telah berakhir. Mengalihkan ke halaman login...', 'error');\n
                setTimeout(() => window.location.replace('/login'), 800);\n
            }\n
            throw new Error('Unauthorized');\n
        }\n
\n
        if (response.status === 403) {\n
            forbiddenCapabilities.add(capability);\n
            const error = new Error(`Access forbidden: ${capability}`);\n
            error.status = 403;\n
            throw error;\n
        }\n
\n
        if (response.status === 429) {\n
            const retryAfterHeader = response.headers.get('Retry-After');\n
            const cooldownSec = retryAfterHeader ? Math.min(60, Math.max(5, parseInt(retryAfterHeader, 10) || 10)) : 15;\n
            rateLimitCooldownUntil = Date.now() + (cooldownSec * 1000);\n
            const error = new Error(`Rate limit reached. Backing off for ${cooldownSec} seconds.`);\n
            error.status = 429;\n
            error.retryAfter = cooldownSec;\n
            throw error;\n
        }\n
\n
        const data = await response.json().catch(() => ({}));\n
\n
        if (!response.ok) {\n
            const error = new Error(data.message || `Request failed with status ${response.status}`);\n
            error.status = response.status;\n
            throw error;\n
        }\n
\n
        return data;\n
    } catch (err) {\n
        if (err.message !== 'Unauthorized' && err.status !== 403 && err.status !== 429 && !err.suppressed) {\n
            console.error(`API Error [${endpoint}]:`, err);\n
        }\n
        throw err;\n
    }\n
}\n
\n
async function apiFetchForm(endpoint, formData) {\n
    return apiFetch(endpoint, {\n
        method: 'POST',\n
        body: formData,\n
        isBackground: false,\n
    });\n
}\n
\n
// = = = = =\n
// Centralized Metrics Scheduler (Debounced & Coalesced)\n
// = = = = =\n
let metricsDebounceTimer = null;\n
let lastMetricsFetchTime = 0;\n
\n
function scheduleMetricCardsUpdate(force = false) {\n
    if (document.hidden || isRedirectingToLogin) return;\n
    clearTimeout(metricsDebounceTimer);\n
\n
    const now = Date.now();\n
    const elapsed = now - lastMetricsFetchTime;\n
    const cooldown = 15000; // minimum 15 seconds between metrics updates\n
\n
    if (force || elapsed >= cooldown) {\n
        metricsDebounceTimer = setTimeout(updateMetricCards, 100);\n
    } else {\n
        metricsDebounceTimer = setTimeout(updateMetricCards, cooldown - elapsed);\n
    }\n
}\n
\n
async function updateMetricCards() {\n
    if (document.hidden || isRedirectingToLogin) return;\n
    lastMetricsFetchTime = Date.now();\n
\n
    try {\n
        const canViewAttendance = hasCapability('attendance.view');\n
        const [res, attendance] = await Promise.all([\n
            apiFetch('/admin/dashboard-metrics', { isBackground: true }).catch(() => null),\n
            canViewAttendance ? apiFetch('/attendance/metrics', { isBackground: true }).catch(() => null) : Promise.resolve(null),\n
        ]);\n
\n
        if (res && res.status === 'success') {\n
            const data = res.data;\n
            const activeUserMetric = document.getElementById('metricActiveEmployees');\n
            if (activeUserMetric) activeUserMetric.innerText = data.activeEmployees ?? data.totalUsers ?? 0;\n
            const userMetric = document.getElementById('metricTotalUsers');\n
            if (userMetric) userMetric.innerText = data.totalUsers ?? 0;\n
\n
            const regCredMetric = document.getElementById('metricRegisteredCredentials');\n
            if (regCredMetric) regCredMetric.innerText = data.registeredCredentials ?? 0;\n
\n
            const doorMetric = document.getElementById('metricActiveDoors');\n
            if (doorMetric) doorMetric.innerText = `${data.activeDoors ?? 0} / ${data.totalDoors ?? 0}`;\n
\n
            const deniedMetric = document.getElementById('metricDeniedLogs');\n
            if (deniedMetric) deniedMetric.innerText = data.deniedLogs ?? 0;\n
        }\n
\n
        if (attendance && attendance.success) {\n
            const today = attendance.data?.today || {};\n
            const values = {\n
                metricAttendancePresent: Number(today.present || 0) + Number(today.late || 0),\n
                metricAttendanceLate: Number(today.late || 0),\n
                metricAttendanceAbsent: Number(today.absent || 0),\n
                metricAttendanceCheckout: Number(today.checkout || 0),\n
            };\n
            Object.entries(values).forEach(([id, value]) => {\n
                const element = document.getElementById(id);\n
                if (element) element.innerText = value;\n
            });\n
        }\n
    } catch (_) {\n
        // Silently caught; metrics updates must never break UI flow\n
    }\n
}\n
\n
// = = = = =\n
// Section 1: Doors Monitoring & Control\n
// = = = = =\n
async function loadDoors() {\n
    const grid = document.getElementById('doorsGrid');\n
    const overviewGrid = document.getElementById('overviewDoorsGrid');\n
    if (!grid && !overviewGrid) return;\n
\n
    [grid, overviewGrid].filter(Boolean).forEach(target => {\n
        target.innerHTML = '<div class="loading-td"><div class="spinner"></div> CHECKING terminal Gedung B...</div>';\n
    });\n
\n
    try {\n
        const res = await apiFetch('/admin/doors');\n
        if (res.status === 'success') {\n
            state.doors = res.data;\n
            renderDoorCards(state.doors);\n
            refreshDoorFilters(state.doors);\n
            scheduleMetricCardsUpdate();\n
        }\n
    } catch (err) {\n
        if (grid) grid.innerHTML = `<div class="error-placeholder">Gagal memuat status pintu: ${err.message}</div>`;\n
        if (overviewGrid) overviewGrid.innerHTML = `<div class="error-placeholder">Gagal memuat status pintu: ${err.message}</div>`;\n
    }\n
}\n
\n
function refreshDoorFilters(doors) {\n
    const filters = [\n
        [document.getElementById('employeeDoorFilter'), 'Semua Hak Akses Pintu'],\n
        [document.getElementById('logDoorFilter'), 'Semua Pintu'],\n
        [document.getElementById('logDoorFilterTab'), 'Semua Pintu'],\n
    ];\n
    filters.forEach(([select, label]) => {\n
        if (!select) return;\n
        const selected = select.value;\n
        select.innerHTML = `<option value="">${label}</option>` + doors.map(door => {\n
            const id = escapeHtml(door.door_id);\n
            const location = escapeHtml(door.building_name || door.location || '-');\n
            return `<option value="${id}">${id} (${location})</option>`;\n
        }).join('');\n
        if (Array.from(select.options).some(option => option.value === selected)) select.value = selected;\n
    });\n
}\n
\n
function remoteUnlockAllowed(door) {\n
    return Boolean(door?.remote_unlock_allowed ?? (\n
        String(door?.health_status || door?.connection_status || door?.status || '').toLowerCase() === 'online' &&\n
        !door?.is_manual_override && Boolean(door?.device_ip || door?.ip_address)\n
    ));\n
}\n
\n
const remoteUnlockPending = new Set();\n
\n
function renderDoorCards(doors) {\n
    const renderTargets = [document.getElementById('doorsGrid'), document.getElementById('overviewDoorsGrid')].filter(Boolean);\n
    if (renderTargets.length === 0) return;\n
\n
    if (!Array.isArray(doors) || doors.length === 0) {\n
        renderTargets.forEach(target => target.innerHTML = '<div class="empty-td">Belum ada terminal pintu terkonfigurasi.</div>');\n
        return;\n
    }\n
\n
    const canManageDevices = (window.APP_CONFIG?.permissions || []).includes('device.manage');\n
    const html = doors.map(door => {\n
        const healthStatus = door.normalized_health_status || String(door.health_status || door.connection_status || door.status || 'offline').toLowerCase();\n
        const isOnline = remoteUnlockAllowed(door);\n
        const unlockDisabled = !isOnline;\n
        const isMaintenance = Boolean(door.is_manual_override);\n
        const badgeClass = isMaintenance ? 'status-warning' : (isOnline ? 'status-online' : 'status-offline');\n
        const statusLabel = isMaintenance ? 'MAINTENANCE' : (healthStatus === 'auth_error' ? 'AUTH ERROR' : (isOnline ? 'ONLINE' : 'OFFLINE'));\n
        const safeDoorId = escapeHtml(door.door_id);\n
        const safeDoorName = escapeHtml(door.door_name || door.name || 'Tanpa nama');\n
        const safeLocation = escapeHtml(door.building_name || door.location || '-');\n
        const safeDeviceIp = escapeHtml(door.device_ip || '-');\n
        const safeModel = escapeHtml(door.device_model || 'DS-K1T804AMF');\n
        const safeTotalUsers = Number(door.total_assigned_users || door.employees_count || door.door_assignments_count) || 0;\n
        const lastCheckedStr = door.last_checked_at\n
            ? new Date(door.last_checked_at).toLocaleString('id-ID', { dateStyle: 'short', timeStyle: 'medium' })\n
            : 'Belum pernah diperiksa';\n
\n
        const safeEventCount = Number(door.event_count || 0);\n
\n
        return `\n
            <article class="card door-card" data-door-id="${safeDoorId}" data-connection-state="${statusLabel.toLowerCase()}">\n
                <div class="card-header">\n
                    <div class="door-code-badge"><span class="door-chip">${safeDoorId}</span><span class="door-loc">${safeLocation}</span></div>\n
                    <span class="status-badge ${badgeClass}"><span class="status-dot"></span> ${statusLabel}</span>\n
                </div>\n
                <div class="card-value door-name-title">${safeDoorName}</div>\n
                ${!isPrimaryDeploymentDoor ? '<div class="maintenance-note">Gedung B deployment target hanya. Terminal ini planned / not active.</div>' : ''}\n
                ${isMaintenance ? '<div class="maintenance-note">ΓÜá Maintenance override aktif ΓÇö status koneksi tetap berasal dari terminal.</div>' : ''}\n
                <div class="door-specs">\n
                    <div class="spec-item"><span class="spec-label">IP Terminal</span><code class="spec-code">${safeDeviceIp}</code></div>\n
                    <div class="spec-item"><span class="spec-label">Hardware</span><span class="spec-val">${safeModel}</span></div>\n
                    <div class="spec-item"><span class="spec-label">Assigned Users</span><span class="spec-val highlight">${safeTotalUsers} Pegawai</span></div>\n
                    <div class="spec-item"><span class="spec-label">Total Events</span><span class="spec-val highlight">${safeEventCount} Event Logs</span></div>\n
                    <div class="spec-item"><span class="spec-label">Last Communication</span><span class="spec-val">${escapeHtml(lastCheckedStr)}</span></div>\n
                </div>\n
                <div class="door-actions">\n
                    ${canManageDevices ? `<button class="btn-action" onclick="openFacilityModal('${safeDoorId}')">Γ£Ä Edit</button>` : ''}\n
                    ${canManageDevices ? `<button class="btn-action" onclick="toggleDoorStatus('${safeDoorId}', ${!isMaintenance})">ΓÜí ${isMaintenance ? 'End Maintenance' : 'Maintenance'}</button>` : ''}\n
                    ${canManageDevices ? `<button type="button" class="btn-action btn-unlock" data-action="remote-unlock" data-door-id="${safeDoorId}" aria-label="Buka ${safeDoorName} dari jarak jauh" aria-busy="false" ${unlockDisabled ? 'disabled aria-disabled="true" title="Terminal belum terhubung"' : 'title="Buka relay pintu melalui konfirmasi"'}>≡ƒöô Remote Unlock</button>` : ''}\n
                    ${canManageDevices ? `<button class="btn-action btn-ping" onclick="pingSingleDoor('${safeDoorId}', this)" title="Pemeriksaan ISAPI eksplisit">≡ƒôí Diagnose</button>` : ''}\n
                    <button class="btn-action" onclick="openDoorLogs('${safeDoorId}')">View Logs</button>\n
                    <button class="btn-action" onclick="openDoorUsers('${safeDoorId}')">Sync Users</button>\n
                </div>\n
            </article>`;\n
    }).join('');\n
\n
    renderTargets.forEach(target => target.innerHTML = html);\n
}\n
\n
async function toggleDoorStatus(doorId, enabled) {\n
    try {\n
        const res = await apiFetch(`/admin/doors/${encodeURIComponent(doorId)}/status`, {\n
            method: 'PATCH',\n
            body: JSON.stringify({ is_manual_override: Boolean(enabled) }),\n
            isBackground: false\n
        });\n
        if (res.status === 'success') {\n
            showToast(res.message || `Mode maintenance ${enabled ? 'diaktifkan' : 'dinonaktifkan'} untuk ${doorId}.`, 'success');\n
            await loadDoors();\n
        } else {\n
            showToast(res.message || 'Perubahan maintenance tidak dapat disimpan.', 'error');\n
        }\n
    } catch (err) {\n
        showToast(err.message || 'Perubahan maintenance tidak dapat disimpan.', 'error');\n
    }\n
}\n
\n
function openDoorLogs(doorId) {\n
    ['logDoorFilter', 'logDoorFilterTab'].forEach(id => {\n
        const filter = document.getElementById(id);\n
        if (filter) filter.value = doorId;\n
    });\n
    switchTab('logsTab');\n
    loadAccessLogs();\n
}\n
\n
function openDoorUsers(doorId) {\n
    const filter = document.getElementById('employeeDoorFilter');\n
    if (filter) filter.value = doorId;\n
    switchTab('employeesTab');\n
    loadEmployees();\n
}\n
\n
function onRemoteUnlockDoorChange(doorId) {\n
    const door = (state.doors || []).find(item => String(item.door_id) === String(doorId)) || state.doors?.[0];\n
    state.pendingRemoteUnlockDoor = door || null;\n
\n
    const titleEl = document.getElementById('remoteUnlockDoorIdentity');\n
    const codeEl = document.getElementById('remoteUnlockDoorCode');\n
    const locEl = document.getElementById('remoteUnlockDoorLocation');\n
    const statusEl = document.getElementById('remoteUnlockDoorStatus');\n
    const btnEl = document.getElementById('confirmRemoteUnlockButton');\n
\n
    if (!door) {\n
        if (titleEl) titleEl.textContent = 'Pilih terminal pintu.';\n
        if (codeEl) codeEl.textContent = '-';\n
        if (locEl) locEl.textContent = '-';\n
        if (statusEl) statusEl.textContent = '-';\n
        if (btnEl) btnEl.disabled = true;\n
        return;\n
    }\n
\n
    const isOnline = remoteUnlockAllowed(door);\n
\n
    if (titleEl) titleEl.textContent = door.door_name || door.name || door.door_id;\n
    if (codeEl) codeEl.textContent = door.door_id;\n
    if (locEl) locEl.textContent = door.building_name || door.location || '-';\n
    if (statusEl) {\n
        statusEl.textContent = isOnline ? 'ONLINE ΓÇö siap menerima perintah' : 'OFFLINE / NOT ACTIVE ΓÇö terminal belum terhubung';\n
        statusEl.style.color = isOnline ? '#6ee7b7' : '#fca5a5';\n
    }\n
    if (btnEl) {\n
        btnEl.disabled = !isOnline;\n
        btnEl.title = isOnline ? 'Konfirmasi dan kirim sinyal buka relay pintu' : 'Terminal belum terhubung / offline';\n
    }\n
}\n
\n
function openRemoteUnlockModal(doorId) {\n
    const doors = state.doors || [];\n
    const select = document.getElementById('remoteUnlockDoorSelect');\n
    if (select) {\n
        select.innerHTML = doors.map(d => {\n
            const online = remoteUnlockAllowed(d);\n
            return `<option value="${escapeHtml(d.door_id)}" ${d.door_id === doorId ? 'selected' : ''}>${escapeHtml(d.door_id)} - ${escapeHtml(d.door_name || d.name || 'Terminal')} (${online ? 'ONLINE' : 'OFFLINE'})</option>`;\n
        }).join('');\n
        if (doorId) select.value = doorId;\n
    }\n
\n
    const currentDoorId = select ? select.value : doorId;\n
    onRemoteUnlockDoorChange(currentDoorId);\n
\n
    const reasonEl = document.getElementById('remoteUnlockReason');\n
    if (reasonEl) reasonEl.value = '';\n
\n
    openModal('remoteUnlockModal');\n
}\n
\n
function cancelRemoteUnlock() {\n
    state.pendingRemoteUnlockDoor = null;\n
    const reasonEl = document.getElementById('remoteUnlockReason');\n
    if (reasonEl) reasonEl.value = '';\n
    closeModal('remoteUnlockModal');\n
}\n
\n
async function confirmRemoteUnlock() {\n
    const door = state.pendingRemoteUnlockDoor;\n
    const button = document.getElementById('confirmRemoteUnlockButton');\n
    const reasonEl = document.getElementById('remoteUnlockReason');\n
    const reason = reasonEl ? reasonEl.value.trim() : '';\n
\n
    if (!door || !button) return;\n
\n
    if (!reason) {\n
        showToast('Harap masukkan alasan pembukaan pintu sebelum melanjutkan.', 'warning');\n
        if (reasonEl) reasonEl.focus();\n
        return;\n
    }\n
\n
    if (!remoteUnlockAllowed(door)) {\n
        showToast(`Remote unlock diblokir: Terminal ${door.door_id} belum online.`, 'warning');\n
        return;\n
    }\n
\n
    button.disabled = true;\n
    button.textContent = 'ΓÅ│ Mengirim perintah...';\n
    try {\n
        const res = await apiFetch(`/admin/doors/${encodeURIComponent(door.door_id)}/open`, {\n
            method: 'POST',\n
            isBackground: false,\n
            body: JSON.stringify({ reason })\n
        });\n
        if (res.status === 'success') {\n
            showToast(res.message || `Perintah remote unlock ${door.door_id} berhasil dikirim.`, 'success');\n
            cancelRemoteUnlock();\n
            await Promise.all([loadDoors(), loadAccessLogs()]);\n
            scheduleMetricCardsUpdate(true);\n
            if (hasCapability('audit.view')) await loadActivityLogs();\n
        } else {\n
            showToast(res.message || 'Remote unlock gagal.', 'error');\n
        }\n
    } catch (err) {\n
        showToast(err.message || 'Remote unlock gagal. Periksa izin dan koneksi terminal, lalu coba kembali.', 'error');\n
    } finally {\n
        button.disabled = false;\n
        button.textContent = 'Konfirmasi & Buka Pintu';\n
    }\n
}\n
\n
async function executeRemoteUnlock(button) {\n
    const doorId = button?.dataset.doorId;\n
    const door = (state.doors || []).find(item => String(item.door_id) === String(doorId));\n
    if (!door || !remoteUnlockAllowed(door) || remoteUnlockPending.has(doorId)) return;\n
\n
    remoteUnlockPending.add(doorId);\n
    const originalText = button.innerHTML;\n
    const requestKey = `remote-unlock-${doorId}-${crypto.randomUUID?.() || Date.now()}`;\n
    button.disabled = true;\n
    button.setAttribute('aria-busy', 'true');\n
    button.innerHTML = 'Membuka...';\n
    try {\n
        const res = await apiFetch(`/admin/doors/${encodeURIComponent(doorId)}/open`, {\n
            method: 'POST',\n
            isBackground: false,\n
            headers: { 'X-Idempotency-Key': requestKey },\n
            body: JSON.stringify({ reason: 'Remote unlock dari dashboard' })\n
        });\n
        if (res.status !== 'success') throw new Error(res.message || 'Remote unlock gagal.');\n
        showToast(`${door.door_name || door.name || doorId} berhasil dibuka`, 'success');\n
        await loadDoors();\n
    } catch (err) {\n
        console.error('[SecureGate] Remote unlock failed:', err);\n
        showToast(err.message || 'Remote unlock gagal. Periksa izin dan koneksi terminal.', 'error');\n
    } finally {\n
        remoteUnlockPending.delete(doorId);\n
        button.disabled = !remoteUnlockAllowed(door);\n
        button.setAttribute('aria-busy', 'false');\n
        button.innerHTML = originalText;\n
    }\n
}\n
\n
function registerRemoteUnlockHandler() {\n
    if (window.__secureGateRemoteUnlockHandler) return;\n
    window.__secureGateRemoteUnlockHandler = true;\n
    document.addEventListener('click', event => {\n
        const button = event.target.closest('[data-action="remote-unlock"]');\n
        if (!button || button.disabled) return;\n
        event.preventDefault();\n
        executeRemoteUnlock(button);\n
    });\n
}\n
\n
registerRemoteUnlockHandler();\n
