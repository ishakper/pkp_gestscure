\n
function switchAssetSubTab(subTab, btn) {\n
    document.querySelectorAll('#assetsTab .ats-subnav .subnav-btn').forEach(b => b.classList.remove('active'));\n
    if (btn) btn.classList.add('active');\n
\n
    const subs = {\n
        'inventory': 'assetSubInventory',\n
        'assignments': 'assetSubAssignments',\n
        'maintenances': 'assetSubMaintenances',\n
        'incidents': 'assetSubIncidents'\n
    };\n
\n
    Object.values(subs).forEach(id => {\n
        const el = document.getElementById(id);\n
        if (el) el.style.display = 'none';\n
    });\n
\n
    const activeEl = document.getElementById(subs[subTab]);\n
    if (activeEl) activeEl.style.display = 'block';\n
}\n
\n
async function loadAssetsMetrics() {\n
    try {\n
        const res = await apiFetch('/assets/metrics');\n
        if (res && res.success) {\n
            const d = res.data;\n
            const elTotal = document.getElementById('metricTotalAssets');\n
            const elAvail = document.getElementById('metricAvailableAssets');\n
            const elAsg = document.getElementById('metricAssignedAssets');\n
            const elMnt = document.getElementById('metricMaintenanceAssets');\n
            const elLost = document.getElementById('metricLostDamagedAssets');\n
            const elWarr = document.getElementById('metricExpiringWarranties');\n
\n
            if (elTotal) elTotal.innerText = d.total_assets ?? 0;\n
            if (elAvail) elAvail.innerText = d.available_assets ?? 0;\n
            if (elAsg) elAsg.innerText = d.assigned_assets ?? 0;\n
            if (elMnt) elMnt.innerText = d.maintenance_assets ?? 0;\n
            if (elLost) elLost.innerText = d.lost_or_damaged_assets ?? 0;\n
            if (elWarr) elWarr.innerText = d.expiring_warranties ?? 0;\n
        }\n
    } catch (e) {\n
        console.error('Failed to load asset metrics', e);\n
    }\n
}\n
\n
async function loadAssetsCategories() {\n
    try {\n
        const res = await apiFetch('/assets/categories');\n
        if (res && res.success && Array.isArray(res.data)) {\n
            const filterEl = document.getElementById('assetCategoryFilter');\n
            const formEl = document.getElementById('assetFormCategory');\n
\n
            const options = res.data.map(c => `<option value="${c.id}">${escapeHtml(c.name)}</option>`).join('');\n
\n
            if (filterEl) {\n
                filterEl.innerHTML = '<option value="">Semua Kategori</option>' + options;\n
            }\n
            if (formEl) {\n
                formEl.innerHTML = '<option value="">-- Pilih Kategori --</option>' + options;\n
            }\n
        }\n
    } catch (e) {\n
        console.error('Failed to load asset categories', e);\n
    }\n
}\n
\n
function getAssetStatusBadge(status) {\n
    const s = String(status || '').toUpperCase();\n
    const map = {\n
        'AVAILABLE': '<span class="badge badge-success" style="background: rgba(16, 185, 129, 0.2); color: #34d399;">Tersedia</span>',\n
        'ASSIGNED': '<span class="badge badge-info" style="background: rgba(56, 189, 248, 0.2); color: #38bdf8;">Dipinjam</span>',\n
        'MAINTENANCE': '<span class="badge badge-warning" style="background: rgba(245, 158, 11, 0.2); color: #fcd34d;">Servis</span>',\n
        'REPAIR': '<span class="badge badge-warning" style="background: rgba(245, 158, 11, 0.2); color: #fcd34d;">Perbaikan</span>',\n
        'LOST': '<span class="badge badge-danger" style="background: rgba(239, 68, 68, 0.2); color: #f87171;">Hilang</span>',\n
        'DAMAGED': '<span class="badge badge-danger" style="background: rgba(239, 68, 68, 0.2); color: #f87171;">Rusak</span>',\n
        'DISPOSED': '<span class="badge badge-dim" style="background: rgba(148, 163, 184, 0.2); color: #94a3b8;">Dihapus Buku</span>',\n
    };\n
    return map[s] || `<span class="badge badge-dim">${escapeHtml(s)}</span>`;\n
}\n
\n
function getAssetConditionBadge(condition) {\n
    const c = String(condition || '').toUpperCase();\n
    const map = {\n
        'NEW': '<span style="font-weight: 700; color: #10b981;">NEW</span>',\n
        'GOOD': '<span style="font-weight: 600; color: #38bdf8;">GOOD</span>',\n
        'FAIR': '<span style="font-weight: 600; color: #f59e0b;">FAIR</span>',\n
        'POOR': '<span style="font-weight: 600; color: #f97316;">POOR</span>',\n
        'DAMAGED': '<span style="font-weight: 700; color: #ef4444;">DAMAGED</span>',\n
    };\n
    return map[c] || `<span>${escapeHtml(c)}</span>`;\n
}\n
\n
async function loadAssetsInventory() {\n
    const tbody = document.getElementById('assetsTableBody');\n
    if (!tbody) return;\n
\n
    try {\n
        const search = document.getElementById('assetSearch')?.value || '';\n
        const categoryId = document.getElementById('assetCategoryFilter')?.value || '';\n
        const status = document.getElementById('assetStatusFilter')?.value || '';\n
        const condition = document.getElementById('assetConditionFilter')?.value || '';\n
\n
        const params = new URLSearchParams();\n
        if (search) params.append('search', search);\n
        if (categoryId) params.append('category_id', categoryId);\n
        if (status) params.append('status', status);\n
        if (condition) params.append('condition', condition);\n
\n
        const res = await apiFetch(`/assets?${params.toString()}`);\n
        if (!res || !res.success || !res.data.length) {\n
            tbody.innerHTML = `<tr><td colspan="8" style="text-align: center; color: var(--text-muted); padding: 2.5rem;">Tidak ada aset inventaris yang sesuai dengan filter.</td></tr>`;\n
            return;\n
        }\n
\n
        tbody.innerHTML = res.data.map(a => {\n
            const safeId = a.id;\n
            const code = escapeHtml(a.asset_code);\n
            const name = escapeHtml(a.asset_name);\n
            const catName = escapeHtml(a.category?.name || 'Umum');\n
            const brandModel = `${escapeHtml(a.brand || '-')} / ${escapeHtml(a.model || '-')}`;\n
            const maskedSerial = escapeHtml(a.masked_serial_number || 'Tidak Ada');\n
            const loc = `${escapeHtml(a.building_name || '-')}<br><small style="color: var(--text-dim);">${escapeHtml(a.location || 'Semua Ruang')}</small>`;\n
            const statusBadge = getAssetStatusBadge(a.status);\n
            const condBadge = getAssetConditionBadge(a.condition);\n
\n
            let actions = `\n
                <button class="btn-sm btn-secondary" onclick="showAssetDetail(${safeId})" title="Lihat Detail & Riwayat 360">≡ƒæü∩╕Å Detail</button>\n
            `;\n
\n
            if (a.status !== 'DISPOSED') {\n
                actions += ` <button class="btn-sm btn-edit" onclick="openEditAssetModal(${safeId})" title="Edit Data Aset">Γ£Å∩╕Å Edit</button>`;\n
            }\n
\n
            if (a.status === 'AVAILABLE') {\n
                actions += ` <button class="btn-sm btn-primary" onclick="openAssignSpecificAsset(${safeId})" title="Alokasikan ke Karyawan / Intern">≡ƒôï Serahkan</button>`;\n
                actions += ` <button class="btn-sm btn-secondary" onclick="openMaintenanceSpecificAsset(${safeId})" title="Buka Tiket Servis">≡ƒöº Servis</button>`;\n
                actions += ` <button class="btn-sm btn-delete" onclick="openDisposeAssetModal(${safeId})" title="Hapus Buku (Disposal)">≡ƒùæ∩╕Å Hapus</button>`;\n
            } else if (a.status === 'ASSIGNED') {\n
                actions += ` <button class="btn-sm btn-secondary" onclick="openIncidentSpecificAsset(${safeId})" title="Laporkan Kerusakan/Kehilangan">ΓÜá∩╕Å Insiden</button>`;\n
            } else if (a.status === 'DAMAGED') {\n
                actions += ` <button class="btn-sm btn-secondary" onclick="openMaintenanceSpecificAsset(${safeId})" title="Buka Tiket Servis">≡ƒöº Servis</button>`;\n
                actions += ` <button class="btn-sm btn-delete" onclick="openDisposeAssetModal(${safeId})" title="Hapus Buku (Disposal)">≡ƒùæ∩╕Å Hapus</button>`;\n
            }\n
\n
            return `\n
                <tr>\n
                    <td><strong style="color: var(--primary); font-family: monospace;">${code}</strong></td>\n
                    <td>\n
                        <div style="font-weight: 600; color: #ffffff;">${name}</div>\n
                        <div style="font-size: 0.775rem; color: var(--text-muted);">${catName}</div>\n
                    </td>\n
                    <td>${brandModel}</td>\n
                    <td><code style="background: rgba(0,0,0,0.3); padding: 2px 6px; border-radius: 4px; color: #a5f3fc;">${maskedSerial}</code></td>\n
                    <td>${loc}</td>\n
                    <td>${condBadge}</td>\n
                    <td>${statusBadge}</td>\n
                    <td style="text-align: right; white-space: nowrap;">${actions}</td>\n
                </tr>\n
            `;\n
        }).join('');\n
    } catch (e) {\n
        console.error('Failed to load asset inventory', e);\n
        tbody.innerHTML = `<tr><td colspan="8" class="error-td">Gagal memuat data inventaris aset: ${escapeHtml(e.message)}</td></tr>`;\n
    }\n
}\n
\n
async function loadAssetAssignments() {\n
    const tbody = document.getElementById('assetAssignmentsTableBody');\n
    if (!tbody) return;\n
\n
    try {\n
        const status = document.getElementById('assetAssignmentStatusFilter')?.value || '';\n
        const params = new URLSearchParams();\n
        if (status) params.append('status', status);\n
\n
        const res = await apiFetch(`/assets/assignments?${params.toString()}`);\n
        if (!res || !res.success || !res.data.length) {\n
            tbody.innerHTML = `<tr><td colspan="9" style="text-align: center; color: var(--text-muted); padding: 2.5rem;">Belum ada riwayat alokasi aset.</td></tr>`;\n
            return;\n
        }\n
\n
        tbody.innerHTML = res.data.map(asg => {\n
            const asgNum = escapeHtml(asg.assignment_number);\n
            const assetInfo = `<strong>${escapeHtml(asg.asset?.asset_code || '-')}</strong><br><small style="color: var(--text-muted);">${escapeHtml(asg.asset?.asset_name || '-')}</small>`;\n
            const assignee = asg.employee\n
                ? `<div>${escapeHtml(asg.employee.name)} <span style="font-size: 0.725rem; color: var(--primary);">[Karyawan]</span></div>`\n
                : (asg.internship ? `<div>${escapeHtml(asg.internship.intern_id)} <span style="font-size: 0.725rem; color: #c084fc;">[Intern]</span></div>` : '-');\n
            const asgDate = asg.assigned_at ? asg.assigned_at.substring(0, 10) : '-';\n
            const expDate = asg.expected_return_date ? asg.expected_return_date.substring(0, 10) : '<span style="color: var(--text-dim);">-</span>';\n
            const condOut = getAssetConditionBadge(asg.condition_out);\n
            const condIn = asg.condition_in ? getAssetConditionBadge(asg.condition_in) : '<span style="color: var(--text-dim);">-</span>';\n
            const statusBadge = asg.status === 'ACTIVE'\n
                ? '<span class="badge badge-info" style="background: rgba(56, 189, 248, 0.2); color: #38bdf8;">ACTIVE</span>'\n
                : '<span class="badge badge-success" style="background: rgba(16, 185, 129, 0.2); color: #34d399;">RETURNED</span>';\n
\n
            let actions = '';\n
            if (asg.status === 'ACTIVE') {\n
                actions = `<button class="btn-sm btn-primary" onclick="openReturnAssetModal(${asg.id})">≡ƒöä Kembalikan</button>`;\n
            } else {\n
                actions = `<span style="color: var(--text-muted); font-size: 0.8rem;">Selesai (${(asg.actual_return_date || '').substring(0, 10)})</span>`;\n
            }\n
\n
            return `\n
                <tr>\n
                    <td><span style="font-family: monospace; color: #a5b4fc;">${asgNum}</span></td>\n
                    <td>${assetInfo}</td>\n
                    <td>${assignee}</td>\n
                    <td>${asgDate}</td>\n
                    <td>${expDate}</td>\n
                    <td>${condOut}</td>\n
                    <td>${condIn}</td>\n
                    <td>${statusBadge}</td>\n
                    <td style="text-align: right; white-space: nowrap;">${actions}</td>\n
                </tr>\n
            `;\n
        }).join('');\n
    } catch (e) {\n
        console.error('Failed to load asset assignments', e);\n
        tbody.innerHTML = `<tr><td colspan="9" class="error-td">Gagal memuat penugasan aset: ${escapeHtml(e.message)}</td></tr>`;\n
    }\n
}\n
\n
async function loadAssetMaintenances() {\n
    const tbody = document.getElementById('assetMaintenancesTableBody');\n
    if (!tbody) return;\n
\n
    try {\n
        const status = document.getElementById('assetMaintenanceStatusFilter')?.value || '';\n
        const params = new URLSearchParams();\n
        if (status) params.append('status', status);\n
\n
        const res = await apiFetch(`/assets/maintenances?${params.toString()}`);\n
        if (!res || !res.success || !res.data.length) {\n
            tbody.innerHTML = `<tr><td colspan="9" style="text-align: center; color: var(--text-muted); padding: 2.5rem;">Tidak ada catatan pemeliharaan atau tiket servis aset.</td></tr>`;\n
            return;\n
        }\n
\n
        tbody.innerHTML = res.data.map(m => {\n
            const num = escapeHtml(m.maintenance_number);\n
            const assetCode = escapeHtml(m.asset?.asset_code || '-');\n
            const type = `<span class="badge" style="background: rgba(99, 102, 241, 0.15); color: #a5b4fc;">${escapeHtml(m.maintenance_type)}</span>`;\n
            const issue = escapeHtml(m.issue_description);\n
            const vendor = escapeHtml(m.vendor || 'Internal IT');\n
            const cost = Number(m.cost || 0).toLocaleString('id-ID');\n
            const openedAt = m.opened_at ? m.opened_at.substring(0, 10) : '-';\n
            const statusBadge = m.status === 'COMPLETED'\n
                ? '<span class="badge badge-success" style="background: rgba(16, 185, 129, 0.2); color: #34d399;">COMPLETED</span>'\n
                : '<span class="badge badge-warning" style="background: rgba(245, 158, 11, 0.2); color: #fcd34d;">OPEN</span>';\n
\n
            let actions = '';\n
            if (m.status !== 'COMPLETED') {\n
                actions = `<button class="btn-sm btn-primary" onclick="openCompleteMaintenanceModal(${m.id})">Γ£à Selesaikan</button>`;\n
            } else {\n
                actions = `<span style="color: var(--text-muted); font-size: 0.8rem;">Tuntas</span>`;\n
            }\n
\n
            return `\n
                <tr>\n
                    <td><span style="font-family: monospace; color: #fcd34d;">${num}</span></td>\n
                    <td><strong>${assetCode}</strong></td>\n
                    <td>${type}</td>\n
                    <td style="max-width: 250px;">${issue}</td>\n
                    <td>${vendor}</td>\n
                    <td>Rp ${cost}</td>\n
                    <td>${openedAt}</td>\n
                    <td>${statusBadge}</td>\n
                    <td style="text-align: right; white-space: nowrap;">${actions}</td>\n
                </tr>\n
            `;\n
        }).join('');\n
    } catch (e) {\n
        console.error('Failed to load asset maintenances', e);\n
        tbody.innerHTML = `<tr><td colspan="9" class="error-td">Gagal memuat catatan servis: ${escapeHtml(e.message)}</td></tr>`;\n
    }\n
}\n
\n
async function loadAssetIncidents() {\n
    const tbody = document.getElementById('assetIncidentsTableBody');\n
    if (!tbody) return;\n
\n
    try {\n
        const type = document.getElementById('assetIncidentTypeFilter')?.value || '';\n
        const status = document.getElementById('assetIncidentStatusFilter')?.value || '';\n
        const params = new URLSearchParams();\n
        if (type) params.append('incident_type', type);\n
        if (status) params.append('status', status);\n
\n
        const res = await apiFetch(`/assets/incidents?${params.toString()}`);\n
        if (!res || !res.success || !res.data.length) {\n
            tbody.innerHTML = `<tr><td colspan="8" style="text-align: center; color: var(--text-muted); padding: 2.5rem;">Tidak ada laporan insiden aset yang tercatat.</td></tr>`;\n
            return;\n
        }\n
\n
        tbody.innerHTML = res.data.map(inc => {\n
            const incNum = escapeHtml(inc.incident_number);\n
            const assetCode = escapeHtml(inc.asset?.asset_code || '-');\n
            const incType = `<span class="badge" style="background: rgba(239, 68, 68, 0.2); color: #f87171;">${escapeHtml(inc.incident_type)}</span>`;\n
            const reporter = escapeHtml(inc.employee?.name || inc.reported_by_admin?.name || 'Staf Operasional');\n
            const desc = `${escapeHtml(inc.description)}<br><small style="color: var(--text-dim);">${escapeHtml(inc.location || '-')}</small>`;\n
            const date = inc.incident_date ? inc.incident_date.substring(0, 10) : '-';\n
            const statusBadge = inc.status === 'RESOLVED'\n
                ? '<span class="badge badge-success" style="background: rgba(16, 185, 129, 0.2); color: #34d399;">RESOLVED</span>'\n
                : '<span class="badge badge-danger" style="background: rgba(239, 68, 68, 0.2); color: #f87171;">REPORTED</span>';\n
\n
            let actions = '';\n
            if (inc.status !== 'RESOLVED') {\n
                actions = `<button class="btn-sm btn-primary" onclick="openResolveIncidentModal(${inc.id})">≡ƒ¢í∩╕Å Selesaikan</button>`;\n
            } else {\n
                actions = `<span style="color: var(--text-muted); font-size: 0.8rem;">Resolved</span>`;\n
            }\n
\n
            return `\n
                <tr>\n
                    <td><span style="font-family: monospace; color: #f87171;">${incNum}</span></td>\n
                    <td><strong>${assetCode}</strong></td>\n
                    <td>${incType}</td>\n
                    <td>${reporter}</td>\n
                    <td style="max-width: 250px;">${desc}</td>\n
                    <td>${date}</td>\n
                    <td>${statusBadge}</td>\n
                    <td style="text-align: right; white-space: nowrap;">${actions}</td>\n
                </tr>\n
            `;\n
        }).join('');\n
    } catch (e) {\n
        console.error('Failed to load asset incidents', e);\n
        tbody.innerHTML = `<tr><td colspan="8" class="error-td">Gagal memuat insiden aset: ${escapeHtml(e.message)}</td></tr>`;\n
    }\n
}\n
