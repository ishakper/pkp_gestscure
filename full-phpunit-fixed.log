async function loadCredentials() {\n
    const tbody = document.getElementById('credentialsTableBody');\n
    if (!tbody) return;\n
\n
    try {\n
        const search = document.getElementById('credentialSearch')?.value || '';\n
        const type = document.getElementById('credentialTypeFilter')?.value || '';\n
        const params = new URLSearchParams();\n
        if (search) params.append('search', search);\n
        if (type) params.append('credential_type', type);\n
\n
        const res = await apiFetch(`/access/credentials?${params.toString()}`);\n
        if (!res || !res.success || !res.data.length) {\n
            tbody.innerHTML = `<tr><td colspan="8" style="text-align: center; color: var(--text-muted); padding: 2rem;">Belum ada data kredensial terdaftar.</td></tr>`;\n
            return;\n
        }\n
\n
        tbody.innerHTML = res.data.map(c => {\n
            const empName = c.employee?.name || (c.internship ? `[Intern] ${c.internship.intern_id}` : '-');\n
            const bioBadge = `<span class="badge" style="background: rgba(56,189,248,0.15); color: #38bdf8;">${escapeHtml(c.biometric_status || 'NOT_ENROLLED')}</span>`;\n
            const statusBadge = c.status === 'ACTIVE'\n
                ? '<span class="badge" style="background: rgba(16,185,129,0.2); color: #10b981;">ACTIVE</span>'\n
                : '<span class="badge" style="background: rgba(239,68,68,0.2); color: #ef4444;">REVOKED</span>';\n
            const issuedAt = c.issued_at ? c.issued_at.substring(0, 10) : '-';\n
\n
            let actions = '';\n
            if (c.status === 'ACTIVE') {\n
                actions = `<button class="btn-secondary" style="padding: 0.35rem 0.65rem; font-size: 0.75rem; color: #ef4444; border-color: #ef4444;" onclick="openRevokeCredentialModal(${c.id})">Cabut</button>`;\n
            } else {\n
                actions = `<span style="font-size: 0.75rem; color: var(--text-muted);">${escapeHtml(c.revocation_reason || 'Dicabut')}</span>`;\n
            }\n
\n
            return `\n
                <tr>\n
                    <td style="font-weight: 700; color: #38bdf8;">${escapeHtml(c.credential_number)}</td>\n
                    <td style="font-weight: 600; color: #fff;">${escapeHtml(empName)}</td>\n
                    <td>${escapeHtml(c.credential_type)}</td>\n
                    <td style="font-family: monospace; font-size: 0.85rem; color: #fbbf24;">${escapeHtml(c.masked_identifier)}</td>\n
                    <td>${bioBadge}</td>\n
                    <td>${statusBadge}</td>\n
                    <td style="font-size: 0.8rem; color: var(--text-muted);">${escapeHtml(issuedAt)}</td>\n
                    <td style="text-align: right;">${actions}</td>\n
                </tr>\n
            `;\n
        }).join('');\n
    } catch (e) {\n
        tbody.innerHTML = `<tr><td colspan="8" style="text-align: center; color: #ef4444; padding: 2rem;">Gagal memuat kredensial: ${escapeHtml(e.message)}</td></tr>`;\n
        return false;\n
    }\n
}\n
\n
async function loadDeviceSyncs() {\n
    const tbody = document.getElementById('deviceSyncsTableBody');\n
    if (!tbody) return;\n
\n
    try {\n
        const status = document.getElementById('deviceSyncStatusFilter')?.value || '';\n
        const params = new URLSearchParams();\n
        if (status) params.append('status', status);\n
\n
        const res = await apiFetch(`/access/device-syncs?${params.toString()}`);\n
        if (!res || !res.success || !res.data.length) {\n
            tbody.innerHTML = `<tr><td colspan="8" style="text-align: center; color: var(--text-muted); padding: 2rem;">Antrean sinkronisasi perangkat kosong. Semua terminal dalam status tersinkron.</td></tr>`;\n
            return;\n
        }\n
\n
        tbody.innerHTML = res.data.map(s => {\n
            const doorName = s.door ? `${s.door.door_id} - ${s.door.name || s.door.door_name}` : `Door #${s.door_id}`;\n
            const crdRef = s.credential_record?.credential_number || `CRD #${s.credential_record_id}`;\n
            const syncTime = s.completed_at ? s.completed_at.substring(0, 19).replace('T', ' ') : (s.last_attempt_at ? s.last_attempt_at.substring(0, 19).replace('T', ' ') : '-');\n
\n
            let statusBadge = '';\n
            if (s.status === 'SUCCESS') statusBadge = '<span class="badge" style="background: rgba(16,185,129,0.2); color: #10b981;">SUCCESS</span>';\n
            else if (s.status === 'QUEUED') statusBadge = '<span class="badge" style="background: rgba(56,189,248,0.2); color: #38bdf8;">QUEUED</span>';\n
            else if (s.status === 'FAILED') statusBadge = '<span class="badge" style="background: rgba(239,68,68,0.2); color: #ef4444;">FAILED</span>';\n
            else statusBadge = `<span class="badge">${escapeHtml(s.status)}</span>`;\n
\n
            let actions = '';\n
            if (s.status === 'FAILED' || s.status === 'QUEUED') {\n
                actions = `<button class="btn-primary" style="padding: 0.35rem 0.65rem; font-size: 0.75rem;" onclick="retryDeviceSyncItem(${s.id})">≡ƒöä Sync Ulang</button>`;\n
            } else {\n
                actions = `<span style="font-size: 0.75rem; color: #10b981;">Γ£ô Synced</span>`;\n
            }\n
\n
            return `\n
                <tr>\n
                    <td style="font-weight: 600; color: #fff;">${escapeHtml(doorName)}</td>\n
                    <td><span class="badge" style="background: rgba(245,158,11,0.2); color: #fbbf24;">${escapeHtml(s.operation)}</span></td>\n
                    <td style="color: #38bdf8;">${escapeHtml(crdRef)}</td>\n
                    <td>${statusBadge}</td>\n
                    <td style="font-size: 0.85rem; text-align: center;">${s.attempt_count}</td>\n
                    <td style="font-family: monospace; font-size: 0.75rem; color: var(--text-muted);">${escapeHtml(s.idempotency_key)}</td>\n
                    <td style="font-size: 0.8rem; color: var(--text-muted);">${escapeHtml(syncTime)}</td>\n
                    <td style="text-align: right;">${actions}</td>\n
                </tr>\n
            `;\n
        }).join('');\n
    } catch (e) {\n
        tbody.innerHTML = `<tr><td colspan="8" style="text-align: center; color: #ef4444; padding: 2rem;">Gagal memuat antrean sync: ${escapeHtml(e.message)}</td></tr>`;\n
        return false;\n
    }\n
}\n
\n
async function loadEmoneyCards() {\n
    const tbody = document.getElementById('emoneyTableBody');\n
    if (!tbody) return;\n
\n
    const role = window.APP_CONFIG?.admin?.role;\n
    if (role !== 'super_admin' && role !== 'hrd') {\n
        tbody.innerHTML = '<tr><td colspan="7" style="text-align: center; color: var(--text-muted); padding: 2rem;">Akses E-Money tidak tersedia untuk peran ini.</td></tr>';\n
        return;\n
    }\n
\n
    try {\n
        const search = document.getElementById('emoneySearch')?.value || '';\n
        const provider = document.getElementById('emoneyProviderFilter')?.value || '';\n
        const params = new URLSearchParams();\n
        if (search) params.append('search', search);\n
        if (provider) params.append('provider', provider);\n
\n
        const res = await apiFetch(`/access/emoney?${params.toString()}`);\n
        if (!res || !res.success || !res.data.length) {\n
            tbody.innerHTML = `<tr><td colspan="7" style="text-align: center; color: var(--text-muted); padding: 2rem;">Belum ada instrumen kartu E-Money yang terdaftar.</td></tr>`;\n
            return;\n
        }\n
\n
        tbody.innerHTML = res.data.map(m => {\n
            const empName = m.employee?.name || '<span style="color: var(--text-muted); font-style: italic;">Tersedia (Stok)</span>';\n
            const statusBadge = getEmoneyStatusBadge(m.status);\n
            const issuedAt = m.issued_at ? m.issued_at.substring(0, 10) : '-';\n
\n
            let actions = '';\n
            if (m.status === 'AVAILABLE' || m.status === 'ACTIVE' || m.status === 'ASSIGNED') {\n
                actions = `\n
                    <select onchange="onEmoneyStatusSelectChanged(${m.id}, this.value)" style="padding: 0.25rem 0.5rem; font-size: 0.75rem; background: var(--card-bg); border: 1px solid var(--border-color); color: #fff; border-radius: 0.4rem;">\n
                        <option value="">Aksi Status...</option>\n
                        <option value="ACTIVE">Aktifkan</option>\n
                        <option value="SUSPENDED">Tangguhkan (Suspend)</option>\n
                        <option value="RETURNED">Kembalikan (Return)</option>\n
                        <option value="LOST">Laporkan Hilang (Lost)</option>\n
                        <option value="REVOKED">Cabut Permanen</option>\n
                    </select>\n
                `;\n
            } else {\n
                actions = `<span style="font-size: 0.75rem; color: var(--text-muted);">${escapeHtml(m.status)}</span>`;\n
            }\n
\n
            return `\n
                <tr>\n
                    <td style="font-weight: 700; color: #a855f7;">${escapeHtml(m.card_uuid)}</td>\n
                    <td style="font-weight: 600; color: #fff;">${escapeHtml(m.provider)}</td>\n
                    <td style="font-family: monospace; color: #fbbf24;">${escapeHtml(m.masked_card_number)}</td>\n
                    <td>${empName}</td>\n
                    <td>${statusBadge}</td>\n
                    <td style="font-size: 0.8rem; color: var(--text-muted);">${escapeHtml(issuedAt)}</td>\n
                    <td style="text-align: right;">${actions}</td>\n
                </tr>\n
            `;\n
        }).join('');\n
    } catch (e) {\n
        tbody.innerHTML = `<tr><td colspan="7" style="text-align: center; color: #ef4444; padding: 2rem;">Gagal memuat registri E-Money: ${escapeHtml(e.message)}</td></tr>`;\n
        return false;\n
    }\n
}\n
\n
function getAccessStatusBadge(status) {\n
    switch (status) {\n
        case 'PENDING_APPROVAL': return '<span class="badge" style="background: rgba(245,158,11,0.2); color: #fbbf24;">MENUNGGU PERSETUJUAN</span>';\n
        case 'APPROVED': return '<span class="badge" style="background: rgba(16,185,129,0.2); color: #10b981;">DISETUJUI</span>';\n
        case 'PROVISIONING': return '<span class="badge" style="background: rgba(56,189,248,0.2); color: #38bdf8;">PROVISIONING SYNC</span>';\n
        case 'ACTIVE': return '<span class="badge" style="background: rgba(16,185,129,0.25); color: #10b981;">AKTIF</span>';\n
        case 'REJECTED': return '<span class="badge" style="background: rgba(239,68,68,0.2); color: #ef4444;">DITOLAK</span>';\n
        case 'REVOKED': return '<span class="badge" style="background: rgba(156,163,175,0.2); color: #9ca3af;">DICABUT</span>';\n
        default: return `<span class="badge">${escapeHtml(status)}</span>`;\n
    }\n
}\n
\n
function getEmoneyStatusBadge(status) {\n
    switch (status) {\n
        case 'AVAILABLE': return '<span class="badge" style="background: rgba(56,189,248,0.2); color: #38bdf8;">TERSEDIA</span>';\n
        case 'ASSIGNED': return '<span class="badge" style="background: rgba(245,158,11,0.2); color: #fbbf24;">DITETAPKAN</span>';\n
        case 'ACTIVE': return '<span class="badge" style="background: rgba(16,185,129,0.2); color: #10b981;">AKTIF</span>';\n
        case 'SUSPENDED': return '<span class="badge" style="background: rgba(239,68,68,0.2); color: #ef4444;">DITANGGUHKAN</span>';\n
        case 'LOST': return '<span class="badge" style="background: rgba(239,68,68,0.3); color: #f87171;">HILANG</span>';\n
        case 'RETURNED': return '<span class="badge" style="background: rgba(156,163,175,0.2); color: #9ca3af;">DIKEMBALIKAN</span>';\n
        case 'REVOKED': return '<span class="badge" style="background: rgba(156,163,175,0.3); color: #9ca3af;">DICABUT</span>';\n
        default: return `<span class="badge">${escapeHtml(status)}</span>`;\n
    }\n
}\n
\n
// Populate Employee dropdown for access requests, credentials, and emoney\n
async function populateAccessEmployees() {\n
    try {\n
        const res = await apiFetch('/user-management/employees?per_page=100');\n
        if (!res || !res.data) return;\n
\n
        const options = res.data.map(e => `<option value="${e.id}">${escapeHtml(e.name)} (${escapeHtml(e.employee_id || e.nik || 'Staff')})</option>`).join('');\n
\n
        const reqSelect = document.getElementById('accessReqEmployeeId');\n
        if (reqSelect) reqSelect.innerHTML = `<option value="">-- Pilih Karyawan Terdaftar --</option>` + options;\n
\n
        const crdSelect = document.getElementById('crdEmployeeId');\n
        if (crdSelect) crdSelect.innerHTML = `<option value="">-- Pilih Karyawan --</option>` + options;\n
\n
        const emnSelect = document.getElementById('emnEmployeeId');\n
        if (emnSelect) emnSelect.innerHTML = `<option value="">-- Tersedia / Belum Ditetapkan --</option>` + options;\n
\n
        // Also populate Profiles dropdown in Access Request modal\n
        const profRes = await apiFetch('/access/profiles');\n
        if (profRes && profRes.success && profRes.data) {\n
            const profOptions = profRes.data.map(p => `<option value="${p.id}" data-building="${escapeHtml(p.building_name || '')}">${escapeHtml(p.code)} - ${escapeHtml(p.name)}</option>`).join('');\n
            const profSelect = document.getElementById('accessReqProfileId');\n
            if (profSelect) profSelect.innerHTML = `<option value="">-- Pilih Profil Akses (Opsional) --</option>` + profOptions;\n
        }\n
    } catch (e) {\n
        console.error('Failed to populate employees for access modules', e);\n
        return false;\n
    }\n
}\n
\n
function onAccessProfileSelected() {\n
    const profileSelect = document.getElementById('accessReqProfileId');\n
    const buildingInput = document.getElementById('accessReqBuilding');\n
    const selectedBuilding = profileSelect?.selectedOptions?.[0]?.dataset?.building;\n
\n
    if (buildingInput && selectedBuilding) {\n
        buildingInput.value = selectedBuilding;\n
    }\n
}\n
\n
function openAddAccessRequestModal() {\n
    const today = new Date().toISOString().split('T')[0];\n
    const validFrom = document.getElementById('accessReqValidFrom');\n
    if (validFrom) validFrom.value = today;\n
    openModal('modalAddAccessRequest');\n
}\n
\n
async function submitAccessRequest(e) {\n
    e.preventDefault();\n
    const payload = {\n
        employee_id: document.getElementById('accessReqEmployeeId')?.value || null,\n
        access_profile_id: document.getElementById('accessReqProfileId')?.value || null,\n
        building_name: document.getElementById('accessReqBuilding')?.value || 'Kantor Pusat PKP',\n
        valid_from: document.getElementById('accessReqValidFrom')?.value || null,\n
        valid_until: document.getElementById('accessReqValidUntil')?.value || null,\n
        business_reason: document.getElementById('accessReqReason')?.value || '',\n
    };\n
\n
    try {\n
        const res = await apiFetch('/access/requests', {\n
            method: 'POST',\n
            body: JSON.stringify(payload)\n
        });\n
\n
        if (res && res.success) {\n
            showToast('Permohonan hak akses berhasil diajukan', 'success');\n
            closeModal('modalAddAccessRequest');\n
            loadAccessData();\n
        } else {\n
            showToast(res?.message || 'Gagal mengajukan hak akses', 'error');\n
        }\n
    } catch (err) {\n
        showToast(err.message, 'error');\n
    }\n
}\n
\n
function openApproveRequestModal(id) {\n
    const input = document.getElementById('approveReqId');\n
    if (input) input.value = id;\n
    openModal('modalApproveAccessRequest');\n
}\n
\n
async function submitApproveAccessRequest(e) {\n
    e.preventDefault();\n
    const id = document.getElementById('approveReqId')?.value;\n
    const notes = document.getElementById('approveReqNotes')?.value || '';\n
\n
    try {\n
        const res = await apiFetch(`/access/requests/${id}/approve`, {\n
            method: 'POST',\n
            body: JSON.stringify({ notes })\n
        });\n
\n
        if (res && res.success) {\n
            showToast('Permohonan hak akses disetujui & antrean sync telah dibuat', 'success');\n
            closeModal('modalApproveAccessRequest');\n
            loadAccessData();\n
        } else {\n
            showToast(res?.message || 'Gagal menyetujui permohonan', 'error');\n
        }\n
    } catch (err) {\n
        showToast(err.message, 'error');\n
    }\n
}\n
