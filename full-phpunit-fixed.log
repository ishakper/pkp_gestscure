// Sub-Tab 4: Evaluasi & Penilaian\n
async function loadInternEvaluations() {\n
    const tbody = document.getElementById('internEvaluationsTableBody');\n
    if (!tbody) return;\n
\n
    tbody.innerHTML = `<tr><td colspan="7" class="loading-td"><div class="spinner"></div> Memuat evaluasi magang...</td></tr>`;\n
\n
    try {\n
        if (!state.internship.internships.length) {\n
            const resInt = await apiFetch('/internships');\n
            if (resInt.status === 'success') state.internship.internships = resInt.data || [];\n
        }\n
\n
        const allEvaluations = [];\n
        for (const intn of state.internship.internships.slice(0, 10)) {\n
            const evalRes = await apiFetch(`/internships/${intn.id}/evaluations`);\n
            if (evalRes.status === 'success' && Array.isArray(evalRes.data)) {\n
                evalRes.data.forEach(e => {\n
                    e.intern_name = intn.employee?.name || intn.candidate?.full_name || intn.intern_id;\n
                    allEvaluations.push(e);\n
                });\n
            }\n
        }\n
\n
        if (allEvaluations.length === 0) {\n
            tbody.innerHTML = `<tr><td colspan="7" class="empty-td">Belum ada evaluasi nilai yang dicatat.</td></tr>`;\n
            return;\n
        }\n
\n
        tbody.innerHTML = allEvaluations.map(ev => {\n
            const score = parseFloat(ev.average_score || 0);\n
            const scoreBadge = score >= 85 ? 'badge-active' : (score >= 70 ? 'badge-info' : 'badge-warning');\n
\n
            return `\n
                <tr>\n
                    <td>\n
                        <div style="font-weight: 600; color: #ffffff;">${escapeHtml(ev.intern_name)}</div>\n
                    </td>\n
                    <td>\n
                        <span class="badge" style="background: rgba(168, 85, 247, 0.2); color: #c084fc;">${escapeHtml(ev.evaluation_type)}</span>\n
                    </td>\n
                    <td>\n
                        <div style="color: #cbd5e1;">${escapeHtml(ev.evaluator_name || 'Pembimbing')}</div>\n
                        <div style="font-size: 0.775rem; color: var(--text-muted);">${escapeHtml(ev.evaluator_role || 'Mentor')}</div>\n
                    </td>\n
                    <td>\n
                        <span class="badge ${scoreBadge}" style="font-size: 0.9rem; font-weight: 700;">${score}/100</span>\n
                    </td>\n
                    <td>\n
                        <span style="font-weight: 700; color: ${ev.final_recommendation === 'HIRE_AS_EMPLOYEE' ? '#10b981' : '#fbbf24'};">\n
                            ${escapeHtml(ev.final_recommendation)}\n
                        </span>\n
                    </td>\n
                    <td style="font-size: 0.8rem; color: var(--text-muted);">\n
                        ${escapeHtml(ev.evaluated_at || '')}\n
                    </td>\n
                    <td style="text-align: right;">\n
                        <span style="color: var(--text-muted); font-size: 0.8rem;">Tercatat</span>\n
                    </td>\n
                </tr>\n
            `;\n
        }).join('');\n
    } catch (err) {\n
        tbody.innerHTML = `<tr><td colspan="7" class="error-td">Gagal memuat evaluasi: ${escapeHtml(err.message)}</td></tr>`;\n
    }\n
}\n
